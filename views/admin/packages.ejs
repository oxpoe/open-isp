<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= t('admin.packages.title', 'Paket Internet') %> | <%= company %></title>
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    /* Responsive Mobile CSS */
    @media (max-width: 768px) {
      .card-hd { flex-direction: column !important; align-items: stretch !important; gap: 10px !important; }
      .card-hd > div { flex-wrap: wrap !important; width: 100% !important; justify-content: stretch !important; }
      .card-hd select { width: 100% !important; }
      .card-hd .btn { flex: 1 1 auto; justify-content: center; }
      /* modal mengikuti style global (bottom-sheet + footer sticky) */
      .form-row { flex-direction: column !important; gap: 8px !important; }
      .form-row > .fg { width: 100% !important; max-width: 100% !important; margin-bottom: 6px !important; }
      .mf { flex-wrap: wrap !important; gap: 8px !important; }
      .mf button, .mf a { flex: 1 1 100% !important; text-align: center !important; justify-content: center !important; }
    }
  </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: 'packages', company }) %>
<div class="mw">
  <div class="topbar">
    <div class="tb-title"><button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button><i class="bi bi-box-seam"></i> <%= t('admin.packages.title', 'Paket Internet') %></div>
    <div class="tb-right">
      <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= (typeof session !== 'undefined' && session && session.isCashier) ? t('admin.role.cashier', 'Kasir') : t('admin.role.admin', 'Admin') %></span>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i></a>
    </div>
  </div>
  <div class="page">

    <% if (msg) { %>
    <div class="alert alert-<%= msg.type==='success'?'s':'d' %>" data-flash="1">
      <i class="bi bi-<%= msg.type==='success'?'check-circle':'exclamation-circle' %>"></i> <%= msg.text %>
    </div>
    <% } %>

    <div class="card mb16" style="border:1px solid rgba(239,68,68,.35)">
      <div class="card-hd" style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap">
        <h6 style="margin:0"><i class="bi bi-shield-slash" style="color:#ef4444"></i> <%= t('admin.packages.isolir_title', 'Profil Isolir') %> <span class="text-muted" style="font-weight:400;font-size:11.5px">— read-only</span></h6>
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
          <span class="badge <%= isolirSource === 'radius' ? 'bp' : 'bm' %>"><%= isolirSource === 'radius' ? 'Sumber: RADIUS' : 'Sumber: MikroTik' %></span>
          <% if (isolirSource !== 'radius') { %><span class="badge <%= isolirExists ? 'bs' : 'bd' %>"><%= isolirExists ? 'Ada di MikroTik' : 'Belum ada' %></span><% } %>
          <% if (isolirSource !== 'radius') { %><a class="btn btn-g btn-sm" href="/admin/mikrotik"><i class="bi bi-pencil"></i> Kelola di PPPoE Profiles</a><% } %>
          <a class="btn btn-g btn-sm" href="/admin/radius-settings"><i class="bi bi-broadcast"></i> RADIUS Settings</a>
        </div>
      </div>
      <div class="card-bd">
        <% if (isolirSource === 'radius') { %>
          <div class="form-row">
            <div class="fg"><label class="fl"><%= t('admin.pkg.isolir_action','Aksi isolir') %></label><div class="mono"><%= radiusIsolir.action %></div></div>
            <div class="fg"><label class="fl">Rate-limit</label><div class="mono"><%= radiusIsolir.rateLimit %></div></div>
            <div class="fg"><label class="fl">Pool</label><div class="mono"><%= radiusIsolir.pool %></div></div>
            <div class="fg"><label class="fl"><%= t('admin.pkg.isolir_ip_pool','IP Pool isolir') %></label><div class="mono"><%= radiusIsolir.ipPoolEnabled ? (radiusIsolir.ipPoolStart + ' – ' + radiusIsolir.ipPoolEnd) : 'nonaktif' %></div></div>
          </div>
          <div class="hint"><i class="bi bi-info-circle"></i> <%- t('admin.pkg.radius_hint','Mode <b>RADIUS</b> — nilai di atas dibaca dari pengaturan RADIUS. Untuk mengubah, buka <b>RADIUS Settings</b> (tombol di atas).') %></div>
        <% } else { %>
          <div class="form-row">
            <div class="fg"><label class="fl"><%= t('admin.pkg.prof_name','Nama Profil') %></label><div class="mono"><%= isolirProfileName %></div></div>
            <div class="fg"><label class="fl">Rate-limit (live)</label><div class="mono"><%= isolirExists ? (isolirLiveRl || '-') : '—' %></div></div>
          </div>
          <div class="form-row">
            <div class="fg"><label class="fl">Local Address (live)</label><div class="mono"><%= isolirExists ? (isolirLiveLocal || '-') : '—' %></div></div>
            <div class="fg"><label class="fl">Remote / Pool (live)</label><div class="mono"><%= isolirExists ? (isolirLiveRemote || '-') : '—' %></div></div>
          </div>
          <div class="hint"><i class="bi bi-info-circle"></i> <%- t('admin.pkg.mt_hint','Mode <b>MikroTik</b> — nilai di atas dibaca dari profil PPP di router. Untuk mengubah, edit di <b>MikroTik &rarr; PPPoE Profiles</b>.') %></div>
        <% } %>
      </div>
    </div>

    <div class="card">
      <div class="card-hd">
        <h6><i class="bi bi-box-seam"></i> <%= t('admin.packages.list', 'Daftar Paket') %> (<%= packages.length %>)</h6>
        <div style="display:flex;align-items:center;gap:10px">
          <% if (typeof routers !== 'undefined' && routers && routers.length > 0) { %>
          <select class="fs" style="width:160px" onchange="window.location.href='/admin/set-active-router?router_id=' + this.value">
            <option value="all" <%= (!selectedRouterId) ? 'selected' : '' %>> <%= t('admin.pkg.all_routers','Semua Router') %></option>
            <% routers.forEach(r => { %>
              <option value="<%= r.id %>" <%= (selectedRouterId === r.id) ? 'selected' : '' %>> <%= r.name %></option>
            <% }) %>
          </select>
          <% } %>
          <button class="btn btn-p btn-sm" onclick="openModal('addModal')"><i class="bi bi-plus-lg"></i> <%= t('admin.packages.add', 'Tambah Paket') %></button>
        </div>
      </div>
      <div class="tbl-wrap">
        <table class="dtbl">
          <thead>
            <tr>
              <th>#</th>
              <th><%= t('admin.packages.table.name', 'Nama Paket') %></th>
              <th><%= t('admin.packages.table.price_month', 'Harga / Bulan') %></th>
              <th><%= t('admin.pkg.th_promo','Promo / Prorata') %></th>
              <th><%= t('admin.packages.table.speed', 'Kecepatan') %></th>
              <th><%= t('admin.packages.table.description', 'Deskripsi') %></th>
              <th><%= t('admin.packages.table.isolir', 'Profil Isolir') %></th>
              <th><%= t('admin.packages.table.customers', 'Pelanggan') %></th>
              <th><%= t('admin.packages.table.status', 'Status') %></th>
              <th><%= t('common.actions', 'Aksi') %></th>
            </tr>
          </thead>
          <tbody>
          <% if (packages.length===0) { %>
            <tr><td colspan="10" class="text-center text-muted" style="padding:32px"><%= t('admin.packages.empty', 'Belum ada paket. Tambah paket pertama!') %></td></tr>
          <% } %>
          <% packages.forEach((p,i)=>{ %>
            <tr>
              <td class="text-muted"><%= i+1 %></td>
              <td class="fw6">
                <div><%= p.name %></div>
                <div style="margin-top:3px">
                  <% if (p.billing_type === 'prepaid') { %>
                    <span class="badge bs" style="font-size:10px;padding:2px 6px;font-weight:700;"><i class="bi bi-clock-history"></i> Prabayar (<%= p.duration_days || 30 %> Hari)</span>
                  <% } else { %>
                    <span class="badge bp" style="font-size:10px;padding:2px 6px;font-weight:600;"><i class="bi bi-calendar-check"></i> Pascabayar</span>
                  <% } %>
                </div>
              </td>
              <td class="fw6" style="color:var(--success)">
                Rp <%= p.price.toLocaleString('id-ID') %>
                <% if (p.use_ppn) { %><br><span class="badge bp" style="font-size:9px;padding:2px 4px;margin-top:2px;display:inline-block">+ PPN <%= p.ppn_percentage %>%</span><% } %>
                <% if (p.use_uso) { %><br><span class="badge bm" style="font-size:9px;padding:2px 4px;margin-top:2px;display:inline-block">+ USO <%= p.uso_percentage %>%</span><% } %>
              </td>
              <td style="font-size:11px;max-width:160px">
                <% if (p.promo_cycles > 0 && p.promo_price != null && p.promo_price !== '') { %>
                  <span class="badge bp">Promo</span> Rp <%= Number(p.promo_price).toLocaleString('id-ID') %> × <%= p.promo_cycles %> bln
                <% } else { %><span class="text-muted">—</span><% } %>
                <% if (p.prorate_first_invoice) { %><br><span class="badge bs" style="margin-top:4px;display:inline-block">Prorata 1×</span><% } %>
              </td>
              <td>
                <% if (p.speed_down) { %>
                  <div style="white-space:nowrap;font-weight:700;">
                    <span class="badge bp"><i class="bi bi-download"></i> <%= (p.speed_down/1000).toFixed(0) %> Mbps</span>
                    <% if (p.speed_down_upto && p.speed_down_upto > p.speed_down) { %>
                      <span class="badge bs" style="font-size:10px;padding:2px 5px;">UpTo <%= (p.speed_down_upto/1000).toFixed(0) %>M</span>
                    <% } %>
                  </div>
                  <div style="white-space:nowrap;font-weight:700;margin-top:4px;">
                    <span class="badge bm"><i class="bi bi-upload"></i> <%= (p.speed_up/1000).toFixed(0) %> Mbps</span>
                    <% if (p.speed_up_upto && p.speed_up_upto > p.speed_up) { %>
                      <span class="badge bs" style="font-size:10px;padding:2px 5px;">UpTo <%= (p.speed_up_upto/1000).toFixed(0) %>M</span>
                    <% } %>
                  </div>
                  <% if (p.rate_limit) { %><div class="text-muted mono" style="font-size:10.5px;margin-top:2px" title="Rate-limit (MikroTik & RADIUS)"><i class="bi bi-speedometer2"></i> <%= p.rate_limit %></div><% } %>
                <% } else { %><span class="text-muted">-</span><% } %>
              </td>
              <td style="color:var(--muted);font-size:12px"><%= p.description||'-' %></td>
              <td><% if (p.isolir_profile) { %><span class="badge" style="background:rgba(239,68,68,.16);color:#ef4444;border:1px solid rgba(239,68,68,.3)"><i class="bi bi-shield-slash"></i> <%= p.isolir_profile %></span><% } else { %><span class="text-muted">—</span><% } %></td>
              <td class="text-center"><span class="badge bm"><%= p.customer_count %> <%= t('admin.packages.customers_suffix', 'pelanggan') %></span></td>
              <td><% if(p.is_active){%><span class="badge bs"><%= t('common.active', 'Aktif') %></span><%}else{%><span class="badge bd"><%= t('common.inactive', 'Nonaktif') %></span><%}%></td>
              <td style="white-space:nowrap">
                <form id="pkdel-<%= p.id %>" method="POST" action="/admin/packages/<%= p.id %>/delete" style="display:none" onsubmit="return confirm('<%= t('admin.packages.confirm.delete', 'Hapus paket ini? Pelanggan yang menggunakan paket ini akan kehilangan referensi paket.') %>')"></form>
                <div class="act">
                  <button type="button" class="act-btn" title="Aksi" onclick="actToggle(event, this)"><i class="bi bi-three-dots-vertical"></i></button>
                  <div class="act-menu">
                    <button type="button" class="act-item" data-idx="<%= i %>" onclick="editPkg(+this.dataset.idx)"><i class="bi bi-pencil"></i> Edit Paket</button>
                    <div class="act-sep"></div>
                    <button type="submit" form="pkdel-<%= p.id %>" class="act-item danger"><i class="bi bi-trash"></i> <%= t('admin.pkg.del_pkg','Hapus Paket') %></button>
                  </div>
                </div>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Modal Tambah -->
<div class="mo" id="addModal">
  <div class="mb" style="max-width:680px;">
    <div class="mh"><span class="mt"><i class="bi bi-plus-square"></i> <%= t('admin.packages.add', 'Tambah Paket') %></span><button class="mc" onclick="closeModal('addModal')">&times;</button></div>
    <form method="POST" action="/admin/packages">
      <div class="mbody" style="max-height:70vh; overflow-y:auto; padding-right:6px;">
        <div class="fg">
          <label class="fl"><%= t('admin.packages.form.name_profile', 'Nama Paket (Profile MikroTik)') %> *</label>
          <div style="display:flex;gap:8px">
            <select class="fs" id="add_profile_select" style="max-width:200px" onchange="document.getElementById('add_name').value=this.value">
              <option value=""><%= t('admin.packages.form.pick_from_mikrotik', '-- Pilih dari MikroTik --') %></option>
            </select>
            <input class="fc" name="name" id="add_name" required placeholder="<%= t('admin.packages.form.type_manual', 'Atau ketik manual...') %>">
          </div>
        </div>
        <div class="hint" style="margin:-2px 0 10px;font-size:11px">
          <% if (typeof profileMode !== 'undefined' && profileMode === 'radius-attributes') { %>
            <i class="bi bi-broadcast"></i> <%- t('admin.pkg.mode_radius_hint','Mode RADIUS: rate-limit &amp; IP dari <b>atribut RADIUS</b> — profil PPP MikroTik tidak dibuat otomatis.') %>
          <% } else { %>
            <i class="bi bi-router"></i> Profil PPP MikroTik akan <b>dibuat/diperbarui otomatis</b> dari speed paket<% if (typeof profileMode !== 'undefined' && profileMode === 'radius-profile') { %> (mode RADIUS pakai profil MikroTik)<% } %>.
          <% } %>
        </div>
        
        <div class="form-row">
          <div class="fg"><label class="fl"><%= t('admin.packages.form.price_month', 'Harga / Bulan (Rp)') %> *</label><input class="fc" name="price" type="number" min="0" required placeholder="150000"></div>
          <div class="fg"><label class="fl"><%= t('admin.packages.form.status', 'Status') %></label>
            <select class="fs" name="is_active"><option value="1"><%= t('common.active', 'Aktif') %></option><option value="0"><%= t('common.inactive', 'Nonaktif') %></option></select>
          </div>
        </div>

        <!-- Tipe Billing: Pascabayar vs Prabayar -->
        <div class="form-row" style="background:rgba(99,102,241,0.05);padding:12px 14px;border-radius:10px;margin-top:10px;border:1px solid rgba(99,102,241,0.15);">
          <div class="fg">
            <label class="fl"><i class="bi bi-credit-card-2-front text-primary me-1"></i> <%= t('admin.pkg.billing_type','Tipe Penagihan / Billing *') %></label>
            <select class="fs" name="billing_type" id="add_billing_type" onchange="toggleAddBillingType(this.value)">
              <option value="postpaid" selected><%= t('admin.pkg.opt_postpaid','Pascabayar (Kalender / Jatuh Tempo Tetap)') %></option>
              <option value="prepaid"><%= t('admin.pkg.opt_prepaid','Prabayar (Masa Aktif Bergulir)') %></option>
            </select>
          </div>
          <div class="fg" id="add_duration_days_fg" style="display:none">
            <label class="fl"><i class="bi bi-clock-history text-warning me-1"></i> <%= t('admin.pkg.validity_days','Durasi Masa Aktif (Hari) *') %></label>
            <input class="fc" name="duration_days" id="add_duration_days" type="number" min="1" value="30" placeholder="30">
            <small class="text-muted" style="font-size:11px;display:block;margin-top:2px;">
              <%= t('admin.pkg.active_days_hint','Pelanggan aktif selama X hari sejak aktivasi / pembayaran.') %>
            </small>
          </div>
        </div>

        <!-- Kecepatan Berdampingan (Download & Upload) -->
        <div class="form-row" style="background:rgba(59,130,246,0.04);padding:12px 14px;border-radius:10px;margin-top:10px;border:1px solid rgba(59,130,246,0.12);">
          <div class="fg">
            <label class="fl" style="color:var(--primary);font-weight:700;"><i class="bi bi-download"></i> Kecepatan Download (Mbps) *</label>
            <input class="fc" name="speed_down" id="add_down" type="number" step="any" min="0" placeholder="<%= t('admin.pkg.ph_down','Contoh: 10') %>" required>
          </div>
          <div class="fg">
            <label class="fl" style="color:var(--info);font-weight:700;"><i class="bi bi-upload"></i> Kecepatan Upload (Mbps) *</label>
            <input class="fc" name="speed_up" id="add_up" type="number" step="any" min="0" placeholder="<%= t('admin.pkg.ph_up','Contoh: 5') %>" required>
          </div>
        </div>
        <div class="hint" style="margin-top:6px;font-size:11px">
          <i class="bi bi-speedometer2"></i> <%- t('admin.pkg.ratelimit_hint','Rate-limit asli (MikroTik &amp; RADIUS):') %> <b class="mono" id="ratePreview" style="color:var(--primary)">-</b>
          <span style="color:var(--muted)">— format <span class="mono">rx/tx</span> (+ burst: <span class="mono">rx/tx rxB/txB rxT/txT time</span>). Nilai sama dipakai untuk profil MikroTik <b>dan</b> atribut RADIUS.</span>
        </div>

        <!-- Kecepatan UpTo / Maximum Burst Rate (Opsional Manual) -->
        <div style="background:rgba(16,185,129,0.04);padding:12px 14px;border-radius:10px;margin-top:10px;border:1px dashed rgba(16,185,129,0.25);">
          <div class="fw6" style="font-size:12px;margin-bottom:8px;color:var(--success)"><i class="bi bi-speedometer2"></i> Fitur Kecepatan UpTo / Max Rate (Opsional)</div>
          <div class="form-row">
            <div class="fg">
              <label class="fl">Download UpTo (Mbps)</label>
              <input class="fc" name="speed_down_upto" id="add_down_upto" type="number" step="any" min="0" placeholder="<%= t('admin.pkg.ph_upto_down','Kosongkan jika tanpa UpTo (mis: 20)') %>">
            </div>
            <div class="fg">
              <label class="fl">Upload UpTo (Mbps)</label>
              <input class="fc" name="speed_up_upto" id="add_up_upto" type="number" step="any" min="0" placeholder="<%= t('admin.pkg.ph_upto_up','Kosongkan jika tanpa UpTo (mis: 10)') %>">
            </div>
          </div>
          <small class="text-muted" style="font-size:11px;display:block;margin-top:2px;">
            <%- t('admin.pkg.upto_hint','Bila diisi, paket akan tampil sebagai: <strong>10 Mbps (Up to 20 Mbps)</strong> di invoice & portal pelanggan.') %>
          </small>
        </div>
        <div style="background: rgba(34,197,94,0.06); padding: 12px 14px; border-radius: 10px; margin-top: 10px;">
          <div class="fw6" style="font-size:12px;margin-bottom:8px;color:var(--success)"><i class="bi bi-percent"></i> <%= t('admin.pkg.promo_prorata','Promo & prorata tagihan') %></div>
          <div class="form-row">
            <div class="fg"><label class="fl"><%= t('admin.pkg.promo_price','Harga promo (Rp / siklus)') %></label><input class="fc" name="promo_price" type="number" min="0" placeholder="<%= t('admin.pkg.ph_promo_price','Opsional, mis. 99000') %>"></div>
            <div class="fg"><label class="fl"><%= t('admin.pkg.promo_cycles','Jumlah bulan promo') %></label><input class="fc" name="promo_cycles" type="number" min="0" value="0" placeholder="<%= t('admin.pkg.ph_promo_cycles','0 = tanpa promo') %>"></div>
          </div>
          <div class="flex ai-c" style="gap:8px;margin-top:4px">
            <input type="checkbox" name="prorate_first_invoice" id="add_prorate" value="1">
            <label for="add_prorate" style="margin:0;font-size:12px">Prorata tagihan <strong>pertama</strong> jika pasang di tengah bulan (proporsi sisa hari, perlu tanggal pasang di data pelanggan)</label>
          </div>
        </div>
        
        <div style="background: rgba(99,102,241,0.06); padding: 12px 14px; border-radius: 10px; margin-top: 10px;">
          <div class="fw6" style="font-size:12px;margin-bottom:8px;color:var(--primary)"><i class="bi bi-calculator"></i> Pengaturan Pajak & Regulasi (PPN & USO)</div>
          <div class="form-row" style="margin-bottom: 8px;">
            <div class="fg">
              <label style="display:flex; align-items:center; gap:8px; font-size:12px; font-weight:700; margin-top: 26px;">
                <input type="checkbox" name="use_ppn" id="add_use_ppn" value="1">
                Aktifkan PPN
              </label>
            </div>
            <div class="fg">
              <label class="fl"><%= t('admin.pkg.ppn_pct','Persentase PPN (%)') %></label>
              <input class="fc" name="ppn_percentage" type="number" step="any" min="0" value="11.0">
            </div>
          </div>
          <div class="form-row">
            <div class="fg">
              <label style="display:flex; align-items:center; gap:8px; font-size:12px; font-weight:700; margin-top: 26px;">
                <input type="checkbox" name="use_uso" id="add_use_uso" value="1">
                Aktifkan ULO/USO
              </label>
            </div>
            <div class="fg">
              <label class="fl"><%= t('admin.pkg.uso_pct','Persentase ULO/USO (%)') %></label>
              <input class="fc" name="uso_percentage" type="number" step="any" min="0" value="1.75">
            </div>
          </div>
        </div>

        <div class="fg"><label class="fl"><%= t('admin.packages.form.description', 'Deskripsi') %></label><textarea class="fc" name="description" placeholder="<%= t('admin.packages.form.optional', 'Opsional...') %>"></textarea></div>
        
        <!-- IP Pool & Profil MikroTik -->
        <div style="background:rgba(59,130,246,0.05);padding:12px 14px;border-radius:10px;margin-top:10px;border:1px solid rgba(59,130,246,0.15);">
          <div class="fw6" style="font-size:12px;margin-bottom:8px;color:var(--info)"><i class="bi bi-hdd-network"></i> IP Pool &amp; Profil MikroTik <span class="text-muted" style="font-weight:400">(comment: "manage by cloud")</span></div>
          <div class="form-row">
            <div class="fg"><label class="fl"><%= t('admin.pkg.pool_name','Nama IP Pool') %></label><input class="fc" name="pool_name" id="add_pool_name" placeholder="mis. HOME10"></div>
            <div class="fg"><label class="fl"><%= t('admin.pkg.pool_ranges','Rentang IP (ranges)') %></label><input class="fc" name="pool_ranges" id="add_pool_ranges" placeholder="10.20.0.10-10.20.0.254"></div>
          </div>
          <div class="form-row">
            <div class="fg"><label class="fl">Local Address (gateway)</label><input class="fc" name="local_address" id="add_local_address" placeholder="10.20.0.1/24"></div>
            <div class="fg"><label class="fl">Only One</label><select class="fs" name="only_one" id="add_only_one"><option value="1" selected>Ya</option><option value="0">Tidak</option></select></div>
          </div>
          <div class="form-row">
