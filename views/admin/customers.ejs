<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= t('admin.customers.title', 'Pelanggan') %> | <%= company %></title>
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    .usage-bar { height: 4px; background: var(--bg3); border-radius: 2px; margin: 4px 0; overflow: hidden; width: 100px; }
    .usage-fill { height: 100%; width: var(--p, 0%); background: var(--b, var(--primary)); transition: width 0.3s; }
    #picker-map { height: 400px; width: 100%; border-radius: 8px; margin-bottom: 15px; }
    .picker-icon { color: #3b82f6; font-size: 32px; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3)); display: block; width: 32px; height: 32px; text-align: center; line-height: 32px; text-shadow: -1.5px -1.5px 0 #fff, 1.5px -1.5px 0 #fff, -1.5px 1.5px 0 #fff, 1.5px 1.5px 0 #fff; }
    
    /* Responsive Mobile CSS */
    @media (max-width: 768px) {
      .stat-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 10px !important; }
      .card-hd { flex-direction: column !important; align-items: stretch !important; gap: 10px !important; }
      .card-hd > div { flex-wrap: wrap !important; justify-content: stretch !important; }
      .card-hd .btn { flex: 1 1 auto; justify-content: center; }
      .srow { flex-direction: column !important; gap: 10px !important; }
      .sinput, .srow select { width: 100% !important; max-width: 100% !important; }
      /* modal mengikuti style global (bottom-sheet + footer sticky) */
      .form-row { flex-direction: column !important; gap: 8px !important; }
      .form-row > .fg { width: 100% !important; max-width: 100% !important; margin-bottom: 6px !important; }
      .mf { flex-wrap: wrap !important; gap: 8px !important; }
      .mf button, .mf a { flex: 1 1 100% !important; text-align: center !important; justify-content: center !important; }
    }

    /* ── Modal Detail Pelanggan (mandiri, responsif) ── */
    .vd-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap;background:var(--panel2);border:1px solid var(--border);border-radius:12px;padding:14px;margin-bottom:16px}
    .vd-head>div{min-width:0}
    .vd-name{font-size:17px;font-weight:800;color:var(--text);line-height:1.25;word-break:break-word}
    .vd-sub{font-size:12px;color:var(--muted);margin-top:5px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
    .vd-sub strong{color:var(--primary)}
    .vd-sec{margin-bottom:16px}
    .vd-sec-title{font-size:12px;font-weight:700;color:var(--primary);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px;display:flex;align-items:center;gap:6px}
    .vd-panel{background:var(--panel2);border:1px solid var(--border);border-radius:12px;padding:2px 14px}
    .vd-row{display:flex;gap:12px;padding:10px 0;border-bottom:1px solid var(--border);align-items:center}
    .vd-row:last-child{border-bottom:none}
    .vd-row .k{flex:0 0 42%;color:var(--muted);font-size:12.5px;line-height:1.3}
    .vd-row .v{flex:1;min-width:0;font-size:12.5px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;word-break:break-word;color:var(--text)}
    .vd-code{font-family:ui-monospace,Menlo,Consolas,monospace;font-weight:700;font-size:12.5px;word-break:break-all}
    .vd-copy{flex:0 0 auto;padding:2px 8px;font-size:11px;line-height:1.7}
    .vd-grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    .vd-stat{border:1px solid rgba(56,189,248,.25);border-radius:10px;padding:12px 8px;text-align:center;min-width:0}
    .vd-stat-num{font-size:17px;font-weight:900;color:var(--text);margin:3px 0;word-break:break-all}
    .vd-fup{display:flex;justify-content:space-between;align-items:center;gap:8px;font-size:12px;margin-top:10px;padding-top:9px;border-top:1px solid var(--border);flex-wrap:wrap}
    .vd-foot{justify-content:space-between}
    .vd-danger{background:#ef4444;color:#fff;border:none;padding:8px 16px;font-weight:700}
    .vd-danger:hover{filter:brightness(1.08)}
    @media(max-width:560px){
      .vd-head{padding:12px}
      .vd-name{font-size:15.5px}
      .vd-row{flex-direction:column;align-items:flex-start;gap:4px}
      .vd-row .k{flex:0 0 auto;font-size:11.5px}
      .vd-row .v{width:100%}
      .vd-copy{padding:2px 10px}
      .vd-grid2{grid-template-columns:1fr 1fr;gap:8px}
      .vd-stat-num{font-size:15px}
      .vd-foot{flex-direction:column;align-items:stretch;gap:8px}
      .vd-foot form{display:block;width:100%}
      .vd-foot .btn{width:100%;display:flex;justify-content:center}
    }
  </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: 'customers', company }) %>
<div class="mw">
  <div class="topbar">
    <div class="tb-title"><button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button><i class="bi bi-people"></i> <%= t('admin.customers.manage_title', 'Manajemen Pelanggan') %></div>
    <div class="tb-right">
      <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= (typeof session !== 'undefined' && session && session.isCashier) ? t('admin.role.cashier', 'Kasir') : t('admin.role.admin', 'Admin') %></span>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i></a>
    </div>
  </div>
  <div class="page">

    <% if (msg) { %>
    <div class="alert alert-<%= msg.type === 'success' ? 's' : 'd' %>" data-flash="1">
      <i class="bi bi-<%= msg.type === 'success' ? 'check-circle' : 'exclamation-circle' %>"></i> <%= msg.text %>
    </div>
    <% } %>

    <!-- Stats (Clickable Filter Cards) -->
    <style>
      .sc-clickable { cursor: pointer; transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease; }
      .sc-clickable:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0,0,0,0.15); }
      .stat-card-active { border: 2px solid var(--primary) !important; box-shadow: 0 0 12px var(--pdim); }
      .sc.s.stat-card-active { border-color: var(--success) !important; box-shadow: 0 0 12px var(--sdim); }
      .sc.w.stat-card-active { border-color: var(--warning) !important; box-shadow: 0 0 12px var(--wdim); }
      .sc.d.stat-card-active { border-color: var(--danger) !important; box-shadow: 0 0 12px var(--ddim); }
    </style>
    <div class="stat-grid" style="grid-template-columns:repeat(4,1fr)">
      <div class="sc p sc-clickable <%= (!filterStatus) ? 'stat-card-active' : '' %>" onclick="filterByStatus('')" title="<%= t('admin.cust.tt_all','Klik untuk tampilkan semua pelanggan') %>">
        <i class="bi bi-people sc-icon"></i>
        <div class="sc-label"><%= t('admin.customers.stats.total', 'Total') %></div>
        <div class="sc-val"><%= stats.total %></div>
        <% if (!filterStatus) { %>
          <div style="font-size:10px;font-weight:800;color:var(--primary);margin-top:4px"><i class="bi bi-funnel-fill"></i> <%= t('admin.cust.filter_active','Filter Aktif') %></div>
        <% } %>
      </div>
      <div class="sc s sc-clickable <%= (filterStatus === 'active') ? 'stat-card-active' : '' %>" onclick="filterByStatus('active')" title="<%= t('admin.cust.tt_f_active','Klik untuk filter pelanggan Aktif') %>">
        <i class="bi bi-check-circle sc-icon"></i>
        <div class="sc-label"><%= t('admin.customers.stats.active', 'Aktif') %></div>
        <div class="sc-val"><%= stats.active %></div>
        <% if (filterStatus === 'active') { %>
          <div style="font-size:10px;font-weight:800;color:var(--success);margin-top:4px"><i class="bi bi-funnel-fill"></i> <%= t('admin.cust.filter_active','Filter Aktif') %></div>
        <% } %>
      </div>
      <div class="sc w sc-clickable <%= (filterStatus === 'suspended') ? 'stat-card-active' : '' %>" onclick="filterByStatus('suspended')" title="<%= t('admin.cust.tt_f_susp','Klik untuk filter pelanggan Disuspend') %>">
        <i class="bi bi-pause-circle sc-icon"></i>
        <div class="sc-label"><%= t('admin.customers.stats.suspended', 'Disuspend') %></div>
        <div class="sc-val"><%= stats.suspended %></div>
        <% if (filterStatus === 'suspended') { %>
          <div style="font-size:10px;font-weight:800;color:var(--warning);margin-top:4px"><i class="bi bi-funnel-fill"></i> <%= t('admin.cust.filter_active','Filter Aktif') %></div>
        <% } %>
      </div>
      <div class="sc d sc-clickable <%= (filterStatus === 'inactive') ? 'stat-card-active' : '' %>" onclick="filterByStatus('inactive')" title="<%= t('admin.cust.tt_f_new','Klik untuk filter Pendaftar Baru / Nonaktif') %>">
        <i class="bi bi-person-plus sc-icon"></i>
        <div class="sc-label"><%= t('admin.customers.stats.inactive', 'Pendaftar Baru (Nonaktif)') %></div>
        <div class="sc-val"><%= stats.inactive %></div>
        <% if (filterStatus === 'inactive') { %>
          <div style="font-size:10px;font-weight:800;color:var(--danger);margin-top:4px"><i class="bi bi-funnel-fill"></i> <%= t('admin.cust.filter_active','Filter Aktif') %></div>
        <% } %>
      </div>
    </div>

    <!-- Print Header (Only visible on paper print) -->
    <div class="print-only" style="margin-bottom:14px;border-bottom:2px solid #0f172a;padding-bottom:10px">
      <div style="display:flex;justify-content:space-between;align-items:flex-start">
        <div>
          <h2 style="font-size:16pt;font-weight:800;text-transform:uppercase;margin:0"><%= company %></h2>
          <div style="font-size:10pt;color:#334155"><%= t('admin.customers.manage_title', 'Daftar Data Pelanggan') %> &bull; Status: <%= filterStatus ? filterStatus.toUpperCase() : 'SEMUA' %></div>
        </div>
        <div style="text-align:right;font-size:8.5pt;color:#475569">
          <div><%= t('admin.cust.printed_at','Dicetak:') %> <%= getNowLocal() %></div>
          <div><%= t('admin.cust.total','Total Pelanggan:') %> <strong><%= customers.length %> Orang</strong></div>
        </div>
      </div>
    </div>

    <!-- Search & Add -->
    <div class="card">
      <div class="card-hd">
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
          <h6 style="margin:0;"><i class="bi bi-people"></i> <%= t('admin.customers.list', 'Daftar Pelanggan') %> (<%= customers.length %>)</h6>
          <span id="bulkCustCount" class="badge" style="display:none;background:rgba(59,130,246,0.15);color:#3b82f6;border:1px solid rgba(59,130,246,0.3);font-size:11px;padding:4px 8px;"></span>
          <button type="button" class="btn btn-d btn-sm" id="bulkCustDeleteBtn" style="display:none;"><i class="bi bi-trash"></i> <%= t('admin.cust.bulk_delete','Hapus Terpilih') %></button>
        </div>
        <div style="display:flex;gap:8px">
          <button type="button" class="btn btn-g btn-sm" onclick="window.print()" title="<%= t('admin.cust.tt_print_data','Cetak Data Pelanggan') %>"><i class="bi bi-printer"></i> <%= t('admin.cust.btn_print','Cetak') %></button>
          <a href="/admin/onu-stickers" class="btn btn-g btn-sm" title="<%= t('admin.cust.tt_print_sticker','Cetak Stiker Modem / ONU') %>"><i class="bi bi-qr-code-scan"></i> Stiker ONU</a>
          <a href="/admin/customers/export" class="btn btn-g btn-sm"><i class="bi bi-file-earmark-excel"></i> <%= t('admin.customers.export_excel', 'Export Excel') %></a>
          <button class="btn btn-g btn-sm" onclick="openModal('importModal')"><i class="bi bi-file-earmark-arrow-up"></i> <%= t('admin.customers.import_excel', 'Import Excel') %></button>
          <button type="button" class="btn btn-g btn-sm" onclick="syncAllCust()"><i class="bi bi-arrow-repeat"></i> <%= t('admin.cust.apply_network','Terapkan ke Jaringan') %></button>
          <button class="btn btn-p btn-sm" onclick="openModal('addModal')"><i class="bi bi-plus-lg"></i> <%= t('admin.customers.add', 'Tambah Pelanggan') %></button>
        </div>
      </div>
      <div class="card-bd" style="padding-bottom:0">
        <form method="GET" action="/admin/customers" class="srow">
          <div class="sinput" style="max-width:340px">
            <i class="bi bi-search"></i>
            <input class="fc" name="search" placeholder="<%= t('admin.customers.search_placeholder', 'Cari nama, telepon, tag...') %>" value="<%= search %>">
          </div>
          <select class="fs" name="status" style="width:140px" onchange="this.form.submit()">
            <option value=""><%= t('admin.customers.filter.all_status', 'Semua Status') %></option>
            <option value="active" <%= filterStatus==='active' ? 'selected':'' %>><%= t('admin.customers.filter.active', 'Aktif') %></option>
            <option value="suspended" <%= filterStatus==='suspended' ? 'selected':'' %>><%= t('admin.customers.filter.suspended', 'Suspend') %></option>
            <option value="inactive" <%= filterStatus==='inactive' ? 'selected':'' %>><%= t('admin.customers.filter.inactive', 'Pendaftar Baru / Nonaktif') %></option>
            <option value="ditangguhkan" <%= filterStatus==='ditangguhkan' ? 'selected':'' %>><%= t('admin.cust.st_suspended','Ditangguhkan') %></option>
          </select>
          <select class="fs" name="area" style="width:160px" onchange="this.form.submit()">
            <option value=""><%= t('admin.cust.all_area','Semua Area') %></option>
            <% if (typeof areas !== 'undefined' && areas && areas.length > 0) { %>
              <% areas.forEach(a => { %>
                <option value="<%= a %>" <%= (typeof filterArea !== 'undefined' && filterArea === a) ? 'selected' : '' %>><%= a %></option>
              <% }) %>
            <% } %>
          </select>
          <% if (typeof routers !== 'undefined' && routers && routers.length > 0) { %>
          <select class="fs" style="width:160px;" onchange="window.location.href='/admin/set-active-router?router_id=' + this.value">
            <option value="all" <%= (!selectedRouterId) ? 'selected' : '' %>> <%= t('admin.cust.all_router','Semua Router') %></option>
            <% routers.forEach(r => { %>
              <option value="<%= r.id %>" <%= (selectedRouterId === r.id) ? 'selected' : '' %>> <%= r.name %></option>
            <% }) %>
          </select>
          <% } %>
          <select class="fs" name="package_id" style="width:180px" onchange="this.form.submit()">
            <option value=""><%= t('admin.cust.all_pkg','Semua Paket') %></option>
            <% (typeof packages !== 'undefined' ? packages : []).forEach(p => { %><option value="<%= p.id %>" <%= String(filterPackage)===String(p.id)?'selected':'' %>><%= p.name %></option><% }) %>
          </select>
          <select class="fs" name="collector_id" style="width:170px" onchange="this.form.submit()">
            <option value=""><%= t('admin.cust.all_collector','Semua Kolektor') %></option>
            <% (typeof collectors !== 'undefined' ? collectors : []).forEach(k => { %><option value="<%= k.id %>" <%= String(filterCollector)===String(k.id)?'selected':'' %>><%= k.name %></option><% }) %>
          </select>
          <select class="fs" name="olt_id" style="width:150px" onchange="this.form.submit()">
            <option value=""><%= t('admin.cust.all_olt','Semua OLT') %></option>
            <% (typeof olts !== 'undefined' ? olts : []).forEach(o => { %><option value="<%= o.id %>" <%= String(filterOlt)===String(o.id)?'selected':'' %>><%= o.name %></option><% }) %>
          </select>
          <select class="fs" name="connection_type" style="width:150px" onchange="this.form.submit()">
            <option value=""><%= t('admin.cust.all_conn','Semua Koneksi') %></option>
            <option value="pppoe" <%= filterConn==='pppoe'?'selected':'' %>>PPPoE</option>
            <option value="hotspot" <%= filterConn==='hotspot'?'selected':'' %>>Hotspot</option>
            <option value="static" <%= filterConn==='static'?'selected':'' %>>Static IP</option>
          </select>
          <select class="fs" name="billing" style="width:160px" onchange="this.form.submit()">
            <option value=""><%= t('admin.cust.all_billing','Semua Tagihan') %></option>
            <option value="unpaid" <%= filterBilling==='unpaid'?'selected':'' %>><%= t('collector.filter_belum','Belum Bayar') %></option>
            <option value="paid" <%= filterBilling==='paid'?'selected':'' %>><%= t('admin.cust.paid','Lunas') %></option>
          </select>
          <select class="fs" name="auto_isolate" style="width:170px" onchange="this.form.submit()">
            <option value=""><%= t('admin.cust.f_auto_all','Auto-Isolir: Semua') %></option>
            <option value="on" <%= filterAuto==='on'?'selected':'' %>><%= t('admin.cust.f_auto_on','Auto-Isolir ON') %></option>
            <option value="off" <%= filterAuto==='off'?'selected':'' %>><%= t('admin.cust.f_auto_off','Auto-Isolir OFF') %></option>
          </select>
          <button class="btn btn-g btn-sm" type="submit"><i class="bi bi-search"></i> <%= t('common.search', 'Cari') %></button>
          <% if (search || filterStatus || selectedRouterId || filterPackage || filterCollector || filterOlt || filterConn || filterBilling || filterAuto) { %><a href="/admin/set-active-router?router_id=all" class="btn btn-g btn-sm"><i class="bi bi-x"></i> <%= t('common.reset', 'Reset') %></a><% } %>
        </form>
      </div>
      <div class="tbl-wrap">
        <table class="dtbl stick-name-mobile">
          <thead>
            <tr>
              <th style="width:36px;text-align:center;"><input type="checkbox" id="cust_all" style="width:16px;height:16px;cursor:pointer;"></th>
              <th>#</th>
              <th><%= t('admin.customers.table.name', 'Nama') %></th>
              <th><%= t('admin.customers.table.phone_tag', 'Telepon / Tag ONU') %></th>
              <th><%= t('admin.customers.table.package', 'Paket') %></th>
              <th><%= t('admin.cust.f_mikrotik_conn','Koneksi MikroTik') %></th>
              <th><%= t('admin.customers.table.address', 'Alamat') %></th>
              <th><%= t('admin.customers.table.status', 'Status') %></th>
              <th><%= t('admin.customers.table.unpaid', 'Tagihan Belum Bayar') %></th>
              <th><%= t('admin.customers.table.actions', 'Aksi') %></th>
            </tr>
          </thead>
          <tbody>
          <% if (customers.length === 0) { %>
            <tr><td colspan="10" class="text-center text-muted" style="padding:32px"><%= t('admin.customers.empty', 'Belum ada pelanggan') %></td></tr>
          <% } %>
          <% customers.forEach((c, i) => { %>
            <tr>
              <td style="text-align:center;">
                <input type="checkbox" class="cust_sel" value="<%= c.id %>" data-name="<%= c.name %>" style="width:16px;height:16px;cursor:pointer;">
              </td>
              <td class="text-muted"><%= i+1 %></td>
              <td class="fw6">
                <a href="javascript:void(0)" onclick="viewCustDetail(<%= i %>)" style="color:var(--primary);text-decoration:none;font-weight:700;display:inline-flex;align-items:center;gap:5px;cursor:pointer;" title="<%= t('admin.cust.tt_detail','Klik untuk lihat detail pelanggan & MikroTik') %>">
                  <%= c.name %>
                  <i class="bi bi-info-circle-fill" style="font-size:12px;opacity:0.75;"></i>
                </a>
                <% if (c.customer_code) { %><div style="font-size:11px;font-weight:700;color:var(--muted);margin-top:2px;display:flex;align-items:center;gap:4px;" title="ID Pelanggan"><i class="bi bi-person-badge"></i> <%= c.customer_code %></div><% } %>
              </td>
              <td>
                <div><%= c.phone || '-' %></div>
                <% if (c.genieacs_tag) { %><div style="font-size:11px;color:var(--primary)"><i class="bi bi-wifi"></i> <%= c.genieacs_tag %></div><% } %>
              </td>
              <td>
                <% if (c.package_name) { %>
                  <div style="font-weight:600;"><%= c.package_name %></div>
                  <div style="font-size:11px;color:var(--muted)"><%= (c.speed_down/1000).toFixed(0) %>/<%= (c.speed_up/1000).toFixed(0) %> Mbps &bull; Rp <%= c.package_price ? c.package_price.toLocaleString('id-ID') : '-' %></div>
                  <% if (c.package_billing_type === 'prepaid' || c.expired_at) { %>
                    <% 
                      const expDateStr = c.expired_at ? String(c.expired_at).slice(0, 10) : '-';
                      const isExpired = c.expired_at ? (new Date(c.expired_at) < new Date()) : false;
                    %>
                    <div style="margin-top:2px;">
                      <span class="badge <%= isExpired ? 'bd' : 'bs' %>" style="font-size:9px;padding:2px 5px;" title="<%= t('admin.cust.tt_prepaid','Masa Aktif Paket Prabayar') %>">
                        <i class="bi bi-hourglass-split"></i> Exp: <%= expDateStr %>
                      </span>
                    </div>
                  <% } %>
                <% } else { %><span class="text-muted">-</span><% } %>
              </td>
              <td class="cust-conn-cell" data-username="<%= String(c.pppoe_username || c.hotspot_username || '').trim().toLowerCase() %>">
                <% 
                  const username = String(c.pppoe_username || c.hotspot_username || '').trim().toLowerCase();
                  const session = username && typeof activeSessionsMap !== 'undefined' && activeSessionsMap && activeSessionsMap.get ? activeSessionsMap.get(username) : null;
                  const isOnline = !!session;
                  
                  const rxBytes = session && session.bytesIn ? session.bytesIn : (c.bytes_in || 0);
                  const txBytes = session && session.bytesOut ? session.bytesOut : (c.bytes_out || 0);
                  
                  function fmtB(b) {
                    const num = Number(b) || 0;
                    if (num <= 0) return '0 B';
                    const k = 1024;
                    const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
                    const i = Math.floor(Math.log(num) / Math.log(k));
                    return (num / Math.pow(k, i)).toFixed(1) + ' ' + sizes[i];
                  }
                %>
                <% if (isOnline) { %>
                  <span class="badge" style="background:rgba(16,185,129,0.18);color:#10b981;border:1px solid rgba(16,185,129,0.35);font-weight:700">
                    <i class="bi bi-circle-fill" style="font-size:7px;margin-right:4px"></i>ONLINE
                  </span>
                  <div style="font-size:12px;font-weight:800;color:var(--text);margin-top:3px">
                    <i class="bi bi-clock-history text-success me-1"></i><span class="conn-uptime"><%= session.uptime %></span>
                  </div>
                  <div style="font-size:10px;color:var(--muted)">
                    <span class="conn-ip"><%= session.ip %></span><% if (session.type) { %> (<%= session.type.toUpperCase() %>)<% } %>
                  </div>
                <% } else { %>
                  <span class="badge" style="background:rgba(148,163,184,0.12);color:#94a3b8;border:1px solid rgba(148,163,184,0.25)">
                    <i class="bi bi-circle-fill" style="font-size:7px;margin-right:4px"></i>OFFLINE
                  </span>
                  <div style="font-size:10px;color:var(--muted);margin-top:3px">Tidak Terhubung</div>
                <% } %>
                <div style="font-size:11px;margin-top:4px;display:flex;gap:6px;font-family:monospace;flex-wrap:wrap">
                  <span style="color:#38bdf8" title="Download (Receive)"><i class="bi bi-arrow-down"></i>RX: <strong class="conn-rx"><%= fmtB(rxBytes) %></strong></span>
                  <span style="color:#f472b6" title="Upload (Transmit)"><i class="bi bi-arrow-up"></i>TX: <strong class="conn-tx"><%= fmtB(txBytes) %></strong></span>
                </div>
              </td>
              <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                <div><%= c.address || '-' %></div>
                <% if (c.area) { %><div style="font-size:11px;color:#818cf8"><i class="bi bi-geo-alt"></i> <%= c.area %></div><% } %>
              </td>
              <td>
                <% if (c.status==='active') { %><span class="badge bs"><i class="bi bi-circle-fill" style="font-size:7px"></i><%= t('admin.customers.filter.active', 'Aktif') %></span>
                <% } else if (c.status==='suspended') { %><% if (c.deactivate_cause==='auto_unpaid') { %><span class="badge bd" title="<%= t('admin.cust.inactive','Nonaktif') %><%= t('admin.cust.reg_auto',' otomatis: menunggak ') %><%= c.unpaid_streak %> bulan"><i class="bi bi-person-x"></i> <%= t('admin.cust.inactive','Nonaktif') %> (auto)</span><% } else { %><span class="badge bw"><%= t('admin.customers.filter.suspended', 'Suspend') %></span><% } %>
                <% } else { %><span class="badge bm"><%= t('admin.customers.filter.inactive', 'Nonaktif') %></span><% } %>
                <% if (c.status === 'inactive' && (c.reg_total || c.reg_due_date || c.reg_voucher_code)) { %>
                  <div style="font-size:10px;margin-top:4px;color:var(--muted)">
                    <i class="bi bi-calculator"></i> Est: <b style="color:var(--primary)">Rp <%= Number(c.reg_total||0).toLocaleString('id-ID') %></b>
                    <% if (c.reg_due_date) { %> • JT <%= c.reg_due_date %><% } %>
                    <% if (c.reg_voucher_code) { %> • <i class="bi bi-ticket-perforated"></i> <%= c.reg_voucher_code %><% } %>
                  </div>
                <% } %>
                <div style="font-size:10px;margin-top:4px">
                  <i class="bi bi-clock-history"></i> <%= t('admin.customers.auto_isolate.label', 'Auto Isolir') %>:
                  <span class="<%= c.auto_isolate === 0 ? 'text-danger' : 'text-success' %>">
                    <%= c.auto_isolate === 0 ? t('admin.customers.auto_isolate.off', 'OFF') : t('admin.customers.auto_isolate.date_prefix', 'Tgl ') + (c.isolate_day || 10) %>
                  </span>
                </div>
              </td>
              <td class="text-center">
                <% if (c.unpaid_count > 0) { %>
                  <span class="badge bd"><%= c.unpaid_count %> <%= t('admin.customers.unpaid_suffix', 'tagihan') %></span>
                <% } else { %><span class="text-muted" style="font-size:12px"><%= t('admin.customers.paid_label', 'Lunas') %></span><% } %>
              </td>
              <td style="white-space:nowrap">
                <% if (c.status === 'inactive') { %>
                <form id="rej-<%= c.id %>" method="POST" action="/admin/registrations/<%= c.id %>/reject" style="display:none" onsubmit="return confirm('Tolak pendaftar ini?')"></form>
                <% } %>
                <% if (typeof session !== 'undefined' && session && !session.isCashier) { %>
                <% if (c.package_id && (c.package_promo_cycles || 0) > 0) { %>
                <form id="rpc-<%= c.id %>" method="POST" action="/admin/customers/<%= c.id %>/billing/reset-promo-cycles" style="display:none" onsubmit="return confirm('Reset counter siklus promo untuk pelanggan ini? Tagihan berikutnya akan memakai harga promo lagi sesuai pengaturan paket.')"></form>
                <% } %>
                <% if (c.package_id && c.install_date && c.package_prorate_first_invoice) { %>
                <form id="ipr-<%= c.id %>" method="POST" action="/admin/customers/<%= c.id %>/billing/install-prorata" style="display:none" onsubmit="return confirm('Buat tagihan SUSULAN prorata untuk bulan tanggal pasang? Hanya jika belum ada tagihan periode itu. Dasar harga: reguler (bukan promo).')"></form>
                <% } %>
                <% } %>
                <% if (!c.pppoe_username) { %>
                <form id="gpp-<%= c.id %>" method="POST" action="/admin/customers/<%= c.id %>/generate-pppoe" style="display:none" onsubmit="return confirm('Generate akun PPPoE untuk pelanggan ini?')"></form>
                <% } %>
                <form id="del-<%= c.id %>" method="POST" action="/admin/customers/<%= c.id %>/delete" style="display:none" data-confirm-msg=<%- JSON.stringify(t('admin.customers.confirm_delete', 'Hapus pelanggan ini?')).split('<').join('\\u003c') %> onsubmit="return confirm(this.dataset.confirmMsg)"></form>
                <div class="act">
                  <button type="button" class="act-btn" title="Aksi" onclick="actToggle(event, this)"><i class="bi bi-three-dots-vertical"></i></button>
                  <div class="act-menu">
                    <% if (c.status === 'inactive') { %>
                      <button type="button" class="act-item success" data-idx="<%= i %>" onclick="openRegCalc(+this.dataset.idx)"><i class="bi bi-calculator"></i> Kalkulator &amp; Setujui</button>
                      <button type="submit" form="rej-<%= c.id %>" class="act-item danger"><i class="bi bi-x-lg"></i> <%= t('admin.cust.reject_reg','Tolak Pendaftar') %></button>
                      <div class="act-sep"></div>
                    <% } %>
                    <button type="button" class="act-item" onclick="viewCustDetail(<%= i %>)"><i class="bi bi-eye"></i> <%- t('admin.cust.view_detail','Lihat Detail &amp; MikroTik') %></button>
                    <div class="act-sep"></div>
                    <button type="button" class="act-item" onclick="copyCustId(<%= i %>)"><i class="bi bi-person-badge"></i> <%= t('admin.cust.copy_id','Salin ID Pelanggan') %></button>
                    <button type="button" class="act-item" onclick="copyCustIp(<%= i %>)"><i class="bi bi-hdd-network"></i> <%= t('admin.cust.copy_ip','Salin IP Pelanggan') %></button>
                    <button type="button" class="act-item success" onclick="openCustIp(<%= i %>)"><i class="bi bi-box-arrow-up-right"></i> <%= t('admin.cust.open_ip','Masuk ke IP Pelanggan') %></button>
                    <a class="act-item" href="/admin/customers/<%= c.id %>/sticker-onu" target="_blank"><i class="bi bi-qr-code"></i> Cetak Stiker ONU</a>
                    <button type="button" class="act-item success" data-idx="<%= i %>" onclick="openGenInvoice(+this.dataset.idx)"><i class="bi bi-lightning-charge"></i> Generate Tagihan</button>
                    <button type="button" class="act-item primary" data-idx="<%= i %>" onclick="openPayInvoice(+this.dataset.idx)"><i class="bi bi-cash-coin"></i> Bayar Tagihan</button>
                    <% if (typeof session !== 'undefined' && session && !session.isCashier) { %>
                      <% if (c.package_id && (c.package_promo_cycles || 0) > 0) { %>
                      <button type="submit" form="rpc-<%= c.id %>" class="act-item"><i class="bi bi-arrow-counterclockwise"></i> <%= t('admin.cust.reset_promo','Reset Siklus Promo') %></button>
                      <% } %>
                      <% if (c.package_id && c.install_date && c.package_prorate_first_invoice) { %>
                      <button type="submit" form="ipr-<%= c.id %>" class="act-item"><i class="bi bi-calendar2-check"></i> <%= t('admin.cust.prorata_followup','Tagihan Susulan Prorata') %></button>
                      <% } %>
                    <% } %>
                    <% if (!c.pppoe_username) { %>
                      <button type="submit" form="gpp-<%= c.id %>" class="act-item primary"><i class="bi bi-key"></i> <%= t('admin.cust.gen_pppoe','Generate Akun PPPoE') %></button>
                    <% } %>
                    <button type="button" class="act-item" data-id="<%= c.id %>" onclick="syncCust(this)"><i class="bi bi-arrow-repeat"></i> Sync ke Jaringan</button>
                    <div class="act-sep"></div>
                    <button type="button" class="act-item" data-idx="<%= i %>" onclick="editCust(+this.dataset.idx)"><i class="bi bi-pencil"></i> <%= t('admin.cust.btn_edit','Edit Pelanggan') %></button>
                    <button type="submit" form="del-<%= c.id %>" class="act-item danger"><i class="bi bi-trash"></i> <%= t('admin.cust.btn_delete','Hapus Pelanggan') %></button>
                  </div>
                </div>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
      <form id="bulkDeleteCustForm" method="POST" action="/admin/customers/delete-bulk" style="display:none"></form>
    </div>
  </div>
</div>

<!-- Modal Tambah -->
<div class="mo" id="addModal">
  <div class="mb" style="max-width:720px;">
    <div class="mh"><span class="mt"><i class="bi bi-person-plus"></i> <%= t('admin.cust.add_customer','Tambah Pelanggan Baru') %></span><button class="mc" onclick="closeModal('addModal')">&times;</button></div>
    <form method="POST" action="/admin/customers">
      <div class="mbody" style="max-height:75vh; overflow-y:auto; padding-right:6px;">
        
        <% const isRadiusActive = (typeof settings !== 'undefined' && settings && String(settings.radius_enabled) === '1'); %>
        <% if (isRadiusActive) { %>
        <!-- SECTION 1: MODE AUTENTIKASI KONEKSI (UTAMA) -->
        <div style="background: rgba(99, 102, 241, 0.08); padding: 14px 16px; border-radius: 12px; border: 1px solid rgba(99, 102, 241, 0.25); margin-bottom: 16px;">
          <div class="fw6 mb-2" style="color:var(--primary); font-size:13px; display:flex; align-items:center; justify-content:space-between;">
            <span><i class="bi bi-cpu text-primary me-1"></i> <%= t('admin.cust.auth_mode','Mode Autentikasi Pelanggan (Utama)') %></span>
            <span class="badge bp" style="font-size:10px; padding:3px 8px;"><%= t('admin.cust.f_mikrotik_api','Diutamakan MikroTik API') %></span>
          </div>
          <div class="form-row" style="margin-bottom:0;" id="add_radius_select_fg">
            <div class="fg" style="margin-bottom:0;">
              <select class="fs" name="is_radius" id="add_is_radius" style="font-weight:700; height:42px;" onchange="handleAuthModeChange('add', this.value)">
                <option value="0" selected> <%= t('admin.cust.opt_mt_api','MikroTik API (Lokal /ppp secret - Utama & Default)') %></option>
                <option value="1"> <%= t('admin.cust.opt_radius','RADIUS Server (Billing Database Only)') %></option>
              </select>
              <small class="text-muted" style="font-size:11px; display:block; margin-top:4px;">
                Mode MikroTik API mengelola kredensial PPP langsung di menu /ppp secret RouterOS MikroTik.
              </small>
            </div>
          </div>
        </div>
        <% } else { %>
          <input type="hidden" name="is_radius" id="add_is_radius" value="0">
        <% } %>

        <!-- SECTION 2: INFORMASI PELANGGAN -->
        <div style="background: rgba(255, 255, 255, 0.02); padding: 14px 16px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 16px;">
          <div class="fw6 mb-2" style="font-size:13px; color:var(--text);"><i class="bi bi-person-vcard text-info me-1"></i> <%= t('admin.cust.sec_personal','Informasi Pribadi Pelanggan') %></div>
          <div class="form-row">
            <div class="fg"><label class="fl"><%= t('admin.cust.full_name','Nama Lengkap *') %></label><input class="fc" name="name" required placeholder="<%= t('admin.cust.ph_name','Contoh: John Doe') %>"></div>
            <div class="fg"><label class="fl"><%= t('admin.cust.phone_req','No. Telepon / WA *') %></label><input class="fc" name="phone" placeholder="<%= t('admin.cust.ph_phone','Contoh: 08123456789') %>" required></div>
          </div>
          <div class="form-row">
            <div class="fg">
              <label class="fl"><i class="bi bi-card-text"></i> <%= t('admin.cust.nik_opt','No. Identitas (KTP/SIM/Paspor) (Opsional)') %></label>
              <input class="fc" name="nik" placeholder="<%= t('admin.cust.ph_nik','Contoh: 3201xxxxxxxxxxxx') %>">
            </div>
            <div class="fg"><label class="fl"><%= t('admin.cust.f_email','Email (Notifikasi Billing)') %></label><input class="fc" name="email" type="email" placeholder="customer@example.com"></div>
          </div>
          <div class="form-row">
            <div class="fg">
              <label class="fl"><i class="bi bi-geo-alt"></i> <%= t('collector.col_area','Area / Wilayah') %></label>
              <select class="fs" name="area" id="add_area">
                <option value=""><%= t('admin.cust.opt_area','-- Pilih Area --') %></option>
                <% if (typeof masterAreas !== 'undefined' && masterAreas && masterAreas.length > 0) { %>
                  <% masterAreas.forEach(a => { %>
                    <option value="<%= a.name %>"><%= a.name %></option>
                  <% }) %>
                <% } else if (typeof areas !== 'undefined') { %>
                  <% areas.forEach(a => { %>
                    <option value="<%= a %>"><%= a %></option>
                  <% }) %>
                <% } %>
              </select>
            </div>
          </div>
          <div class="fg"><label class="fl"><%= t('admin.cust.f_address_full','Alamat Lengkap') %></label><textarea class="fc" name="address" placeholder="<%= t('admin.cust.ph_addr','Jl. Raya No. 123...') %>"></textarea></div>
        </div>

        <!-- SECTION 3: PAKET & PENGATURAN KONEKSI -->
        <div style="background: rgba(255, 255, 255, 0.02); padding: 14px 16px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 16px;">
          <div class="fw6 mb-2" style="font-size:13px; color:var(--text);"><i class="bi bi-router text-warning me-1"></i> Paket & Akses Jaringan (MikroTik / RADIUS)</div>
          <div class="form-row">
            <div class="fg">
              <label class="fl"><%= t('admin.cust.pkg_req','Paket Internet *') %></label>
              <select class="fs" name="package_id" required>
                <option value=""><%= t('tech.cc.ph_pkg','-- Pilih Paket --') %></option>
                <% packages.forEach(p => { %>
                <option value="<%= p.id %>"><%= p.name %> — Rp <%= p.price.toLocaleString('id-ID') %></option>
                <% }) %>
              </select>
            </div>
            <div class="fg">
              <label class="fl">Router MikroTik</label>
              <select class="fs" name="router_id" id="add_router_select" onchange="loadRouterLists('add', this.value)">
                <option value=""><%= t('admin.cust.opt_default','-- Default (Pengaturan) --') %></option>
                <% if (typeof routers !== 'undefined') { %>
                  <% routers.forEach(r => { %>
                    <option value="<%= r.id %>"><%= r.name %> (<%= r.host %>)</option>
                  <% }) %>
                <% } %>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="fg">
              <label class="fl"><%= t('admin.cust.conn_method','Metode Koneksi') %></label>
              <select class="fs" name="connection_type" id="add_connection_type" onchange="toggleConnectionFields('add')">
                <option value="pppoe" selected><%= isRadiusActive ? 'PPPoE (RADIUS / MikroTik)' : 'PPPoE (MikroTik API)' %></option>
                <option value="static">Static IP (MikroTik)</option>
                <option value="hotspot">Hotspot (MikroTik)</option>
              </select>
            </div>
            <div class="fg">
              <label class="fl"><%= t('admin.cust.onu_tag','Tag ONU (GenieACS)') %></label>
              <input class="fc" name="genieacs_tag" placeholder="<%= t('admin.cust.ph_same_cust','Sama dengan ID/User Pelanggan') %>">
            </div>
          </div>

          <!-- KREDENSIAL PPPoE / RADIUS -->
          <div id="add_pppoe_field">
            <div class="form-row" style="background:rgba(59,130,246,0.04); padding:12px 14px; border-radius:10px; border:1px solid rgba(59,130,246,0.15);">
              <div class="fg">
                <label class="fl" style="font-weight:700; color:var(--primary);"><i class="bi bi-person-fill"></i> PPPoE Username *</label>
                <% if (isRadiusActive) { %>
                <div style="display:flex;gap:10px 14px;align-items:center;flex-wrap:wrap;margin-bottom:6px">
                  <label style="margin:0;display:flex;align-items:center;gap:4px;cursor:pointer;font-size:11px;font-weight:600;">
                    <input type="radio" name="pppoe_input_mode" value="mikrotik" checked onchange="togglePppoeInputMode('add')">
                    <span><%= t('admin.cust.pick_from_mt','Pilih dari MikroTik (API)') %></span>
                  </label>
                  <label style="margin:0;display:flex;align-items:center;gap:4px;cursor:pointer;font-size:11px;font-weight:600;">
                    <input type="radio" name="pppoe_input_mode" value="manual" onchange="togglePppoeInputMode('add')">
                    <span><%= t('admin.cust.f_manual_radius','Input Manual (RADIUS)') %></span>
                  </label>
                </div>
                <% } else { %>
                  <input type="hidden" name="pppoe_input_mode" value="mikrotik">
                <% } %>
                <div id="add_pppoe_mikrotik_input">
                  <input class="fc" name="pppoe_username" list="add_pppoe_list" placeholder="<%= t('admin.cust.ph_pick_pppoe','Pilih / cari username PPPoE MikroTik') %>">
                  <datalist id="add_pppoe_list"></datalist>
                  <div class="hint" id="add_pppoe_hint"></div>
                </div>
                <div id="add_pppoe_manual_input" style="display:none">
                  <input class="fc" id="add_pppoe_username_manual" placeholder="<%= t('admin.cust.ph_new_pppoe','Ketik username PPPoE baru...') %>">
                </div>
              </div>
              <div class="fg">
                <label class="fl" style="font-weight:700; color:var(--warning);"><i class="bi bi-key-fill"></i> <%= isRadiusActive ? 'Password PPPoE / RADIUS *' : 'Password PPPoE *' %></label>
                <input class="fc" name="pppoe_password" id="add_pppoe_password" placeholder="<%= t('admin.cust.ph_pppoe_pass','Masukkan password PPPoE') %>" required>
                <small class="text-muted" style="font-size:10px;display:block;margin-top:4px"><%= isRadiusActive ? t('admin.cust.modem_hint','Kredensial login modem pelanggan untuk RADIUS & PPPoE.') : t('admin.cust.modem_hint_mt','Kredensial login modem pelanggan untuk PPPoE MikroTik API.') %></small>
              </div>
            </div>
          </div>

          <!-- STATIC IP -->
          <div class="form-row" id="add_static_field" style="display:none">
            <div class="fg">
              <label class="fl"><%= t('admin.cust.cust_ip','IP Address Pelanggan') %></label>
              <input class="fc" name="static_ip" placeholder="<%= t('admin.cust.ph_ip','Contoh: 192.168.10.10') %>">
            </div>
          </div>

          <!-- HOTSPOT -->
          <div id="add_hotspot_field" style="display:none">
            <div class="form-row">
              <div class="fg">
                <label class="fl">Hotspot Username</label>
                <input class="fc" name="hotspot_username" placeholder="<%= t('admin.cust.ph_user','Contoh: user01') %>">
              </div>
              <div class="fg">
                <label class="fl">Hotspot Password</label>
                <input class="fc" name="hotspot_password" placeholder="<%= t('admin.cust.ph_same_user','Kosong = sama dengan username') %>">
              </div>
            </div>
            <div class="form-row">
              <div class="fg">
                <label class="fl">Hotspot User Profile</label>
                <input class="fc" name="hotspot_profile" list="add_hotspot_profile_list" placeholder="<%= t('admin.cust.ph_hotspot_profile','Pilih profile hotspot') %>">
                <datalist id="add_hotspot_profile_list"></datalist>
                <div class="hint" id="add_hotspot_profile_hint"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- SECTION 4: BILLING & OTOMASI -->
        <div style="background: rgba(255, 255, 255, 0.02); padding: 14px 16px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 16px;">
          <div class="fw6 mb-2" style="font-size:13px; color:var(--text);"><i class="bi bi-cash-stack text-success me-1"></i> Penagihan, Kolektor, & <%= t('admin.cust.status','Status Akun') %></div>
          <div class="form-row">
            <div class="fg">
              <label class="fl"><%= t('admin.cust.status','Status Akun') %></label>
              <select class="fs" name="status">
                <option value="active" selected><%= t('common.active','Aktif') %></option>
                <option value="suspended"><%= t('admin.cust.suspended','Suspend / Isolir') %></option>
                <option value="inactive"><%= t('admin.cust.inactive','Nonaktif') %></option>
              </select>
            </div>
            <div class="fg"><label class="fl"><%= t('admin.cust.install_date','Tanggal Pasang') %></label><input class="fc" type="date" name="install_date"></div>
          </div>
          <div class="form-row">
            <div class="fg">
              <label class="fl"><%= t('tech.cc.auto_isolate','Isolir Otomatis') %></label>
              <select class="fs" name="auto_isolate">
                <option value="1" selected><%= t('admin.cust.st_active_auto','Aktif (Auto-Isolir Jatuh Tempo)') %></option>
                <option value="0"><%= t('admin.cust.opt_free_isolir','Bebas Isolir (Tidak Pernah Isolir)') %></option>
              </select>
            </div>
            <div class="fg">
              <label class="fl"><%= t('admin.cust.isolir_day','Tanggal Isolir (1-31)') %></label>
              <input class="fc" type="number" name="isolate_day" value="10" min="1" max="31">
            </div>
          </div>
          <div class="form-row">
            <div class="fg">
              <label class="fl"><i class="bi bi-person-badge"></i> <%= t('admin.cust.f_collector','Kolektor Penagihan') %></label>
              <select class="fs" name="collector_id" id="add_collector_id">
                <option value=""><%= t('admin.cust.opt_no_collector','-- Tanpa Kolektor --') %></option>
                <% if (typeof collectors !== 'undefined') { %>
                  <% collectors.forEach(col => { %>
                    <option value="<%= col.id %>" data-area="<%= col.area || '' %>"><%= col.name %> (<%= col.username %>)<%= col.area ? ' [Area: ' + col.area + ']' : '' %></option>
                  <% }) %>
                <% } %>
              </select>
            </div>
            <div class="fg">
              <label class="fl"><%= t('admin.cust.isolir_profile','Profile Isolir / Address List') %></label>
              <select class="fs" name="isolir_profile" id="add_isolir_select">
                <option value="isolir">isolir</option>
              </select>
            </div>
          </div>
        </div>

        <!-- SECTION 5: OPSEK & INFRASTRUKTUR (OLT, ODP, KOORDINAT) -->
        <div style="background: rgba(255, 255, 255, 0.02); padding: 14px 16px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 16px;">
          <div class="fw6 mb-2" style="font-size:13px; color:var(--text);"><i class="bi bi-diagram-3 text-secondary me-1"></i> Infrastruktur (OLT, ODP, & Peta)</div>
          <div class="form-row">
            <div class="fg">
              <label class="fl"><%= t('admin.cust.olt_device','Perangkat OLT') %></label>
              <select class="fs" name="olt_id">
                <option value=""><%= t('tech.cc.ph_olt','-- Tanpa OLT --') %></option>
                <% if (typeof olts !== 'undefined') { %>
                  <% olts.forEach(o => { %>
                    <option value="<%= o.id %>"><%= o.name %> (<%= o.brand %>)</option>
                  <% }) %>
                <% } %>
              </select>
            </div>
            <div class="fg">
              <label class="fl">ODP</label>
              <select class="fs" name="odp_id" id="add_odp_id" onchange="loadOdpPorts('add')">
                <option value=""><%= t('admin.cust.opt_no_odp','-- Tanpa ODP --') %></option>
                <% if (typeof odps !== 'undefined') { %>
                  <% odps.forEach(o => { %>
                    <option value="<%= o.id %>"><%= o.name %></option>
                  <% }) %>
                <% } %>
              </select>
            </div>
          </div>
          <div class="form-row">
            <div class="fg"><label class="fl"><%= t('admin.cust.odp_port','Port ODP') %></label>
              <select class="fs" name="pon_port" id="add_pon_port"><option value=""><%= t('admin.cust.opt_no_port','-- Tanpa Port --') %></option></select>
