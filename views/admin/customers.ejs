async function fetchLiveSessions() {
  try {
    const res = await fetch('/admin/api/customers/live-sessions');
    if (!res.ok) return;
    const data = await res.json();
    if (!data.ok || !data.sessions) return;

    for (const [uname, session] of Object.entries(data.sessions)) {
      activeSessionsMapObj.set(uname.toLowerCase(), session);
    }

    document.querySelectorAll('.cust-conn-cell').forEach(cell => {
      const username = cell.dataset.username;
      if (!username) return;
      const s = data.sessions[username];
      const rxEl = cell.querySelector('.conn-rx');
      const txEl = cell.querySelector('.conn-tx');
      const uptimeEl = cell.querySelector('.conn-uptime');
      const ipEl = cell.querySelector('.conn-ip');

      if (s) {
        if (rxEl) rxEl.textContent = formatBytesVal(s.bytesIn);
        if (txEl) txEl.textContent = formatBytesVal(s.bytesOut);
        if (uptimeEl) uptimeEl.textContent = s.uptime || '-';
        if (ipEl) ipEl.textContent = s.ip || '-';
      }
    });

    if (currentDetailIdx !== null) {
      updateDetailModalLive(currentDetailIdx);
    }
  } catch (err) {
    console.warn('Live sessions fetch error:', err);
  }
}

