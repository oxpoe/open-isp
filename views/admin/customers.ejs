            <div class="fg" id="add_mac_field" style="display:none">
              <label class="fl"><%= t('admin.cust.mac_opt','MAC Address (Opsional)') %></label>
              <input class="fc" name="mac_address" placeholder="<%= t('admin.cust.ph_mac','Contoh: AA:BB:CC:DD:EE:FF') %>">
            </div>
          </div>
          <div class="form-row">
            <div class="fg"><label class="fl">Latitude</label><input class="fc" name="lat" id="add_lat" placeholder="-6.xxx"></div>
            <div class="fg">
              <label class="fl">Longitude</label>
              <div style="display:flex;gap:4px">
                <input class="fc" name="lng" id="add_lng" placeholder="106.xxx">
                <button type="button" class="btn btn-g btn-sm" onclick="openPicker('add')" title="<%= t('admin.cust.tt_pick_map','Pilih di Peta') %>"><i class="bi bi-geo-alt"></i></button>
              </div>
            </div>
          </div>
          <div class="fg" style="margin-top:10px;"><label class="fl"><%= t('tech.cc.note','Catatan') %></label><textarea class="fc" name="notes" placeholder="<%= t('admin.cust.ph_note','Catatan internal opsional...') %>"></textarea></div>
        </div>

      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('addModal')"><%= t('common.cancel','Batal') %></button>
        <button type="submit" class="btn btn-p"><i class="bi bi-check-lg"></i> <%= t('admin.cust.save_customer','Simpan Pelanggan') %></button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Import -->
<div class="mo" id="importModal">
  <div class="mb" style="max-width:400px">
    <div class="mh"><span class="mt"><i class="bi bi-file-earmark-arrow-up"></i> <%= t('admin.cust.btn_import','Import Pelanggan') %></span><button class="mc" onclick="closeModal('importModal')">&times;</button></div>
    <form method="POST" action="/admin/customers/import" enctype="multipart/form-data">
      <div class="mbody">
        <p style="font-size:13px;color:var(--muted);margin-bottom:16px">
          Unggah file Excel (.xlsx). Pastikan format kolom sesuai dengan hasil Export.
          <br><br>
          <a href="/admin/customers/export" style="color:var(--primary);text-decoration:none"><i class="bi bi-download"></i> Unduh format excel</a>
        </p>
        <div class="fg">
          <label class="fl"><%= t('admin.cust.pick_excel','Pilih File Excel') %></label>
          <input type="file" name="file" class="fc" accept=".xlsx" required>
        </div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('importModal')"><%= t('common.cancel','Batal') %></button>
        <button type="submit" class="btn btn-p"><i class="bi bi-upload"></i> <%= t('admin.cust.start_import','Mulai Impor') %></button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Edit -->
<div class="mo" id="editModal">
  <div class="mb" style="max-width:720px;">
    <div class="mh"><span class="mt"><i class="bi bi-pencil"></i> <%= t('admin.cust.btn_edit','Edit Pelanggan') %></span><button class="mc" onclick="closeModal('editModal')">&times;</button></div>
    <form method="POST" id="editForm">
      <div class="mbody" style="max-height:75vh; overflow-y:auto; padding-right:6px;">
        
        <% if (isRadiusActive) { %>
        <!-- SECTION 1: MODE AUTENTIKASI KONEKSI (UTAMA) -->
        <div style="background: rgba(99, 102, 241, 0.08); padding: 14px 16px; border-radius: 12px; border: 1px solid rgba(99, 102, 241, 0.25); margin-bottom: 16px;">
          <div class="fw6 mb-2" style="color:var(--primary); font-size:13px; display:flex; align-items:center; justify-content:space-between;">
            <span><i class="bi bi-cpu text-primary me-1"></i> <%= t('admin.cust.auth_mode','Mode Autentikasi Pelanggan (Utama)') %></span>
            <span class="badge bp" style="font-size:10px; padding:3px 8px;"><%= t('admin.cust.f_mikrotik_api','Diutamakan MikroTik API') %></span>
          </div>
          <div class="form-row" style="margin-bottom:0;" id="e_radius_select_fg">
            <div class="fg" style="margin-bottom:0;">
              <select class="fs" name="is_radius" id="e_is_radius" style="font-weight:700; height:42px;" onchange="handleAuthModeChange('edit', this.value)">
                <option value="0"> <%= t('admin.cust.opt_mt_api','MikroTik API (Lokal /ppp secret - Utama & Default)') %></option>
                <option value="1"> <%= t('admin.cust.opt_radius','RADIUS Server (Billing Database Only)') %></option>
              </select>
              <small class="text-muted" style="font-size:11px; display:block; margin-top:4px;">
                Mode MikroTik API mengelola kredensial PPP langsung di menu /ppp secret RouterOS MikroTik.
              </small>
            </div>
          </div>
        </div>
        <% } else { %>
          <input type="hidden" name="is_radius" id="e_is_radius" value="0">
        <% } %>

        <!-- SECTION 2: INFORMASI PELANGGAN -->
        <div style="background: rgba(255, 255, 255, 0.02); padding: 14px 16px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 16px;">
          <div class="fw6 mb-2" style="font-size:13px; color:var(--text);"><i class="bi bi-person-vcard text-info me-1"></i> <%= t('admin.cust.sec_personal','Informasi Pribadi Pelanggan') %></div>
          <div class="form-row">
            <div class="fg"><label class="fl"><%= t('admin.cust.full_name','Nama Lengkap *') %></label><input class="fc" name="name" id="e_name" required></div>
            <div class="fg"><label class="fl"><%= t('admin.cust.phone_req','No. Telepon / WA *') %></label><input class="fc" name="phone" id="e_phone" required></div>
          </div>
          <div class="form-row">
            <div class="fg">
              <label class="fl"><i class="bi bi-card-text"></i> <%= t('admin.cust.nik_opt','No. Identitas (KTP/SIM/Paspor) (Opsional)') %></label>
              <input class="fc" name="nik" id="e_nik" placeholder="<%= t('admin.cust.ph_nik','Contoh: 3201xxxxxxxxxxxx') %>">
            </div>
            <div class="fg"><label class="fl"><%= t('admin.cust.f_email','Email (Notifikasi Billing)') %></label><input class="fc" name="email" id="e_email" type="email"></div>
          </div>
          <div class="form-row">
            <div class="fg">
              <label class="fl"><i class="bi bi-geo-alt"></i> <%= t('collector.col_area','Area / Wilayah') %></label>
              <select class="fs" name="area" id="e_area">
                <option value=""><%= t('admin.cust.opt_area','-- Pilih Area --') %></option>
                <% if (typeof masterAreas !== 'undefined' && masterAreas && masterAreas.length > 0) { %>
                  <% masterAreas.forEach(a => { %>
                    <option value="<%= a.name %>"><%= a.name %></option>
                  <% }) %>
                <% } else if (typeof areas !== 'undefined') { %>
                  <% areas.forEach(a => { %>
                    <option value="<%= a %>"><%= a %></option>
                  <% }) %>
                <% } %>
              </select>
            </div>
          </div>
          <div class="fg"><label class="fl"><%= t('admin.cust.f_address_full','Alamat Lengkap') %></label><textarea class="fc" name="address" id="e_address"></textarea></div>
        </div>

        <!-- SECTION 3: PAKET & PENGATURAN KONEKSI -->
        <div style="background: rgba(255, 255, 255, 0.02); padding: 14px 16px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 16px;">
          <div class="fw6 mb-2" style="font-size:13px; color:var(--text);"><i class="bi bi-router text-warning me-1"></i> Paket & Akses Jaringan (MikroTik / RADIUS)</div>
          <div class="form-row">
            <div class="fg">
              <label class="fl"><%= t('admin.cust.pkg_req','Paket Internet *') %></label>
              <select class="fs" name="package_id" id="e_package" required>
                <option value=""><%= t('tech.cc.ph_pkg','-- Pilih Paket --') %></option>
                <% packages.forEach(p => { %>
                <option value="<%= p.id %>"><%= p.name %> — Rp <%= p.price.toLocaleString('id-ID') %></option>
                <% }) %>
              </select>
            </div>
            <div class="fg">
              <label class="fl">Router MikroTik</label>
              <select class="fs" name="router_id" id="e_router_id" onchange="loadRouterLists('edit', this.value)">
                <option value=""><%= t('admin.cust.opt_default','-- Default (Pengaturan) --') %></option>
                <% if (typeof routers !== 'undefined') { %>
                  <% routers.forEach(r => { %>
                    <option value="<%= r.id %>"><%= r.name %> (<%= r.host %>)</option>
                  <% }) %>
                <% } %>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="fg">
              <label class="fl"><%= t('admin.cust.conn_method','Metode Koneksi') %></label>
              <select class="fs" name="connection_type" id="e_connection_type" onchange="toggleConnectionFields('edit')">
                <option value="pppoe"><%= isRadiusActive ? 'PPPoE (RADIUS / MikroTik)' : 'PPPoE (MikroTik API)' %></option>
                <option value="static">Static IP (MikroTik)</option>
                <option value="hotspot">Hotspot (MikroTik)</option>
              </select>
            </div>
            <div class="fg">
              <label class="fl"><%= t('admin.cust.onu_tag','Tag ONU (GenieACS)') %></label>
              <input class="fc" name="genieacs_tag" id="e_tag">
            </div>
          </div>

          <!-- KREDENSIAL PPPoE / RADIUS -->
          <div id="e_pppoe_field">
            <div class="form-row" style="background:rgba(59,130,246,0.04); padding:12px 14px; border-radius:10px; border:1px solid rgba(59,130,246,0.15);">
              <div class="fg">
                <label class="fl" style="font-weight:700; color:var(--primary);"><i class="bi bi-person-fill"></i> PPPoE Username *</label>
                <input class="fc" name="pppoe_username" id="e_pppoe" list="e_pppoe_list" placeholder="PPPoE Username" required>
                <datalist id="e_pppoe_list"></datalist>
                <div class="hint" id="e_pppoe_hint"></div>
              </div>
              <div class="fg">
                <label class="fl" style="font-weight:700; color:var(--warning);"><i class="bi bi-key-fill"></i> Password PPPoE / RADIUS *</label>
                <input class="fc" name="pppoe_password" id="e_pppoe_password" placeholder="<%= t('admin.cust.ph_pppoe_pass','Masukkan password PPPoE') %>" required>
                <small class="text-muted" style="font-size:10px;display:block;margin-top:4px"><%= t('admin.cust.modem_hint','Kredensial login modem pelanggan untuk RADIUS & PPPoE.') %></small>
              </div>
            </div>
          </div>

          <!-- STATIC IP -->
          <div class="form-row" id="e_static_field" style="display:none">
            <div class="fg">
              <label class="fl"><%= t('admin.cust.cust_ip','IP Address Pelanggan') %></label>
              <input class="fc" name="static_ip" id="e_static_ip" placeholder="<%= t('admin.cust.ph_ip','Contoh: 192.168.10.10') %>">
            </div>
          </div>

          <!-- HOTSPOT -->
          <div id="e_hotspot_field" style="display:none">
            <div class="form-row">
              <div class="fg">
                <label class="fl">Hotspot Username</label>
                <input class="fc" name="hotspot_username" id="e_hotspot_username" placeholder="<%= t('admin.cust.ph_user','Contoh: user01') %>">
              </div>
              <div class="fg">
                <label class="fl">Hotspot Password</label>
                <input class="fc" name="hotspot_password" id="e_hotspot_password" placeholder="<%= t('admin.cust.ph_same_user','Kosong = sama dengan username') %>">
              </div>
            </div>
            <div class="form-row">
              <div class="fg">
                <label class="fl">Hotspot User Profile</label>
                <input class="fc" name="hotspot_profile" id="e_hotspot_profile" list="e_hotspot_profile_list" placeholder="<%= t('admin.cust.ph_hotspot_profile','Pilih profile hotspot') %>">
                <datalist id="e_hotspot_profile_list"></datalist>
                <div class="hint" id="e_hotspot_profile_hint"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- SECTION 4: BILLING & OTOMASI -->
        <div style="background: rgba(255, 255, 255, 0.02); padding: 14px 16px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 16px;">
          <div class="fw6 mb-2" style="font-size:13px; color:var(--text);"><i class="bi bi-cash-stack text-success me-1"></i> Penagihan, Kolektor, & <%= t('admin.cust.status','Status Akun') %></div>
          <div class="form-row">
            <div class="fg">
              <label class="fl"><%= t('admin.cust.status','Status Akun') %></label>
              <select class="fs" name="status" id="e_status">
                <option value="active"><%= t('common.active','Aktif') %></option>
                <option value="suspended"><%= t('admin.cust.suspended','Suspend / Isolir') %></option>
                <option value="inactive"><%= t('admin.cust.inactive','Nonaktif') %></option>
              </select>
            </div>
            <div class="fg"><label class="fl"><%= t('admin.cust.install_date','Tanggal Pasang') %></label><input class="fc" type="date" name="install_date" id="e_install"></div>
          </div>
          <div class="form-row">
            <div class="fg">
              <label class="fl"><%= t('tech.cc.auto_isolate','Isolir Otomatis') %></label>
              <select class="fs" name="auto_isolate" id="e_auto_isolate">
                <option value="1"><%= t('admin.cust.st_active_auto','Aktif (Auto-Isolir Jatuh Tempo)') %></option>
                <option value="0"><%= t('admin.cust.opt_free_isolir','Bebas Isolir (Tidak Pernah Isolir)') %></option>
              </select>
            </div>
            <div class="fg">
              <label class="fl"><%= t('admin.cust.isolir_day_pp','Tanggal Isolir (Pascabayar)') %></label>
              <input class="fc" type="number" name="isolate_day" id="e_isolate_day" min="1" max="31">
            </div>
          </div>
          <div class="form-row">
            <div class="fg">
              <label class="fl"><i class="bi bi-hourglass-split text-warning me-1"></i> <%= t('admin.cust.validity_prepaid','Masa Aktif / Expired Date (Khusus Prabayar)') %></label>
              <input class="fc" type="date" name="expired_at" id="e_expired_at">
              <small class="text-muted" style="font-size:10px;display:block;margin-top:2px;"><%= t('admin.cust.reg_hint','Otomatis dihitung saat pasang/bayar. Bisa disesuaikan manual jika perlu.') %></small>
            </div>
          </div>
          <div class="form-row">
            <div class="fg">
              <label class="fl"><i class="bi bi-person-badge"></i> <%= t('admin.cust.f_collector','Kolektor Penagihan') %></label>
              <select class="fs" name="collector_id" id="e_collector_id">
                <option value=""><%= t('admin.cust.opt_no_collector','-- Tanpa Kolektor --') %></option>
                <% if (typeof collectors !== 'undefined') { %>
                  <% collectors.forEach(col => { %>
                    <option value="<%= col.id %>" data-area="<%= col.area || '' %>"><%= col.name %> (<%= col.username %>)<%= col.area ? ' [Area: ' + col.area + ']' : '' %></option>
                  <% }) %>
                <% } %>
              </select>
            </div>
            <div class="fg">
              <label class="fl"><%= t('admin.cust.isolir_profile','Profile Isolir / Address List') %></label>
              <select class="fs" name="isolir_profile" id="e_isolir_profile">
                <option value="isolir">isolir</option>
              </select>
            </div>
          </div>
        </div>

        <!-- SECTION 5: OPSEK & INFRASTRUKTUR (OLT, ODP, KOORDINAT) -->
        <div style="background: rgba(255, 255, 255, 0.02); padding: 14px 16px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 16px;">
          <div class="fw6 mb-2" style="font-size:13px; color:var(--text);"><i class="bi bi-diagram-3 text-secondary me-1"></i> Infrastruktur (OLT, ODP, & Peta)</div>
          <div class="form-row">
            <div class="fg">
              <label class="fl"><%= t('admin.cust.olt_device','Perangkat OLT') %></label>
              <select class="fs" name="olt_id" id="e_olt_id">
                <option value=""><%= t('tech.cc.ph_olt','-- Tanpa OLT --') %></option>
                <% if (typeof olts !== 'undefined') { %>
                  <% olts.forEach(o => { %>
                    <option value="<%= o.id %>"><%= o.name %> (<%= o.brand %>)</option>
                  <% }) %>
                <% } %>
              </select>
            </div>
            <div class="fg">
              <label class="fl">ODP</label>
              <select class="fs" name="odp_id" id="e_odp_id" onchange="loadOdpPorts('edit')">
                <option value=""><%= t('admin.cust.opt_no_odp','-- Tanpa ODP --') %></option>
                <% if (typeof odps !== 'undefined') { %>
                  <% odps.forEach(o => { %>
                    <option value="<%= o.id %>"><%= o.name %></option>
                  <% }) %>
                <% } %>
              </select>
            </div>
          </div>
          <div class="form-row">
            <div class="fg"><label class="fl"><%= t('admin.cust.odp_port','Port ODP') %></label>
              <select class="fs" name="pon_port" id="e_pon_port"><option value=""><%= t('admin.cust.opt_no_port','-- Tanpa Port --') %></option></select>
            </div>
            <div class="fg" id="e_mac_field" style="display:none">
              <label class="fl"><%= t('admin.cust.mac_opt','MAC Address (Opsional)') %></label>
              <input class="fc" name="mac_address" id="e_mac_address" placeholder="<%= t('admin.cust.ph_mac','Contoh: AA:BB:CC:DD:EE:FF') %>">
            </div>
          </div>
          <div class="form-row">
            <div class="fg"><label class="fl">Latitude</label><input class="fc" name="lat" id="e_lat" placeholder="-6.xxx"></div>
            <div class="fg">
              <label class="fl">Longitude</label>
              <div style="display:flex;gap:4px">
                <input class="fc" name="lng" id="e_lng" placeholder="106.xxx">
                <button type="button" class="btn btn-g btn-sm" onclick="openPicker('edit')" title="<%= t('admin.cust.tt_pick_map','Pilih di Peta') %>"><i class="bi bi-geo-alt"></i></button>
              </div>
            </div>
          </div>
          <div class="fg" style="margin-top:10px;"><label class="fl"><%= t('tech.cc.note','Catatan') %></label><textarea class="fc" name="notes" id="e_notes" placeholder="<%= t('admin.cust.ph_note','Catatan internal opsional...') %>"></textarea></div>
        </div>

      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="syncCustFromModal()"><i class="bi bi-arrow-repeat"></i> <%= t('admin.cust.apply_network','Terapkan ke Jaringan') %></button>
        <button type="button" class="btn btn-g" onclick="closeModal('editModal')"><%= t('common.cancel','Batal') %></button>
        <button type="submit" class="btn btn-p"><i class="bi bi-check-lg"></i> <%= t('admin.cust.update_customer','Update Pelanggan') %></button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Generate Tagihan (Per Pelanggan) -->
<div class="mo" id="genInvoiceModal">
  <div class="mb" style="max-width:520px">
    <div class="mh"><span class="mt"><i class="bi bi-lightning-charge"></i> <%= t('admin.customers.generate_invoice_title', 'Generate Tagihan (Pelanggan)') %></span><button class="mc" onclick="closeModal('genInvoiceModal')">&times;</button></div>
    <form method="POST" id="genInvoiceForm">
      <div class="mbody">
        <div class="alert alert-i"><i class="bi bi-info-circle"></i> <%= t('admin.customers.generate_invoice_hint', 'Tagihan hanya dibuat untuk pelanggan yang dipilih. Jika sudah ada, tidak akan dibuat ulang.') %></div>
        <div class="fg">
          <label class="fl"><%= t('admin.customers.generate_invoice_customer', 'Pelanggan') %></label>
          <input class="fc" id="genInvoiceCustomer" readonly>
        </div>
        <div class="form-row">
          <div class="fg">
            <label class="fl"><%= t('admin.billing.month', 'Bulan') %></label>
            <select class="fs" name="month" required>
              <% const genMns = (lang === 'en')
                ? ['January','February','March','April','May','June','July','August','September','October','November','December']
                : ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
                 for(let m=1;m<=12;m++){%>
              <option value="<%= m %>" <%= m===new Date().getMonth()+1?'selected':'' %>><%= genMns[m-1] %></option>
              <% } %>
            </select>
          </div>
          <div class="fg">
            <label class="fl"><%= t('admin.billing.year', 'Tahun') %></label>
            <select class="fs" name="year" required>
              <% for(let y=new Date().getFullYear()+1; y>=2023; y--){ %>
              <option value="<%= y %>" <%= y===new Date().getFullYear() ? 'selected' : '' %>><%= y %></option>
              <% } %>
            </select>
          </div>
        </div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('genInvoiceModal')"><%= t('common.cancel', 'Batal') %></button>
        <button type="submit" class="btn btn-p"><i class="bi bi-lightning-charge"></i> <%= t('admin.customers.generate_invoice_btn', 'Generate') %></button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Bayar Tagihan (Per Pelanggan) -->
<div class="mo" id="payInvoiceModal">
  <div class="mb" style="max-width:560px">
    <div class="mh"><span class="mt"><i class="bi bi-cash-coin"></i> <%= t('admin.customers.pay_invoice_title', 'Bayar Tagihan (Pelanggan)') %></span><button class="mc" onclick="closeModal('payInvoiceModal')">&times;</button></div>
