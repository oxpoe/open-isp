function rcFmt(n){ return 'Rp ' + Math.round(Number(n)||0).toLocaleString('id-ID'); }
function rcCompute(){
  var fee = parseFloat(document.getElementById('rc_fee').value)||0;
  var install = parseFloat(document.getElementById('rc_install').value)||0;
  var disc = parseFloat(document.getElementById('rc_discount').value)||0;
  var s = document.getElementById('rc_start').value;
  var d = document.getElementById('rc_due').value;
  var hint = document.getElementById('rc_hint');
  if(!s || !d){ hint.textContent='Isi tanggal mulai & jatuh tempo.'; return; }
  var sd = new Date(s), dd = new Date(d);
  if(dd <= sd){ hint.textContent='Jatuh tempo harus setelah tanggal mulai.'; return; }
  var diffDays = Math.max(1, Math.round((dd - sd)/86400000));
  var daysInMonth = new Date(dd.getFullYear(), dd.getMonth()+1, 0).getDate();
  var perDay = fee / daysInMonth;
  var prorata = Math.round(diffDays * perDay);
  var gross = prorata + install;
  var dcap = Math.min(disc, gross);
  var total = Math.max(0, gross - dcap);
  document.getElementById('rc_days').value = diffDays + ' hari';
  document.getElementById('rc_prorata').textContent = rcFmt(prorata);
  document.getElementById('rc_install_out').textContent = rcFmt(install);
  document.getElementById('rc_disc_out').textContent = '- ' + rcFmt(dcap);
  document.getElementById('rc_total').textContent = rcFmt(total);
  hint.textContent = 'Rumus: (' + rcFmt(fee) + ' / ' + daysInMonth + ' hari) × ' + diffDays + ' hari = ' + rcFmt(prorata);
  document.getElementById('rc_final').value = total;
  document.getElementById('rc_h_prorata').value = prorata;
  document.getElementById('rc_h_install').value = install;
  document.getElementById('rc_h_disc').value = dcap;
}
