  <div class="mb" style="max-width:800px">
    <div class="mh">
      <span class="mt"><i class="bi bi-plug"></i> Daftar User PPPoE Offline</span>
      <button class="mc" onclick="closeModal('offlineUsersModal')">&times;</button>
    </div>
    <div class="mbody" style="max-height:500px;overflow-y:auto">
