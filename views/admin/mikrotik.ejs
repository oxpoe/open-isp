          Total: <span id="all-secrets-total" style="font-weight:700;color:var(--text)">0</span> secrets
        </div>
        <div class="sinput" style="max-width:250px">
          <i class="bi bi-search"></i>
          <input type="text" class="fc" id="all-secrets-search" placeholder="<%= t('admin.common.search_user','Cari username...') %>" onkeyup="filterModalTable('all-secrets-list', this.value)">
