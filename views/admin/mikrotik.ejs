      if (hsUsersRes && hsUsersRes.ok) {
        const users = await hsUsersRes.json();
        allHotspotUsersData = users; // Store for modal
        document.getElementById('total-hotspot-count').innerText = users.length;
      }
      
      if (hsActiveRes && hsActiveRes.ok) {
        const active = await hsActiveRes.json();
        hotspotOnlineData = active; // Store for modal
        document.getElementById('hotspot-online-count').innerText = active.length;
      }
    } catch (err) {
      console.error('Error loading initial hotspot stats:', err);
    }
  }

  // Auto-refresh functionality for real-time data updates
  let autoRefreshInterval = null;
  let isAutoRefreshEnabled = true;
  let isRefreshing = false;
  const REFRESH_INTERVAL = 10000; // 10 seconds

  function showRefreshIndicator() {
    const indicator = document.getElementById('refresh-indicator');
    if (indicator) indicator.style.display = 'flex';
  }

  function hideRefreshIndicator() {
    const indicator = document.getElementById('refresh-indicator');
    if (indicator) indicator.style.display = 'none';
  }

  function toggleAutoRefresh() {
    isAutoRefreshEnabled = !isAutoRefreshEnabled;
    const btn = document.getElementById('auto-refresh-toggle');
    const status = document.getElementById('refresh-status');
    
    if (isAutoRefreshEnabled) {
      btn.style.background = 'rgba(34,197,94,0.2)';
      btn.style.color = '#22c55e';
      btn.style.borderColor = 'rgba(34,197,94,0.3)';
      btn.title = 'Auto-refresh aktif (10 detik)';
      if (status) status.textContent = 'Auto';
      startAutoRefresh();
    } else {
      btn.style.background = 'rgba(239,68,68,0.2)';
      btn.style.color = '#ef4444';
      btn.style.borderColor = 'rgba(239,68,68,0.3)';
      btn.title = 'Auto-refresh nonaktif (klik untuk aktifkan)';
      if (status) status.textContent = 'Manual';
      stopAutoRefresh();
    }
  }

  function startAutoRefresh() {
    if (autoRefreshInterval) clearInterval(autoRefreshInterval);
    
    autoRefreshInterval = setInterval(async () => {
      if (!isAutoRefreshEnabled || isRefreshing) return;
      
      isRefreshing = true;
      showRefreshIndicator();
      
      try {
        // Get active tab and refresh its data
        const activeTab = document.querySelector('.tab.active');
        if (activeTab) {
          const tabText = String(activeTab.textContent || '').toLowerCase();
          
          // Refresh data based on active tab
          if (tabText.includes('pppoe secret')) {
            await loadSecrets();
          } else if (tabText.includes('hotspot user')) {
            await loadHotspotUsers();
          } else if (tabText.includes('pppoe profile')) {
            await loadPppoeProfiles();
          } else if (tabText.includes('hotspot profile')) {
            await loadHotspotUserProfiles();
          }
        }
        
        // Always refresh card summary stats
        await loadInitialStats();
      } catch (err) {
        console.error('Auto-refresh error:', err);
      } finally {
        isRefreshing = false;
        hideRefreshIndicator();
      }
    }, REFRESH_INTERVAL);
  }

  function stopAutoRefresh() {
    if (autoRefreshInterval) {
      clearInterval(autoRefreshInterval);
      autoRefreshInterval = null;
    }
  }

  // Pause auto-refresh when user is interacting with modals
  function pauseAutoRefresh() {
    isAutoRefreshEnabled = false;
  }

  function resumeAutoRefresh() {
    isAutoRefreshEnabled = true;
  }

  // Pause refresh when modal is open
  const originalOpenModal = window.openModal;
  window.openModal = function(id) {
    pauseAutoRefresh();
    if (originalOpenModal) originalOpenModal(id);
  };

  const originalCloseModal = window.closeModal;
  window.closeModal = function(id) {
    resumeAutoRefresh();
    if (originalCloseModal) originalCloseModal(id);
  };

  // Stop auto-refresh when page is hidden (user switched tabs)
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      stopAutoRefresh();
    } else {
      startAutoRefresh();
    }
  });

  // Initial load
  loadSecrets();
  loadInitialStats();
  
  // Start auto-refresh
  startAutoRefresh();
</script>
</body>
</html>
