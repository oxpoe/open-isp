      <div class="tbl-wrap">
        <table class="dtbl">
          <thead>
            <tr>
              <th style="width:50px">#</th>
              <th>Username</th>
              <th>Profile</th>
              <th><%= t('common.status','Status') %></th>
            </tr>
          </thead>
          <tbody id="offline-users-list">
            <tr><td colspan="4" class="text-center text-muted"><%= t('common.loading','Memuat data...') %></td></tr>
          </tbody>
        </table>
      </div>
    </div>
    <div class="mf">
      <button type="button" class="btn btn-g" onclick="closeModal('offlineUsersModal')"><%= t('common.close','Tutup') %></button>
    </div>
  </div>
</div>

<!-- Modal Hotspot Online -->
<div class="mo" id="hotspotOnlineModal">
  <div class="mb" style="max-width:900px">
    <div class="mh">
      <span class="mt"><i class="bi bi-wifi"></i> Daftar Hotspot User Online</span>
      <button class="mc" onclick="closeModal('hotspotOnlineModal')">&times;</button>
    </div>
    <div class="mbody" style="max-height:500px;overflow-y:auto">
