              <th><%= t('admin.common.uptime','Uptime') %></th>
            </tr>
          </thead>
          <tbody id="hotspot-online-list">
            <tr><td colspan="5" class="text-center text-muted"><%= t('common.loading','Memuat data...') %></td></tr>
          </tbody>
        </table>
      </div>
    </div>
    <div class="mf">
      <button type="button" class="btn btn-g" onclick="closeModal('hotspotOnlineModal')"><%= t('common.close','Tutup') %></button>
    </div>
  </div>
</div>

<!-- Modal All Secrets -->
<div class="mo" id="allSecretsModal">
  <div class="mb" style="max-width:900px">
    <div class="mh">
      <span class="mt"><i class="bi bi-people"></i> Semua PPPoE Secrets</span>
      <button class="mc" onclick="closeModal('allSecretsModal')">&times;</button>
    </div>
    <div class="mbody" style="max-height:500px;overflow-y:auto">
      <div style="margin-bottom:15px;display:flex;justify-content:space-between;align-items:center">
