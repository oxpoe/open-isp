          <div style="background: rgba(0,0,0,0.02); padding: 15px; border-radius: 12px; margin-bottom: 15px;">
            <h6 style="font-size:12px; margin-bottom: 10px;">QRIS Statis (Semi-Otomatis)</h6>
            <div class="form-row3">
              <div class="fg">
                <label class="fl"><%= t('admin.set.qris_status','Status QRIS Statis') %></label>
                <select class="fs" name="qris_static_enabled">
                  <option value="true" <%= (settings.qris_static_enabled !== false && settings.qris_static_enabled !== 'false') ? 'selected' : '' %>><%= t('common.active','Aktif') %></option>
                  <option value="false" <%= (settings.qris_static_enabled === false || settings.qris_static_enabled === 'false') ? 'selected' : '' %>><%= t('common.inactive','Nonaktif') %></option>
                </select>
              </div>
              <div class="fg">
                <label class="fl"><%= t('admin.set.qris_url','QRIS Static QR URL') %></label>
                <input class="fc" name="qris_static_qr_url" value="<%= settings.qris_static_qr_url || '' %>" placeholder="https://.../qris.png atau link QRIS">
              </div>
              <div class="fg">
                <label class="fl"><%= t('admin.set.qris_note','Catatan') %></label>
                <input class="fc" value="Portal pelanggan akan menampilkan QRIS + nominal unik (kode bayar)." readonly>
              </div>
            </div>
            <div class="fg" style="margin-top:10px">
              <label class="fl"><%= t('admin.set.qris_payload','QRIS Static Payload (String)') %></label>
              <textarea class="fc" name="qris_static_payload" rows="3" placeholder="000201010211...6304XXXX"><%= settings.qris_static_payload || '' %></textarea>
              <div style="font-size:10px; color:var(--muted); margin-top:4px"><%= t('admin.set.qris_dyn_hint','Jika diisi, sistem akan membuat QRIS dinamis per transaksi (nominal langsung terisi saat scan). Jika kosong, sistem pakai URL gambar seperti biasa.') %></div>
            </div>
            <div style="margin-top:10px">
              <div style="display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap">
                <div class="fg" style="min-width:260px; flex: 1 1 260px">
                  <label class="fl"><%= t('admin.set.qris_upload','Upload Gambar QRIS (opsional)') %></label>
                  <input class="fc" type="file" id="qris_upload_file" name="qris_file" accept="image/png,image/jpeg,image/jpg,image/webp">
                  <div style="font-size:10px; color:var(--muted); margin-top:4px"><%= t('admin.set.qris_upload_hint','Jika di-upload, sistem akan menyimpan file dan otomatis mengisi URL QRIS.') %></div>
                </div>
                <button class="btn btn-s" type="button" id="qris_upload_btn" style="height:38px"><i class="bi bi-upload"></i> Upload</button>
              </div>
            </div>
            <script src="https://unpkg.com/jsqr@1.4.0/dist/jsQR.js"></script>
            <script>
              (function () {
                const fileInput = document.getElementById('qris_upload_file');
                const btn = document.getElementById('qris_upload_btn');
                if (!fileInput || !btn) return;

                const normalizePayload = (raw) => {
                  let s = String(raw || '').replace(/[\r\n\t]+/g, '').trim();
                  const idx = s.indexOf('000201');
                  if (idx > 0) s = s.slice(idx);
                  const lastCrc = s.lastIndexOf('6304');
                  if (lastCrc >= 0 && s.length >= lastCrc + 8) s = s.slice(0, lastCrc + 8);
                  return s;
                };

                const decodeQrPayloadInBrowser = async (file) => {
                  try {
                    if (!window.jsQR) return '';
                    const url = URL.createObjectURL(file);
                    const img = new Image();
                    img.decoding = 'async';
                    img.src = url;
                    await new Promise((resolve, reject) => {
                      img.onload = () => resolve();
                      img.onerror = () => reject(new Error('Gagal membaca gambar'));
                    });
                    const canvas = document.createElement('canvas');
                    const ctx = canvas.getContext('2d', { willReadFrequently: true });
                    if (!ctx) return '';
                    canvas.width = img.naturalWidth || img.width || 0;
                    canvas.height = img.naturalHeight || img.height || 0;
                    if (!canvas.width || !canvas.height) return '';
                    ctx.drawImage(img, 0, 0);
                    const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
                    const res = window.jsQR(imageData.data, canvas.width, canvas.height, { inversionAttempts: 'attemptBoth' });
                    URL.revokeObjectURL(url);
                    if (!res || !res.data) return '';
                    const s = normalizePayload(res.data);
                    return s.startsWith('000201') ? s : '';
                  } catch {
                    return '';
                  }
                };

                btn.addEventListener('click', async () => {
                  const f = fileInput.files && fileInput.files[0] ? fileInput.files[0] : null;
                  if (!f) return;
                  const fd = new FormData();
                  fd.append('qris_file', f);
                  const payload = await decodeQrPayloadInBrowser(f);
                  if (payload) fd.append('qris_payload', payload);
                  btn.disabled = true;
                  try {
                    const r = await fetch('/admin/settings/qris-upload', { method: 'POST', body: fd, credentials: 'same-origin' });
                    if (!r.ok) throw new Error('Upload gagal');
                    window.location.href = '/admin/settings';
                  } catch (e) {
                    window.location.href = '/admin/settings';
                  } finally {
                    btn.disabled = false;
                  }
                });
              })();
            </script>
            <% if (settings.qris_static_qr_url) { %>
              <div style="margin-top:10px; display:flex; gap:12px; align-items:center; flex-wrap:wrap">
                <div style="font-size:10px; color:var(--muted)">Preview:</div>
                <img src="<%= settings.qris_static_qr_url %>" alt="QRIS" style="height:72px; width:72px; object-fit:contain; background:#fff; border-radius:12px; padding:8px; border:1px solid rgba(0,0,0,0.08)">
                <div style="font-size:10px; color:var(--muted)">Gunakan tombol <span style="font-weight:700">QR</span> di menu Billing untuk membuat nominal unik per invoice.</div>
              </div>
            <% } %>

            <!-- Transfer Bank & E-Wallet Manual (Mode 2) -->
            <div style="margin-top: 15px; border-top: 1px dashed rgba(0,0,0,0.1); padding-top: 15px;">
              <h6 style="font-size:12px; margin-bottom: 10px;"><i class="bi bi-bank"></i> Transfer Bank &amp; E-Wallet (Manual, Mode 2)</h6>
              <div class="form-row3">
                <div class="fg">
                  <label class="fl"><%= t('admin.set.bank_status','Status Transfer Bank') %></label>
                  <select class="fs" name="payment_bank_enabled">
                    <option value="true" <%= (settings.payment_bank_enabled !== false && settings.payment_bank_enabled !== 'false') ? 'selected' : '' %>><%= t('common.active','Aktif') %></option>
                    <option value="false" <%= (settings.payment_bank_enabled === false || settings.payment_bank_enabled === 'false') ? 'selected' : '' %>><%= t('common.inactive','Nonaktif') %></option>
                  </select>
                </div>
                <div class="fg">
                  <label class="fl"><%= t('admin.set.ewallet_status','Status E-Wallet') %></label>
                  <select class="fs" name="payment_ewallet_enabled">
                    <option value="true" <%= (settings.payment_ewallet_enabled !== false && settings.payment_ewallet_enabled !== 'false') ? 'selected' : '' %>><%= t('common.active','Aktif') %></option>
                    <option value="false" <%= (settings.payment_ewallet_enabled === false || settings.payment_ewallet_enabled === 'false') ? 'selected' : '' %>><%= t('common.inactive','Nonaktif') %></option>
                  </select>
                </div>
              </div>
              <div class="fg" style="margin-top:10px">
                <label class="fl"><%= t('admin.set.bank_list','Rekening Bank (1 per baris: Bank|Nomor|Atas Nama)') %></label>
                <textarea class="fc" name="payment_bank_accounts" rows="3" placeholder="BCA|1234567890|PT Artha Mega Data"><%= settings.payment_bank_accounts || '' %></textarea>
              </div>
              <div class="fg" style="margin-top:10px">
                <label class="fl"><%= t('admin.set.ewallet_list','E-Wallet (1 per baris: Nama|Nomor|Atas Nama)') %></label>
                <textarea class="fc" name="payment_ewallet_accounts" rows="3" placeholder="DANA|08123456789|Admin OPEN-ISP"><%= settings.payment_ewallet_accounts || '' %></textarea>
              </div>
              <div style="font-size:10px; color:var(--muted); margin-top:4px"><%- t('admin.set.bank_hint','Nominal &amp; kode unik sama seperti QRIS; verifikasi otomatis (webhook forwarder) + manual (upload bukti).') %></div>
            </div>

            <!-- Hubungkan Webhook Notifikasi E-Wallet (Mode 2) -->
            <div style="margin-top: 15px; border-top: 1px dashed rgba(0,0,0,0.1); padding-top: 15px;">
              <h6 style="font-size:11px; margin-bottom: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px;"><i class="bi bi-phone"></i> Hubungkan Webhook Notifikasi E-Wallet (Mode 2)</h6>
              <% 
                const _base = (settings.public_base_url || '').replace(/\/+$/, '');
                const _secret = String(settings.webhook_secret || '');
                const macroWebhookUrlFull = _base + '/api/webhook/v1/payment-notif?secret_key=' + encodeURIComponent(_secret);
              %>
              <div class="fg">
                <label class="fl"><%= t('admin.set.wh_url','1) URL Webhook (method POST)') %></label>
                <div style="display:flex;gap:8px">
                  <input class="fc" id="macro_webhook_url" readonly value="<%= macroWebhookUrlFull %>">
                  <button type="button" class="btn btn-g" onclick="copyInput('macro_webhook_url', 'URL Webhook')"><i class="bi bi-copy"></i></button>
                </div>
              </div>
              <div class="fg" style="margin-top:8px">
                <label class="fl"><%- t('admin.set.wh_secret','2) Secret Token (alternatif header <span class="mono">X-Webhook-Token</span>)') %></label>
                <div style="display:flex;gap:8px">
                  <input class="fc mono" type="password" id="macro_webhook_secret" readonly value="<%= _secret %>">
                  <button type="button" class="btn btn-g" onclick="toggleSecret('macro_webhook_secret')" title="Lihat/Sembunyikan"><i class="bi bi-eye"></i></button>
                  <button type="button" class="btn btn-g" onclick="copyInput('macro_webhook_secret', 'Secret Token')"><i class="bi bi-copy"></i></button>
                </div>
              </div>
              <div class="fg" style="margin-top:10px">
                <label class="fl"><i class="bi bi-bell"></i> <%= t('admin.set.wh_wa_notif','Notifikasi WA saat Pembayaran Belum Cocok') %></label>
                <select class="fs" name="webhook_unmatched_notify_enabled">
                  <option value="true" <%= (settings.webhook_unmatched_notify_enabled === undefined ? true : settings.webhook_unmatched_notify_enabled) ? 'selected' : '' %>><%= t('common.active','Aktif') %></option>
                  <option value="false" <%= (settings.webhook_unmatched_notify_enabled === undefined ? true : settings.webhook_unmatched_notify_enabled) ? '' : 'selected' %>><%= t('common.inactive','Nonaktif') %></option>
                </select>
                <div class="hint"><%= t('admin.set.wh_wa_hint','Kirim WA ke admin tiap ada pembayaran terdeteksi tapi belum cocok (untuk dicocokkan manual via jam notif vs bukti transfer).') %></div>
              </div>
              <div class="fg" style="margin-top:10px">
                <label class="fl"><i class="bi bi-clock-history"></i> <%= t('admin.set.wh_retention','Retensi Notifikasi Webhook (Otomasi)') %></label>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
                  <select class="fs" name="webhook_notif_retention_enabled">
                    <option value="1" <%= (String(settings.webhook_notif_retention_enabled) === '0' || String(settings.webhook_notif_retention_enabled) === 'false') ? '' : 'selected' %>><%= t('common.active','Aktif') %></option>
                    <option value="0" <%= (String(settings.webhook_notif_retention_enabled) === '0' || String(settings.webhook_notif_retention_enabled) === 'false') ? 'selected' : '' %>><%= t('common.inactive','Nonaktif') %></option>
                  </select>
                  <input class="fc" type="number" min="1" max="3650" name="webhook_notif_retention_days" value="<%= (settings.webhook_notif_retention_days || 30) %>" placeholder="30">
                </div>
                <div class="hint"><%= t('admin.set.wh_retention_hint','Notif webhook yang lebih tua dari jumlah hari ini dihapus otomatis tiap hari (04:45). Default 30 hari.') %></div>
              </div>
              <div style="background:rgba(148,163,184,0.12);border:1px solid var(--border);border-radius:10px;padding:10px;margin-top:10px;font-size:12px;line-height:1.55">
                <b><i class="bi bi-info-circle"></i> <%= t('admin.set.wh_howto','Cara memasang di app (mis. android-notification-forwarder / MacroDroid):') %></b>
                <ol style="margin:6px 0 0 18px;padding:0">
                  <li><%- t('admin.set.wh_li1','Method <span class="mono">POST</span>, Content-Type <span class="mono">application/json</span>.') %></li>
                  <li><%- t('admin.set.wh_li2','<b>API URL</b> = URL di atas (secret sudah termasuk), <i>atau</i> URL dasar + header <span class="mono">X-Webhook-Token: &lt;token&gt;</span>.') %></li>
                  <li><%- t('admin.set.wh_li3','<b>Target Apps</b> = package aplikasi bank/e-wallet (mis. <span class="mono">com.gojek.gopay</span>, OVO, DANA, Jenius).') %></li>
                  <li><%= t('admin.set.wh_li4','Notifikasi WhatsApp/Telegram otomatis ditolak agar chat tak dianggap pembayaran.') %></li>
                  <li><%- t('admin.set.wh_li5','Nominal di notifikasi harus <b>sama dengan nominal unik tagihan</b> (jumlah + kode unik QRIS).') %></li>
                </ol>
              </div>
              <div style="margin-top:10px;display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                <button type="button" class="btn btn-p btn-sm" onclick="testWebhook()"><i class="bi bi-send-check"></i> <%= t('admin.set.wh_test','Tes Webhook') %></button>
                <span id="webhookTestResult" class="muted" style="font-size:12px"></span>
              </div>
            </div>
          </div>

          <!-- Payment Mode & Mayar -->
          <div style="grid-column:1/-1;border:1px solid var(--border);border-radius:12px;padding:14px;margin-bottom:14px">
            <h6 style="font-size:12px;margin-bottom:10px"><i class="bi bi-credit-card-2-front"></i> Mode Pembayaran</h6>
            <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px">
              <div>
                <label class="fl"><%= t('admin.set.pay_mode','Mode') %></label>
                <select class="fs" name="payment_mode">
                  <option value="selfservice" <%= (settings.payment_mode || 'selfservice') === 'selfservice' ? 'selected' : '' %>><%= t('admin.set.pay_on_self','Self-Service (QRIS statis + manual/MacroDroid)') %></option>
                  <option value="gateway" <%= settings.payment_mode === 'gateway' ? 'selected' : '' %>><%= t('admin.set.pay_on_gateway','Gateway (Mayar)') %></option>
                </select>
                <div class="hint"><%= t('admin.set.pay_mode_hint','Mode 1 = Gateway (hanya Mayar). Mode 2 = QRIS statis + verifikasi manual.') %></div>
              </div>
              <div>
                <label class="fl"><%= t('admin.set.mayar_key','Mayar API Key') %></label>
                <input class="fc" type="password" name="mayar_api_key" value="<%= settings.mayar_api_key || '' %>" placeholder="API key Mayar (Bearer)">
                <div class="hint">Webhook Mayar: <span class="mono">https://&lt;domain-anda&gt;/api/webhook/mayar</span></div>
              </div>
            </div>
          </div>

          <div class="fg" style="margin-top: 15px;">
            <label class="fl"><%= t('admin.set.mayar_webhook','Webhook Mayar (Mode 1 — Gateway)') %></label>
            <div style="display:flex;gap:8px">
              <input class="fc" id="mayar_webhook_url" readonly value="<%= ((settings.public_base_url || '').replace(/\/+$/, '')) %>/api/webhook/mayar">
              <button type="button" class="btn btn-g" onclick="copyInput('mayar_webhook_url', 'Webhook Mayar')"><i class="bi bi-copy"></i></button>
            </div>
            <div style="font-size: 10px; color: var(--muted); margin-top: 4px;">Tempel di dashboard Mayar sebagai URL webhook (event <span class="mono">payment.received</span>).</div>
          </div>
        </div>

      </div>
      
          <div class="card-bd" style="border-top:1px solid var(--border);padding-top:20px;text-align:right">
            <button type="submit" class="btn btn-p"><i class="bi bi-save"></i> <%= t('admin.set.save','Simpan Pengaturan') %></button>
          </div>
        </div>
    </form>
    <% } %>
  </div>
</div>

<script>
function copyInput(id, name) {
  const el = document.getElementById(id);
  if (el) {
    el.select();
    document.execCommand('copy');
    alert(name + ' berhasil disalin!');
  }
}
function toggleSecret(id) {
  const i = document.getElementById(id);
  if (!i) return;
  i.type = (i.type === 'password') ? 'text' : 'password';
}
async function testWebhook() {
  const out = document.getElementById('webhookTestResult');
  const secEl = document.getElementById('macro_webhook_secret');
  if (out) { out.textContent = 'Menguji…'; out.style.color = 'var(--muted)'; }
  try {
    const secret = secEl ? secEl.value : '';
    const res = await fetch('/api/webhook/v1/payment-notif', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Webhook-Token': secret },
      body: JSON.stringify({ app_name: 'TEST', notification_title: 'Tes', notification_text: 'Kamu menerima Rp999.999.999 (tes webhook)', timestamp_ms: Date.now() })
    });
    const j = await res.json().catch(function () { return {}; });
    if (out) {
      if (j && j.status === 'processed') { out.textContent = 'Webhook OK — ' + JSON.stringify(j); out.style.color = 'var(--success)'; }
      else { out.textContent = 'Webhook gagal — ' + JSON.stringify(j); out.style.color = 'var(--danger)'; }
    }
  } catch (e) {
    if (out) { out.textContent = 'Gagal — ' + e.message; out.style.color = 'var(--danger)'; }
  }
}
window.regenPwaIcons = function (btn) {
  if (!confirm('Buat ulang ikon PWA (192/512/maskable/apple) dari logo saat ini?')) return;
  var old = btn.innerHTML; btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Memproses...';
  fetch('/admin/settings/regenerate-icons', { method: 'POST' })
    .then(function (r) { return r.json().catch(function () { return {}; }); })
    .then(function (d) { alert((d && d.message) || 'Selesai'); })
    .catch(function (e) { alert('Gagal: ' + e.message); })
    .finally(function () { btn.disabled = false; btn.innerHTML = old; });
};

window.runAutoDeactivate = function () {
  if (!confirm('Jalankan auto-nonaktif sekarang? Pelanggan yang menunggak sesuai batas akan diisolir.')) return;
  fetch('/admin/customers/auto-deactivate-now', { method: 'POST' })
    .then(function (r) { return r.json(); })
    .then(function (d) { alert(d.message || 'Selesai'); if (d.processed > 0) location.reload(); })
    .catch(function () { alert('Gagal menjalankan auto-nonaktif'); });
};

function copyWebhook() {
  const el = document.getElementById('webhook_url');
  el.select();
  document.execCommand('copy');
  alert('Link Webhook berhasil disalin!');
}
async function syncTelegram() {
  try {
    const res = await fetch('/admin/api/telegram/sync', { method: 'POST' });
    const data = await res.json();
    if (data.success) alert(data.message);
    else alert('Gagal: ' + data.error);
  } catch (e) { alert('Error: ' + e.message); }
}

function escHtml(s) {
  return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

// Admin TIDAK memakai Service Worker (SW hanya untuk portal pelanggan, scope /customer/).
// Bersihkan registrasi SW lama yang scope-nya bukan /customer/.
if ('serviceWorker' in navigator) {
  navigator.serviceWorker.getRegistrations().then((regs) => {
    regs.forEach((r) => { if (!r.scope.includes('/customer/')) r.unregister().catch(() => {}); });
  }).catch(() => {});
}

async function copyText(text) {
  const v = String(text ?? '');
  try {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      await navigator.clipboard.writeText(v);
      return true;
    }
  } catch {}
  try {
    const ta = document.createElement('textarea');
    ta.value = v;
    ta.style.position = 'fixed';
    ta.style.left = '-9999px';
    ta.style.top = '0';
    document.body.appendChild(ta);
    ta.focus();
    ta.select();
    const ok = document.execCommand('copy');
    ta.remove();
    return ok;
  } catch {
    return false;
  }
}

function canNotify() {
  return typeof Notification !== 'undefined';
}

function notifEnabled() {
  return localStorage.getItem('ew_notif_enabled') === '1';
}

function setNotifEnabled(v) {
  localStorage.setItem('ew_notif_enabled', v ? '1' : '0');
}

function updateNotifHint() {
  const el = document.getElementById('ew_notif_hint');
  if (!el) return;
  const perm = canNotify() ? Notification.permission : 'unsupported';
  const enabled = notifEnabled();
  let msg = '';
  if (perm === 'unsupported') msg = 'Notifikasi browser tidak didukung di device ini.';
  else if (perm === 'denied') msg = 'Notifikasi diblokir. Izinkan di pengaturan browser.';
  else if (perm === 'granted') msg = enabled ? 'Notif aktif. Notifikasi muncul saat ada log baru (mode Live).' : 'Notif siap, tapi masih nonaktif.';
  else msg = 'Klik "Aktifkan Notif" untuk minta izin notifikasi.';
  el.textContent = msg;
}

async function enableEwalletNotif() {
  if (!canNotify()) return updateNotifHint();
  try {
    const perm = await Notification.requestPermission();
    if (perm === 'granted') {
      setNotifEnabled(true);
      updateNotifHint();
      try { new Notification('E-Wallet Monitor', { body: 'Notifikasi aktif.' }); } catch {}
      return;
    }
    setNotifEnabled(false);
    updateNotifHint();
  } catch {
    setNotifEnabled(false);
    updateNotifHint();
  }
}

let ewLastId = Number(localStorage.getItem('ew_last_id') || 0);
let ewLiveTimer = null;
let ewLiveActive = false;

function showEwalletNotification(row) {
  if (!notifEnabled()) return;
  if (!canNotify() || Notification.permission !== 'granted') return;
  const svc = String(row?.service || 'E-Wallet');
  const amt = row?.parsed_ok ? `Rp ${(Number(row.parsed_amount) || 0).toLocaleString('id-ID')}` : 'Nominal tidak terdeteksi';
  const body = String(row?.content || '').replace(/\r?\n/g, ' ').slice(0, 140);
  try {
    new Notification(`${svc}: ${amt}`, { body });
  } catch {}
}

function toggleEwalletLive() {
  ewLiveActive = !ewLiveActive;
  const btn = document.getElementById('ew_live_btn');
  if (btn) {
    btn.className = ewLiveActive ? 'btn btn-d btn-sm' : 'btn btn-p btn-sm';
    btn.innerHTML = ewLiveActive ? '<i class="bi bi-stop-circle"></i> Stop' : '<i class="bi bi-broadcast"></i> Live';
  }
  if (ewLiveTimer) {
    clearInterval(ewLiveTimer);
    ewLiveTimer = null;
  }
  if (ewLiveActive) {
    loadEwalletLogs(true);
    ewLiveTimer = setInterval(() => loadEwalletLogs(true), 5000);
  }
}

function ewTab(t){
  var log = document.getElementById('ew-tab-log'), rek = document.getElementById('ew-tab-rekap');
  if (!log || !rek) return;
  log.style.display = (t === 'log') ? '' : 'none';
  rek.style.display = (t === 'rekap') ? '' : 'none';
  var bl = document.getElementById('ewtab-log'), br = document.getElementById('ewtab-rekap');
  if (bl && br) { bl.className = 'btn btn-sm ' + (t === 'log' ? 'btn-p' : 'btn-g'); br.className = 'btn btn-sm ' + (t === 'rekap' ? 'btn-p' : 'btn-g'); }
}
async function loadEwalletLogs() {
  const body = document.getElementById('ew_logs_body');
  const service = document.getElementById('ew_service')?.value || '';
  const q = document.getElementById('ew_q')?.value || '';
  const limit = document.getElementById('ew_limit')?.value || '200';
  if (!body) return;
  body.innerHTML = '<tr><td colspan="7" class="text-center text-muted"><%= t('common.loading_short','Memuat...') %></td></tr>';
  try {
    const url = `/admin/api/webhook/payment-notif/logs?limit=${encodeURIComponent(limit)}&service=${encodeURIComponent(service)}&q=${encodeURIComponent(q)}`;
    const res = await fetch(url);
    const data = await res.json();
    if (!res.ok || !data.ok) throw new Error(data.error || 'Gagal memuat log');
    const rows = Array.isArray(data.rows) ? data.rows : [];
    if (rows.length === 0) {
      body.innerHTML = '<tr><td colspan="7" class="text-center text-muted"><%= t('admin.set.no_data','Belum ada data.') %></td></tr>';
      return;
    }
    const newest = rows[0];
    const newestId = Number(newest?.id || 0);
    if (newestId && ewLastId === 0) {
      ewLastId = newestId;
      localStorage.setItem('ew_last_id', String(ewLastId));
    } else if (newestId && newestId > ewLastId) {
      ewLastId = newestId;
      localStorage.setItem('ew_last_id', String(ewLastId));
      showEwalletNotification(newest);
    }

    body.innerHTML = rows.map(r => {
      const parsed = Number(r.parsed_ok || 0) ? true : false;
      const amountNum = (r.parsed_amount != null && r.parsed_amount !== '') ? Number(r.parsed_amount) : null;
      const created = r.created_at ? escHtml(r.created_at) : '-';
      const svc = escHtml(r.service || '');
      const content = escHtml((r.content || '').replace(/\r?\n/g, ' '));
      const mi = Number(r.matched_invoice_id || 0) || 0;
      const mv = Number(r.matched_voucher_order_id || 0) || 0;
      const md = Number(r.matched_donation_order_id || 0) || 0;
      const isMatched = !!(mi || mv || md);
      let statusBadge;
      if (!parsed) statusBadge = '<span class="ew-badge ew-gray"><%= t('admin.set.ew_not_tx','Bukan transaksi') %></span>';
      else if (isMatched) statusBadge = '<span class="ew-badge ew-green"><%= t('admin.set.ew_paid','Lunas') %></span>';
      else statusBadge = '<span class="ew-badge ew-amber"><%= t('admin.set.ew_unmatched','Belum cocok') %></span>';
      const amountHtml = (amountNum == null)
        ? '<span class="muted">—</span>'
        : ('<span class="mono" style="font-weight:800;' + (parsed ? 'color:var(--primary)' : 'color:var(--muted)') + '">Rp ' + amountNum.toLocaleString('id-ID') + '</span>');
      const matchHtml = mi
        ? ('<a class="mono" href="/admin/billing?search=' + mi + '" target="_blank" style="font-weight:800">INV#' + mi + '</a>')
        : (mv ? ('<span class="mono" style="font-weight:800">Voucher#' + mv + '</span>')
              : (md ? ('<span class="mono" style="font-weight:800">Donasi#' + md + '</span>') : '<span class="muted">—</span>'));
      const rawEnc = encodeURIComponent(String(r.content || ''));
      const rawShortEnc = encodeURIComponent(String(r.content || '').replace(/\r?\n/g, ' ').slice(0, 180));
      const rowStyle = (parsed && !isMatched) ? 'background:rgba(245,158,11,.05)' : '';
      return '<tr style="' + rowStyle + '">' +
        '<td class="mono" style="white-space:nowrap">' + created + '</td>' +
        '<td>' + (svc ? ('<span class="ew-svc">' + svc + '</span>') : '<span class="muted">—</span>') + '</td>' +
        '<td>' + amountHtml + '</td>' +
        '<td>' + statusBadge + '</td>' +
        '<td>' + matchHtml + '</td>' +
        '<td style="max-width:620px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis" title="' + content + '">' + content + '</td>' +
        '<td><button type="button" class="btn btn-g btn-sm btn-copy-ew" data-raw="' + rawEnc + '" data-short="' + rawShortEnc + '" title="Salin isi"><i class="bi bi-copy"></i></button></td>' +
      '</tr>';
    }).join('');

    body.querySelectorAll('.btn-copy-ew').forEach(btn => {
      btn.addEventListener('click', async () => {
        const rawEnc = btn.getAttribute('data-raw') || '';
        const rawShortEnc = btn.getAttribute('data-short') || '';
        const decoded = decodeURIComponent(rawEnc);
        const shortText = rawShortEnc ? decodeURIComponent(rawShortEnc) : 'Tersalin.';
        const ok = await copyText(decoded);
        if (ok) {
          alert(`Tersalin:\n${shortText}`);
        } else {
          alert('Gagal menyalin.');
        }
      });
    });
  } catch (e) {
    body.innerHTML = `<tr><td colspan="7" class="text-center text-muted">${escHtml(e.message)}</td></tr>`;
  }
}

async function clearEwalletLogs() {
  if (!confirm('Hapus semua log e-wallet?')) return;
  try {
    const res = await fetch('/admin/api/webhook/payment-notif/clear', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' });
    const data = await res.json();
    if (!res.ok || !data.ok) throw new Error(data.error || 'Gagal menghapus log');
    await loadEwalletLogs();
  } catch (e) {
    alert(e.message);
  }
}

// Branding: upload logo (portal / invoice / pwa)
async function uploadBrandLogo(type, btn) {
  const map = { portal: 'brand_portal_file', invoice: 'brand_invoice_file', pwa: 'brand_pwa_file', hero: 'brand_hero_file' };
  const input = document.getElementById(map[type]);
  const f = input && input.files && input.files[0] ? input.files[0] : null;
  if (!f) { alert('Pilih file logo terlebih dahulu'); return; }
  const fd = new FormData();
  fd.append('logo_file', f);
  const old = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Upload...';
  try {
    const r = await fetch('/admin/settings/branding/logo/' + type, { method: 'POST', body: fd, credentials: 'same-origin' });
    if (!r.ok) throw new Error('Upload logo gagal');
    window.location.href = '/admin/settings';
  } catch (e) {
    alert(e.message);
    btn.disabled = false;
    btn.innerHTML = old;
  }
}

setTimeout(loadEwalletLogs, 200);
setTimeout(updateNotifHint, 250);
setTimeout(()=>document.querySelectorAll('.alert').forEach(a=>a.style.display='none'),5000);

// ── Pengaturan: tab kategori + pencarian ──
var _setCat = 'umum';
function setSetTab(cat) {
  _setCat = cat;
  document.querySelectorAll('[data-setcat]').forEach(function (el) { el.style.display = (el.getAttribute('data-setcat') === cat) ? '' : 'none'; });
  document.querySelectorAll('.set-tab').forEach(function (b) { b.classList.toggle('active', b.getAttribute('data-cat') === cat); });
  var s = document.getElementById('setSearch'); if (s) s.value = '';
  var clr = document.getElementById('setSearchClear'); if (clr) clr.style.display = 'none';
  document.querySelectorAll('.fg, .form-row, .form-row2, .form-row3').forEach(function (r) { r.style.display = ''; });
  try { localStorage.setItem('setCat', cat); } catch (e) {}
}
function setSearch(q) {
  q = (q || '').trim().toLowerCase();
  var clr = document.getElementById('setSearchClear'); if (clr) clr.style.display = q ? '' : 'none';
  var blocks = document.querySelectorAll('[data-setcat]');
  if (!q) { setSetTab(_setCat); return; }
  blocks.forEach(function (el) { el.style.display = ''; });
  document.querySelectorAll('.set-tab').forEach(function (b) { b.classList.remove('active'); });
  document.querySelectorAll('.fg, .form-row, .form-row2, .form-row3').forEach(function (r) {
    r.style.display = ((r.textContent || '').toLowerCase().indexOf(q) !== -1) ? '' : 'none';
  });
  blocks.forEach(function (el) {
    var any = Array.prototype.some.call(el.querySelectorAll('.fg, .form-row, .form-row2, .form-row3'), function (r) { return r.style.display !== 'none'; });
    el.style.display = any ? '' : 'none';
  });
}
(function initSetTabs() {
  try { var saved = localStorage.getItem('setCat'); if (saved) _setCat = saved; } catch (e) {}
  setSetTab(_setCat);
  // wiring eksplisit (lebih andal dari atribut inline)
  var si = document.getElementById('setSearch');
  if (si) si.addEventListener('input', function () { setSearch(this.value); });
  var clr = document.getElementById('setSearchClear');
  if (clr) clr.addEventListener('click', function () { var el = document.getElementById('setSearch'); if (el) el.value = ''; setSearch(''); });
  document.querySelectorAll('.set-tab').forEach(function (b) { b.addEventListener('click', function () { setSetTab(this.getAttribute('data-cat')); }); });
})();
</script>
