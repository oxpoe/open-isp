<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= ((typeof viewMode !== 'undefined' && viewMode === 'ewallet_logs') ? 'Log & Rekap' : t('admin.settings.title', 'Pengaturan')) %> | <%= company %></title>
  <meta name="theme-color" content="#0A0D14">
  <link rel="manifest" href="/admin/manifest.webmanifest">
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    .set-toolbar{display:flex;gap:12px;flex-wrap:wrap;align-items:center;justify-content:space-between;background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:10px;margin-bottom:16px}
    .set-tabs{display:flex;gap:6px;flex-wrap:wrap}
    .set-tab{display:inline-flex;align-items:center;gap:7px;padding:8px 13px;border-radius:9px;border:1px solid var(--border);background:transparent;color:var(--muted);font-weight:600;font-size:12.5px;cursor:pointer;transition:.15s;font-family:inherit}
    .set-tab:hover{color:var(--text);border-color:var(--primary)}
    .set-tab.active{background:var(--primary);color:#0A0D14;border-color:var(--primary)}
    .set-search{position:relative;display:flex;align-items:center;flex:1;min-width:220px;max-width:440px}
    .set-search>i{position:absolute;left:11px;color:var(--muted);font-size:13px;pointer-events:none}
    .set-search input{width:100%;padding:9px 34px 9px 32px;border-radius:9px;border:1px solid var(--border);background:var(--bg3);color:var(--text);font-size:13px;outline:none;font-family:inherit}
    .set-search input:focus{border-color:var(--primary)}
    .set-search .clr{position:absolute;right:7px;border:none;background:transparent;color:var(--muted);cursor:pointer;padding:4px}
    [data-setcat]{grid-column:1 / -1}
    @media(max-width:768px){.set-toolbar{padding:8px}.set-search{max-width:none}}
  </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: (typeof activePage !== 'undefined' && activePage ? activePage : 'settings'), company }) %>
<div class="mw">
  <div class="topbar">
    <div class="tb-title"><button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button><i class="bi bi-gear"></i> <%= t('admin.settings.system_title', 'Pengaturan Sistem') %></div>
    <div class="tb-right">
      <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= (typeof session !== 'undefined' && session && session.isCashier) ? t('admin.role.cashier', 'Kasir') : t('admin.role.admin', 'Admin') %></span>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i> <%= t('common.logout', 'Logout') %></a>
    </div>
  </div>
  <div class="page">

    <% if (msg) { %>
    <div class="alert alert-<%= msg.type==='success'?'s':'d' %>" data-flash="1">
      <i class="bi bi-<%= msg.type==='success'?'check-circle':'exclamation-circle' %>"></i> <%= msg.text %>
    </div>
    <% } %>

    <% const logsOnly = (typeof viewMode !== 'undefined' && viewMode === 'ewallet_logs'); %>

    <style>
      .ew-badge{display:inline-block;border-radius:999px;padding:2px 10px;font-size:11px;font-weight:800;white-space:nowrap}
      .ew-green{background:rgba(34,197,94,.16);color:#22c55e}
      .ew-amber{background:rgba(245,158,11,.18);color:#f59e0b}
      .ew-gray{background:rgba(148,163,184,.16);color:#94a3b8}
      .ew-svc{background:rgba(173,255,47,.12);color:#ADFF2F;border-radius:6px;padding:1px 8px;font-size:11.5px;font-weight:700}
      .ew-log td{vertical-align:middle}
      .ew-log tbody tr:hover{background:rgba(173,255,47,.04)}
    </style>
    <% if (logsOnly) { %>
    <div style="display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap">
      <button type="button" class="btn btn-p btn-sm" id="ewtab-log" onclick="ewTab('log')"><i class="bi bi-broadcast"></i> <%= t('admin.set.ew_log_realtime','Log Realtime') %></button>
      <button type="button" class="btn btn-g btn-sm" id="ewtab-rekap" onclick="ewTab('rekap')"><i class="bi bi-check2-circle"></i> <%= t('admin.set.ew_rekap','Rekap Auto-Lunas') %></button>
    </div>
    <div id="ew-tab-log">
    <div class="card mb16">
      <div class="card-hd" style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">
        <h6 style="margin:0"><i class="bi bi-broadcast"></i> Log Notifikasi E-Wallet (Realtime)</h6>
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
          <a class="btn btn-g btn-sm" href="/admin/settings"><i class="bi bi-arrow-left"></i> <%= t('common.back', 'Kembali') %></a>
          <button type="button" class="btn btn-g btn-sm" onclick="enableEwalletNotif()"><i class="bi bi-bell"></i> <%= t('admin.settings.ewallet_logs.enable_notif', 'Aktifkan Notif') %></button>
          <button type="button" class="btn btn-p btn-sm" onclick="toggleEwalletLive()" id="ew_live_btn"><i class="bi bi-broadcast"></i> <%= t('admin.settings.ewallet_logs.live', 'Live') %></button>
          <button type="button" class="btn btn-g btn-sm" onclick="loadEwalletLogs()"><i class="bi bi-arrow-clockwise"></i> <%= t('common.refresh', 'Refresh') %></button>
          <button type="button" class="btn btn-d btn-sm" onclick="clearEwalletLogs()"><i class="bi bi-trash"></i> <%= t('common.clear', 'Clear') %></button>
        </div>
      </div>
      <div class="card-bd">
        <div class="form-row" style="align-items:flex-end">
          <div class="fg">
            <label class="fl"><%= t('admin.settings.ewallet_logs.service', 'Service') %></label>
            <input class="fc" id="ew_service" placeholder="<%= t('admin.set.ph_ew_service','DANA / Gojek / ShopeePay (opsional)') %>">
          </div>
          <div class="fg" style="flex:2">
            <label class="fl"><%= t('admin.settings.ewallet_logs.search', 'Cari') %></label>
            <input class="fc" id="ew_q" placeholder="<%= t('admin.set.ph_ew_keyword','kata kunci (opsional)') %>">
          </div>
          <div class="fg w160">
            <label class="fl"><%= t('admin.settings.ewallet_logs.limit', 'Limit') %></label>
            <select class="fs" id="ew_limit">
              <option value="50">50</option>
              <option value="100">100</option>
              <option value="200" selected>200</option>
              <option value="500">500</option>
            </select>
          </div>
        </div>
        <div class="hint" style="margin-top:6px">
          <%= t('admin.set.ew_endpoint','Endpoint MacroDroid:') %> <span class="mono">POST /api/webhook/v1/payment-notif</span>
        </div>
        <div class="hint" style="margin-top:6px" id="ew_notif_hint"></div>
        <div class="tbl-wrap" style="margin-top:10px;max-height:420px;overflow:auto">
          <table class="dtbl ew-log">
            <thead>
              <tr>
                <th style="width:150px"><%= t('common.time', 'Waktu') %></th>
                <th style="width:120px">Sumber</th>
                <th style="width:130px"><%= t('admin.settings.ewallet_logs.amount', 'Nominal') %></th>
                <th style="width:120px"><%= t('common.status','Status') %></th>
                <th style="width:100px">Cocok ke</th>
                <th><%= t('admin.settings.ewallet_logs.content', 'Isi Notifikasi') %></th>
                <th style="width:60px"></th>
              </tr>
            </thead>
            <tbody id="ew_logs_body">
              <tr><td colspan="7" class="text-center text-muted"><%= t('common.loading', 'Memuat data...') %></td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    </div>

    <div id="ew-tab-rekap" style="display:none">
    <div class="card mb16">
      <div class="card-hd" style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">
        <h6 style="margin:0"><i class="bi bi-check2-circle"></i> <%= t('admin.set.ew_rekap','Rekap Auto-Lunas') %></h6>
        <form method="GET" action="/admin/ewallet-logs" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
          <input class="fc" type="number" name="month" min="1" max="12" value="<%= (typeof alMonth!=='undefined'?alMonth:(new Date().getMonth()+1)) %>" style="width:70px">
          <input class="fc" type="number" name="year" min="2000" max="3000" value="<%= (typeof alYear!=='undefined'?alYear:new Date().getFullYear()) %>" style="width:90px">
          <button class="btn btn-p btn-sm"><i class="bi bi-funnel"></i> <%= t('admin.set.show','Tampilkan') %></button>
          <a class="btn btn-g btn-sm" href="/admin/autolunas/export?month=<%= (typeof alMonth!=='undefined'?alMonth:(new Date().getMonth()+1)) %>&year=<%= (typeof alYear!=='undefined'?alYear:new Date().getFullYear()) %>"><i class="bi bi-download"></i> CSV</a>
        </form>
      </div>
      <div class="card-bd">
        <div style="display:flex;gap:24px;margin-bottom:10px;flex-wrap:wrap">
          <div><div class="muted" style="font-size:11px">JUMLAH</div><div style="font-weight:800;font-size:20px;color:var(--primary)"><%= (typeof alRows!=='undefined'?alRows.length:0) %></div></div>
          <div><div class="muted" style="font-size:11px">TOTAL</div><div style="font-weight:800;font-size:20px">Rp <%= Number((typeof alTotal!=='undefined'?alTotal:0)).toLocaleString('id-ID') %></div></div>
        </div>
        <div class="tbl-wrap" style="max-height:360px;overflow:auto">
          <table class="dtbl">
            <thead><tr><th style="width:48px">#</th><th><%= t('common.customer','Pelanggan') %></th><th style="width:110px">ID</th><th style="width:90px"><%= t('pwa.field.period','Periode') %></th><th style="width:110px"><%= t('collector.col_amount','Nominal') %></th><th style="width:150px"><%= t('collector.col_time','Waktu') %></th></tr></thead>
            <tbody>
              <% (typeof alRows!=='undefined'?alRows:[]).forEach(function(r,i){ %>
              <tr>
                <td class="muted"><%= i+1 %></td>
                <td style="font-weight:700"><%= r.customer_name %></td>
                <td><span class="ew-svc mono"><%= r.customer_code||'-' %></span></td>
                <td><%= r.period_month %>/<%= r.period_year %></td>
                <td style="font-weight:800;color:var(--primary)">Rp <%= Number(r.amount||0).toLocaleString('id-ID') %></td>
                <td class="muted"><%= r.paid_at||'-' %></td>
              </tr>
              <% }); %>
              <% if (typeof alRows==='undefined' || !alRows.length) { %><tr><td colspan="6" class="text-center text-muted"><%= t('admin.set.al_empty','Tidak ada auto-lunas pada periode ini.') %></td></tr><% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    </div>
    <% } else { %>
    <div class="card mb16">
      <div class="card-hd" style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">
        <h6 style="margin:0"><i class="bi bi-wallet2"></i> <%= t('admin.settings.ewallet_logs.title', 'Log Notifikasi E-Wallet (Webhook)') %></h6>
        <a class="btn btn-p btn-sm" href="/admin/ewallet-logs"><i class="bi bi-box-arrow-up-right"></i> <%= t('common.open', 'Buka') %></a>
      </div>
      <div class="card-bd">
        <div class="hint"><%= t('admin.set.ew_log_hint','Log notifikasi e-wallet dipindah ke halaman khusus agar pengaturan tidak terdorong ke bawah.') %></div>
      </div>
    </div>
    <% } %>

    <% if (!logsOnly) { %>
    <form method="POST" action="/admin/settings">

        <div class="set-toolbar">
          <div class="set-tabs">
            <button type="button" class="set-tab active" data-cat="umum" onclick="setSetTab('umum')"><i class="bi bi-info-circle"></i> <%= t('admin.settings.tab_general','Umum') %></button>
            <button type="button" class="set-tab" data-cat="jaringan" onclick="setSetTab('jaringan')"><i class="bi bi-router"></i> <%= t('admin.settings.tab_network','Jaringan & Perangkat') %></button>
            <button type="button" class="set-tab" data-cat="notif" onclick="setSetTab('notif')"><i class="bi bi-bell"></i> <%= t('admin.settings.tab_notif','Notifikasi & WhatsApp') %></button>
            <button type="button" class="set-tab" data-cat="keamanan" onclick="setSetTab('keamanan')"><i class="bi bi-shield-lock"></i> <%= t('admin.settings.tab_security','Keamanan') %></button>
            <button type="button" class="set-tab" data-cat="pembayaran" onclick="setSetTab('pembayaran')"><i class="bi bi-wallet2"></i> <%= t('admin.settings.tab_payment','Pembayaran') %></button>
            <button type="button" class="set-tab" data-cat="branding" onclick="setSetTab('branding')"><i class="bi bi-palette"></i> Branding</button>
          </div>
          <div class="set-search">
            <i class="bi bi-search"></i>
            <input type="text" id="setSearch" placeholder="<%= t('admin.settings.search_ph','Cari pengaturan… (mis. qris, password, mikrotik)') %>" oninput="setSearch(this.value)">
            <button type="button" class="clr" id="setSearchClear" style="display:none" onclick="document.getElementById('setSearch').value='';setSearch('');"><i class="bi bi-x-lg"></i></button>
          </div>
        </div>

        <div class="card mb16" data-setcat="notif">
          <div class="card-hd"><h6><i class="bi bi-telegram"></i> <%= t('admin.settings.telegram.title', 'Pengaturan Telegram Bot (Backup Admin)') %></h6></div>
          <div class="card-bd">
            <div class="form-row">
              <div class="fg">
                <label class="fl"><%= t('admin.settings.telegram.status', 'Status Bot Telegram') %></label>
                <select class="fs" name="telegram_enabled">
                  <option value="true" <%= settings.telegram_enabled ? 'selected' : '' %>><%= t('common.active', 'Aktif') %></option>
                  <option value="false" <%= !settings.telegram_enabled ? 'selected' : '' %>><%= t('common.inactive', 'Nonaktif') %></option>
                </select>
              </div>
              <div class="fg">
                <label class="fl"><%= t('admin.settings.telegram.admin_id', 'Admin Telegram ID') %></label>
                <input class="fc" name="telegram_admin_id" value="<%= settings.telegram_admin_id || '' %>" placeholder="Contoh: 12345678">
              </div>
            </div>
            <div class="fg">
              <label class="fl"><%= t('admin.settings.telegram.bot_token', 'Telegram Bot Token') %></label>
              <div style="display:flex;gap:8px">
                <input class="fc" name="telegram_bot_token" value="<%= settings.telegram_bot_token || '' %>" placeholder="Dapatkan dari @BotFather">
                <button type="button" class="btn btn-g" onclick="syncTelegram()" title="<%= t('admin.settings.telegram.sync_title', 'Sinkronkan / Hapus Webhook Lama') %>"><i class="bi bi-arrow-repeat"></i> <%= t('admin.settings.telegram.sync', 'Sinkronkan') %></button>
              </div>
            </div>
          </div>
        </div>

        <div class="card mb16">
          <div class="card-hd"><h6><i class="bi bi-sliders"></i> <%= t('admin.settings.system_title', 'Pengaturan Sistem') %></h6></div>
          <div class="card-bd settings-grid">
        
        <!-- General Info -->
        <div data-setcat="umum">
          <h6 style="font-size:13px;color:var(--muted);margin-bottom:12px;text-transform:uppercase;letter-spacing:1px"><i class="bi bi-info-circle"></i> <%= t('admin.settings.app_info', 'Info Aplikasi') %></h6>
          <div class="fg">
            <label class="fl"><%= t('admin.settings.company_name', 'Nama Aplikasi / Perusahaan') %></label>
            <input class="fc" name="company_header" value="<%= settings.company_header || '' %>">
          </div>
          <div class="fg">
            <label class="fl"><%= t('admin.set.public_url','URL Publik Aplikasi (Public Base URL)') %></label>
            <input class="fc" name="public_base_url" value="<%= settings.public_base_url || '' %>" placeholder="https://portal.domain-anda.com">
            <div style="font-size:10px; color:var(--muted); margin-top:4px">Digunakan untuk menyusun tautan login pelanggan yang dikirim via WhatsApp. Contoh: <span class="mono">https://portal.domain-anda.com</span></div>
          </div>
          <div class="fg">
            <label class="fl"><%= t('admin.set.id_prefix','Prefix ID Pelanggan') %></label>
            <input class="fc" name="customer_id_prefix" value="<%= settings.customer_id_prefix || 'SKY' %>" placeholder="SKY" style="text-transform:uppercase" maxlength="12">
            <div style="font-size:10px; color:var(--muted); margin-top:4px">Format ID Pelanggan: <span class="mono">PREFIX-angka</span> (contoh: <span class="mono"><%= (settings.customer_id_prefix || 'SKY') %>-48213</span>). Hanya angka setelah tanda hubung. ID <b>permanen</b> &amp; otomatis untuk pelanggan baru.</div>
          </div>
          <div class="fg">
            <label class="fl"><%= t('admin.set.id_digits','Jumlah Digit Angka ID Pelanggan') %></label>
            <input class="fc" type="number" name="customer_id_digits" value="<%= settings.customer_id_digits || 5 %>" min="4" max="10" step="1">
            <div style="font-size:10px; color:var(--muted); margin-top:4px">Default 5 → contoh <span class="mono">SKY-48213</span>.</div>
          </div>
          <div class="fg">
            <label class="fl"><%= t('admin.settings.footer_info', 'Info Footer') %></label>
            <input class="fc" name="footer_info" value="<%= settings.footer_info || '' %>">
          </div>
          <div class="form-row">
            <div class="fg">
              <label class="fl"><%= t('admin.settings.owner_name', 'Nama Manajer / Owner') %></label>
              <input class="fc" name="company_manager" value="<%= settings.company_manager || '' %>" placeholder="Admin Pusat">
            </div>
            <div class="fg">
              <label class="fl"><%= t('admin.settings.primary_phone', 'Telepon Utama (CS)') %></label>
              <input class="fc" name="company_phone" value="<%= settings.company_phone || '' %>" placeholder="081234567890">
            </div>
          </div>
          <div class="fg">
            <label class="fl"><%= t('admin.settings.company_email', 'Email Perusahaan') %></label>
            <input class="fc" name="company_email" value="<%= settings.company_email || '' %>" placeholder="support@isp.com">
          </div>
          <div class="fg">
            <label class="fl"><%= t('admin.settings.office_address', 'Alamat Kantor') %></label>
            <input class="fc" name="company_address" value="<%= settings.company_address || '' %>" placeholder="Jl. Utama No. 123">
          </div>
          <div class="form-row">
            <div class="fg">
              <label class="fl"><%= t('admin.settings.office_lat', 'Latitude Kantor') %></label>
              <input class="fc" name="office_lat" value="<%= settings.office_lat || '' %>" placeholder="-6.xxx">
            </div>
            <div class="fg">
              <label class="fl"><%= t('admin.settings.office_lng', 'Longitude Kantor') %></label>
              <input class="fc" name="office_lng" value="<%= settings.office_lng || '' %>" placeholder="106.xxx">
            </div>
          <div class="hint" style="margin-top:6px;color:var(--muted)">
            <i class="bi bi-info-circle"></i> Koordinat kantor digunakan untuk validasi lokasi absensi karyawan (geofencing)
          </div>
          <div class="form-row" style="margin-top:12px">
            <div class="fg">
              <label class="fl">
                <i class="bi bi-shield-check"></i> Geofencing Absensi
              </label>
              <select class="fs" name="attendance_geofencing">
                <option value="true" <%= settings.attendance_geofencing === 'true' || settings.attendance_geofencing === true ? 'selected' : '' %>><%= t('admin.set.att_geo_on','Aktif (Validasi Lokasi)') %></option>
                <option value="false" <%= settings.attendance_geofencing === 'false' || settings.attendance_geofencing === false ? 'selected' : '' %>><%= t('admin.set.att_geo_off','Nonaktif (Bebas)') %></option>
              </select>
            </div>
            <div class="fg">
              <label class="fl">
                <i class="bi bi-geo-alt"></i> Radius Absensi (meter)
              </label>
              <input type="number" class="fc" name="attendance_radius" value="<%= settings.attendance_radius || '100' %>" placeholder="100" min="10" max="1000">
            </div>
          </div>
          <div class="hint" style="margin-top:6px;color:var(--warning)">
            <i class="bi bi-exclamation-triangle"></i> <strong><%= t('admin.set.geo_label','Geofencing:') %></strong> <%= t('admin.set.geo_desc','Karyawan hanya bisa absen jika berada dalam radius yang ditentukan dari koordinat kantor. Nonaktifkan jika karyawan bekerja remote/lapangan.') %>
          </div>
          </div>
          <div class="fg">
            <label class="fl"><%= t('admin.settings.operational_hours', 'Jam Operasional') %></label>
            <input class="fc" name="operational_hours" value="<%= settings.operational_hours || '' %>" placeholder="Setiap Hari: 08.00 - 22.00 WIB">
          </div>
          <div class="form-row">
            <div class="fg">
              <label class="fl"><%= t('admin.settings.server_port', 'Port Server') %></label>
              <input class="fc" type="number" name="server_port" value="<%= settings.server_port || 3001 %>">
            </div>
            <div class="fg">
              <label class="fl"><%= t('admin.settings.timezone', 'Zona Waktu') %></label>
              <select class="fs" name="timezone">
                <option value="Asia/Jakarta" <%= settings.timezone === 'Asia/Jakarta' ? 'selected' : '' %>><%= t('admin.set.tz_wib','WIB (Asia/Jakarta)') %></option>
                <option value="Asia/Makassar" <%= settings.timezone === 'Asia/Makassar' ? 'selected' : '' %>><%= t('admin.set.tz_wita','WITA (Asia/Makassar)') %></option>
                <option value="Asia/Jayapura" <%= settings.timezone === 'Asia/Jayapura' ? 'selected' : '' %>><%= t('admin.set.tz_wit','WIT (Asia/Jayapura)') %></option>
              </select>
            </div>
            <div class="fg">
              <label class="fl"><%= t('admin.settings.customer_otp_login', 'Login OTP Pelanggan') %></label>
              <select class="fs" name="login_otp_enabled">
                <option value="true" <%= settings.login_otp_enabled ? 'selected' : '' %>><%= t('admin.settings.otp_enabled', 'Aktif (Kirim via WA)') %></option>
                <option value="false" <%= !settings.login_otp_enabled ? 'selected' : '' %>><%= t('admin.settings.otp_disabled', 'Nonaktif (Langsung)') %></option>
              </select>
            </div>
          </div>
          <div class="hint" style="margin:0 0 10px;padding:12px;border:1px dashed var(--border);border-radius:10px;background:var(--bg2)">
            <i class="bi bi-robot"></i> <strong>Otomatisasi dipindah:</strong> Auto-Nonaktif, Auto-Hapus, Auto-Peringatan &amp; Auto-<%= t('admin.set.ew_paid','Lunas') %> kini tertata di menu <a href="/admin/automation" style="color:var(--primary);font-weight:800">Automation &rarr;</a>
          </div>
          <div class="hint" style="margin-top:6px;color:var(--warning)">
            <i class="bi bi-info-circle"></i> <strong><%= t('admin.set.colpay_label','Pembayaran Kolektor:') %></strong> <%= t('admin.set.colpay_desc','Pengaturan approval pembayaran kolektor sekarang diatur per akun kolektor pada menu Manajemen Kolektor, bukan dari pengaturan global.') %>
