  function updatePopupTraffic(customerId, dlMbps, ulMbps, labelOverride) {
    const dlCanvas = document.getElementById(`cust_${customerId}_dl_chart`);
    const ulCanvas = document.getElementById(`cust_${customerId}_ul_chart`);
    const dlMax = Number(dlCanvas && dlCanvas.dataset ? dlCanvas.dataset.max : 10) || 10;
    const ulMax = Number(ulCanvas && ulCanvas.dataset ? ulCanvas.dataset.max : 10) || 10;

    if (!customerTrafficSeries[customerId]) customerTrafficSeries[customerId] = { dl: [], ul: [] };
    const st = customerTrafficSeries[customerId];

    if (labelOverride) {
      setOverlay(customerId, 'dl', labelOverride);
      setOverlay(customerId, 'ul', labelOverride);
      st.dl = [];
      st.ul = [];
      drawSparkline(dlCanvas, [0, 0], dlMax, 'rgba(59,130,246,0.6)');
      drawSparkline(ulCanvas, [0, 0], ulMax, 'rgba(34,197,94,0.6)');
      return;
    }

    setOverlay(customerId, 'dl', '');
    setOverlay(customerId, 'ul', '');

    const dl = Math.max(0, Number(dlMbps || 0) || 0);
    const ul = Math.max(0, Number(ulMbps || 0) || 0);
    st.dl.push(dl);
    st.ul.push(ul);
    if (st.dl.length > 22) st.dl = st.dl.slice(-22);
    if (st.ul.length > 22) st.ul = st.ul.slice(-22);

    drawSparkline(dlCanvas, st.dl, dlMax, '#3b82f6');
    drawSparkline(ulCanvas, st.ul, ulMax, '#22c55e');
  }

  async function refreshCustomerTrafficPopup(customerId) {
    try {
      const r = await fetch(`/admin/api/customers/${customerId}/pppoe-traffic`, { cache: 'no-store' });
      const data = await r.json();
      if (!data || !data.ok) {
        updatePopupTraffic(customerId, 0, 0, '-');
        return;
      }
      if (!data.available) {
        updatePopupTraffic(customerId, 0, 0, 'N/A');
        return;
      }
      if (!data.online) {
        updatePopupTraffic(customerId, 0, 0, 'Offline');
        return;
      }
      if (data.warmup) {
        updatePopupTraffic(customerId, 0, 0, 'Mengukur');
        return;
      }

      const rx = Number(data.rxMbps || 0);
      const tx = Number(data.txMbps || 0);
      updatePopupTraffic(customerId, tx, rx, '');
    } catch {
      updatePopupTraffic(customerId, 0, 0, '-');
    }
  }

  function startCustomerTrafficPopup(customerId) {
    stopCustomerTrafficPopup(customerId);
    refreshCustomerTrafficPopup(customerId);
    customerTrafficIntervals[customerId] = setInterval(() => refreshCustomerTrafficPopup(customerId), 3000);
  }

  function stopCustomerTrafficPopup(customerId) {
    const t = customerTrafficIntervals[customerId];
    if (t) clearInterval(t);
    delete customerTrafficIntervals[customerId];
  }

  function normalizePhone(phone) {
    const raw = String(phone || '').trim();
    const digits = raw.replace(/\D/g, '');
    if (!digits) return '';
    if (digits.startsWith('62')) return digits;
    if (digits.startsWith('0')) return `62${digits.slice(1)}`;
    if (digits.length >= 9) return `62${digits}`;
    return digits;
  }

  // Tentukan kelas koneksi: online (hijau) / offline (merah) / inactive (abu)
  function computeConnClass(cust) {
    const _st = String((cust && cust.status) || '').toLowerCase();
    const isInactive = !['active', 'suspended', 'isolir', 'isolated', 'ditangguhkan'].includes(_st);
    if (isInactive) return 'inactive';
    const uname = String((cust && cust.pppoe_username) || '').toLowerCase().trim();
    return (uname && liveSessionKeys.has(uname)) ? 'online' : 'offline';
  }

  // Warna jalur kabel: biru = online, merah = offline, abu = nonaktif
  function cableColorFor(cls) {
    if (cls === 'online') return '#3b82f6';
    if (cls === 'inactive') return '#94a3b8';
    return '#ef4444';
  }
  // Perbarui warna semua jalur kabel sesuai status live (hanya yang berubah)
  function refreshCableColors() {
    Object.keys(customerMap).forEach(function (id) {
      const entry = customerMap[id];
      if (!entry || !entry.polyline) return;
      const cls = computeConnClass(entry.data || {});
      if (entry._cableClass === cls) return;
      entry._cableClass = cls;
      try { entry.polyline.setStyle({ color: cableColorFor(cls) }); } catch (e) {}
    });
  }

  // Bangun icon marker ONU (dipakai saat render & saat update status realtime)
  function buildOnuIcon(cust) {
    const is_active = cust.status === 'active';
    const _st = String(cust.status || '').toLowerCase();
    const isInactive = !['active', 'suspended', 'isolir', 'isolated', 'ditangguhkan'].includes(_st);
    const statusClass = is_active ? 'st-active' : (isInactive ? 'st-inactive' : 'st-suspended');
    const badgeIcon = is_active ? 'bi-check-lg' : (isInactive ? 'bi-dash-lg' : 'bi-x-lg');
    const connClass = computeConnClass(cust);
    return L.divIcon({
      className: 'custom-onu-icon',
      html: `
        <div class="onu-marker-node ${connClass} ${statusClass}" id="onu-node-${cust.id}">
          <div class="onu-marker-pin" title="${escapeHtml(cust.name)} (${is_active ? 'Aktif' : (isInactive ? 'Nonaktif' : 'Isolir')})">
            <i class="bi bi-router-fill"></i>
            <span class="onu-marker-badge"><i class="bi ${badgeIcon}"></i></span>
          </div>
          <div class="onu-marker-label">
            <span class="onu-marker-name">${escapeHtml(cust.name)}</span>
          </div>
        </div>
      `,
      iconSize: [26, 26],
      iconAnchor: [13, 13]
    });
  }

  // Bangun HTML popup pelanggan (dipanggil hanya saat popup dibuka → hemat performa)
  function buildCustomerPopupHtml(cust) {
    const lat = parseFloat(cust.lat);
    const lng = parseFloat(cust.lng);
    const is_active = cust.status === 'active';
    const downMaxMbps = (cust.speed_down && Number(cust.speed_down) > 0) ? Math.max(1, Math.round(Number(cust.speed_down) / 1000)) : 10;
    const upMaxMbps = (cust.speed_up && Number(cust.speed_up) > 0) ? Math.max(1, Math.round(Number(cust.speed_up) / 1000)) : 10;
    const waLink = buildWaLink(cust.phone, cust.name);
    return `
        <div class="cust-popup">
          <div class="cp-head">
            <div class="cp-avatar"><i class="bi bi-person-fill"></i></div>
            <div class="cp-title">
              <div class="cp-name">${escapeHtml(cust.name)}</div>
              <div class="cp-badges">
                <span class="cp-chip ${is_active ? 'cp-chip-active' : 'cp-chip-suspended'}"><i class="bi bi-shield-check"></i>${is_active ? I18N.statusActive : I18N.statusSuspended}</span>
                <span class="cp-chip"><i class="bi bi-box-seam"></i>${escapeHtml(cust.package_name || '-')}</span>
              </div>
            </div>
          </div>

          <div class="cp-meta">
            <div class="cp-meta-item"><i class="bi bi-router"></i><span>PPPoE: <strong>${escapeHtml(cust.pppoe_username || '-')}</strong></span></div>
            <div class="cp-meta-item"><i class="bi bi-tag"></i><span>Tag/SN: <strong>${escapeHtml(cust.genieacs_tag || '-')}</strong></span></div>
            <div class="cp-meta-item"><i class="bi bi-box-seam"></i><span>ODP: <strong>${escapeHtml(cust.odp_name || 'Tanpa ODP')}</strong></span></div>
            <div class="cp-meta-item"><i class="bi bi-telephone"></i><span>${escapeHtml(cust.phone || '-')}</span></div>
            <div class="cp-meta-item"><i class="bi bi-geo-alt"></i><span>${escapeHtml(cust.address || '-')}</span></div>
          </div>

          <div class="cp-traffic">
            <div class="cp-traffic-head"><i class="bi bi-activity"></i><span>Trafik Realtime</span></div>
            <div class="cp-traffic-grid">
              <div class="cp-chart">
                <div class="cp-chart-label"><i class="bi bi-download"></i><span>Download</span></div>
                <canvas class="cp-spark" id="cust_${cust.id}_dl_chart" width="160" height="60" data-max="${downMaxMbps}"></canvas>
                <div class="cp-overlay" id="cust_${cust.id}_dl_state"></div>
              </div>
              <div class="cp-chart">
                <div class="cp-chart-label"><i class="bi bi-upload"></i><span>Upload</span></div>
                <canvas class="cp-spark" id="cust_${cust.id}_ul_chart" width="160" height="60" data-max="${upMaxMbps}"></canvas>
                <div class="cp-overlay" id="cust_${cust.id}_ul_state"></div>
              </div>
            </div>
          </div>

          <div class="popup-actions">
             <button onclick="startCableDrawing(${cust.id}, ${lat}, ${lng}, ${cust.odp_id})" class="btn btn-sm btn-p"><i class="bi bi-pencil-fill me-1"></i>Gambar Jalur</button>
             <a href="/admin/customers?search=${encodeURIComponent(cust.name || '')}" class="btn btn-sm btn-g"><i class="bi bi-eye me-1"></i>Detail</a>
             ${cust.phone ? `<a href="${waLink}" target="_blank" class="btn btn-sm btn-wa"><i class="bi bi-whatsapp"></i> Chat</a>` : ''}
          </div>
        </div>
      `;
  }

  // Ganti peta dasar (basemap) via dropdown
  function switchBaseMap(key) {
    const layerMap = { osm: osm, hybrid: googleHybrid, sat: googleSat, dark: googleDark };
    const chosen = layerMap[key];
    [osm, googleHybrid, googleSat, googleDark].forEach(function (l) { if (l && map.hasLayer(l)) map.removeLayer(l); });
    if (chosen) { chosen.addTo(map); chosen.bringToFront && chosen.bringToFront(); }
  }

  // Render grid port pada popup ODP: hijau=terhubung(online), merah=offline, tanpa warna=belum
  function renderOdpPopupPorts(odpId) {
    const el = document.getElementById('odp-pop-ports-' + odpId);
    if (!el) return;
    const entry = odpMap[odpId];
    const usage = entry && entry.data ? entry.data.port_usage : null;
    if (!usage) { el.innerHTML = '<span style="font-size:11px;color:var(--muted)">Data port tidak tersedia.</span>'; return; }
    const cap = Number(usage.capacity || 0);
    const usedBy = usage.usedBy || {};
    let html = '';
    for (let i = 1; i <= cap; i++) {
      const u = usedBy[String(i)];
      let bg = 'transparent', bd = 'var(--muted)', title = 'Port ' + i + ' — belum terhubung';
      if (u) {
        const nm = (typeof u === 'string') ? u : (u.name || '');
        const pppoe = (typeof u === 'string') ? '' : String(u.pppoe || '').toLowerCase();
        const on = !!pppoe && liveSessionKeys.has(pppoe);
        bg = on ? '#22c55e' : '#ef4444';
        bd = bg;
        title = 'Port ' + i + ' — ' + (nm || 'terpakai') + ' (' + (on ? 'Online' : 'Offline') + ')';
      }
      html += '<span title="' + escapeHtml(title) + '" style="width:18px;height:18px;border-radius:4px;display:inline-block;background:' + bg + ';border:1.5px solid ' + bd + '"></span>';
    }
    el.innerHTML = html;
  }

  function showOdpPorts(odpId) {
    var grid = document.getElementById('odpPortsGrid');
    var title = document.getElementById('odpPortsTitle');
    var legend = document.getElementById('odpPortsLegend');
    if (!grid) return;
    grid.innerHTML = '<span class="text-muted">Memuat…</span>';
    if (legend) legend.textContent = '';
    if (title) title.textContent = 'Port ODP';
    openModal('odpPortsModal');
    fetch('/admin/api/odps/' + encodeURIComponent(odpId) + '/ports', { cache: 'no-store' })
      .then(function (r) { return r.json(); })
      .then(function (u) {
        var cap = Number(u.capacity || 0);
        var usedBy = u.usedBy || {};
        var html = '';
        for (var i = 1; i <= cap; i++) {
          var uu = usedBy[String(i)];
          var nm = uu ? (typeof uu === 'string' ? uu : (uu.name || '')) : '';
          var pppoe = uu && typeof uu === 'object' ? String(uu.pppoe || '').toLowerCase() : '';
          var on = !!pppoe && liveSessionKeys.has(pppoe);
          var bg = 'transparent', col = 'var(--muted)', bd = 'var(--muted)', lbl = 'belum';
          if (uu) { bg = on ? '#22c55e' : '#ef4444'; bd = bg; col = '#ffffff'; lbl = on ? 'online' : 'offline'; }
          html += '<span title="Port ' + i + (uu ? (' — ' + escapeHtml(nm) + ' (' + lbl + ')') : ' (belum terhubung)') + '" style="width:42px;height:42px;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;font-weight:800;font-size:12px;background:' + bg + ';color:' + col + ';border:1.5px solid ' + bd + '">' + i + '</span>';
        }
        grid.innerHTML = html;
        if (legend) legend.textContent = 'Hijau = terhubung (online), Merah = offline, tanpa warna = belum terhubung. Terpakai ' + (u.usedCount || 0) + '/' + cap + '.';
        if (title) title.textContent = 'Port ODP (' + (u.usedCount || 0) + '/' + cap + ')';
      })
      .catch(function () { grid.innerHTML = '<span class="text-muted">Gagal memuat data port.</span>'; });
  }

  function buildWaLink(phone, name) {
    const to = normalizePhone(phone);
    const msg = `Halo ${String(name || '').trim()}`;
    if (!to) return 'javascript:void(0)';
    return `https://wa.me/${to}?text=${encodeURIComponent(msg)}`;
  }

  // ─── LIVE STATUS MARKER (online / offline) ───────────────────────────
  async function fetchLiveSessions() {
    try {
      const r = await fetch('/admin/api/customers/live-sessions', { cache: 'no-store' });
      const data = await r.json();
      if (!data || !data.ok) return;
      liveSessionKeys = new Set(Object.keys(data.sessions || {}).map(k => String(k).toLowerCase()));
    } catch (e) {}
  }

  // Update warna marker via setIcon (tahan zoom in/out & clustering — DOM bukan sumber kebenaran)
  async function refreshLiveMarkerStatus() {
    await fetchLiveSessions();
    Object.keys(customerMap).forEach(id => {
      const entry = customerMap[id];
      if (!entry || !entry.marker) return;
      const cust = entry.data || {};
      const cls = computeConnClass(cust);
      if (entry._connClass === cls) return;
      entry._connClass = cls;
      try { entry.marker.setIcon(buildOnuIcon(cust)); } catch (e) {}
    });
    refreshCableColors();
  }
  refreshLiveMarkerStatus();
  setInterval(refreshLiveMarkerStatus, isMobileMap ? 45000 : 15000);
</script>
</body>
</html>
