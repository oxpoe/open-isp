  // ─── FILTER & TOGGLE ACTIONS ──────────────────────────────────────────────
  function applyStatusFilter(status) {
    currentFilter = status;
    document.querySelectorAll('.map-filter-group .map-pill-btn').forEach(b => {
      if (b.id === 'pillAll' && status === 'all') b.classList.add('active');
      else if (b.id === 'pillActive' && status === 'active') b.classList.add('active');
      else if (b.id === 'pillSuspended' && status === 'suspended') b.classList.add('active');
      else if (b.id.startsWith('pill') && b.id !== 'pillLabels') b.classList.remove('active');
    });

    Object.keys(customerMap).forEach(id => {
      const { marker, data, polyline } = customerMap[id];
      const isActive = data.status === 'active';
      let shouldShow = true;

      if (status === 'active' && !isActive) shouldShow = false;
      if (status === 'suspended' && isActive) shouldShow = false;

      const markerOn = onuCluster ? onuCluster.hasLayer(marker) : map.hasLayer(marker);
      if (shouldShow) {
        if (!markerOn) { if (onuCluster) onuCluster.addLayer(marker); else map.addLayer(marker); }
        if (polyline && !map.hasLayer(polyline)) map.addLayer(polyline);
      } else {
        if (markerOn) { if (onuCluster) onuCluster.removeLayer(marker); else map.removeLayer(marker); }
        if (polyline && map.hasLayer(polyline)) map.removeLayer(polyline);
      }
    });
  }

  function toggleMarkerLabels() {
    showLabels = !showLabels;
    const btn = document.getElementById('pillLabels');
    const txt = document.getElementById('labelToggleText');
    const mapEl = document.getElementById('map');

    if (showLabels) {
      mapEl.classList.remove('hide-marker-labels');
      btn.classList.add('active');
      txt.textContent = '<%= t('admin.map.label_on','Label: ON') %>';
    } else {
      mapEl.classList.add('hide-marker-labels');
      btn.classList.remove('active');
      txt.textContent = 'Label: OFF';
    }
  }

  function fitAllMarkers() {
    const pts = [];
    Object.values(customerMap).forEach(e => {
      const shown = onuCluster ? onuCluster.hasLayer(e.marker) : map.hasLayer(e.marker);
      if (shown && e.marker && e.marker.getLatLng) pts.push(e.marker.getLatLng());
    });
    Object.values(odpMap).forEach(e => {
      if (map.hasLayer(e.marker) && e.marker && e.marker.getLatLng) pts.push(e.marker.getLatLng());
    });

    if (pts.length > 0) {
      map.fitBounds(L.latLngBounds(pts).pad(0.1));
    } else {
      map.setView([officeCoords.lat, officeCoords.lng], 13);
    }
