<!-- Bootstrap lazy-load peta (<%= t('admin.map.see_maps','LIHAT PETA') %> / CLOSE MAPS) -->
<script>
  window.__billingMapLoaded = false;
  function loadMapScript() {
    if (window.__billingMapLoaded) return;
    window.__billingMapLoaded = true;
    var src = document.getElementById('mapScriptSrc');
    if (!src) return;
    var s = document.createElement('script');
    s.textContent = src.textContent;
    document.body.appendChild(s);
  }
  function toggleBillingMaps() {
    var content = document.getElementById('mapsContent');
    var ph = document.getElementById('mapsPlaceholder');
    var txt = document.getElementById('mapsToggleTxt');
    if (!content) return;
    var showing = content.style.display !== 'none';
    if (showing) {
      content.style.display = 'none';
      if (ph) ph.style.display = '';
      if (txt) txt.textContent = '<%= t('admin.map.see_maps','LIHAT PETA') %>';
    } else {
      if (ph) ph.style.display = 'none';
      content.style.display = '';
      if (txt) txt.textContent = 'CLOSE MAPS';
      loadMapScript();
      setTimeout(function () { window.dispatchEvent(new Event('resize')); }, 350);
    }
  }
</script>

<script id="mapScriptSrc" type="text/plain">
  const I18N = {
    layerOsm: "<%= t('admin.map.layers.osm', 'OpenStreetMap') %>",
    layerHybrid: "<%= t('admin.map.layers.hybrid', 'Satelit (Hybrid)') %>",
    layerSat: "<%= t('admin.map.layers.sat', 'Satelit (Bersih)') %>",
    layerDark: "<%= t('admin.map.layers.dark', 'Gelap (Dark)') %>",
    popupDescription: "<%= t('admin.map.popup.description', 'Deskripsi') %>",
    popupLocation: "<%= t('admin.map.popup.location', 'Lokasi') %>",
    popupEdit: "<%= t('common.edit', 'Edit') %>",
    popupStatus: "<%= t('admin.map.popup.status', 'Status') %>",
    popupPackage: "<%= t('admin.map.popup.package', 'Paket') %>",
    popupAddress: "<%= t('admin.map.popup.address', 'Alamat') %>",
    viewDetails: "<%= t('admin.map.popup.view_details', 'Lihat Detail') %>",
    statusActive: "<%= t('admin.map.status.active', 'Aktif') %>",
    statusSuspended: "<%= t('admin.map.status.suspended', 'Isolir') %>",
    cableOnline: "<%= t('admin.map.cable.online', 'Online') %>",
    cableOffline: "<%= t('admin.map.cable.offline', 'Offline') %>"
  };

  function escapeHtml(str) {
    if (str === null || str === undefined) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  const appSettings = JSON.parse(document.getElementById('settings-data').textContent || '{}');
  const officeCoords = {
    lat: parseFloat(appSettings.office_lat) || -6.200000,
    lng: parseFloat(appSettings.office_lng) || 106.816666
  };

  // Deteksi mobile → kurangi beban render (animasi, label, dsb.)
  const isMobileMap = window.matchMedia('(max-width: 768px)').matches || /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent || '');

  // Initialize Map
  const map = L.map('map', {
    editable: true,
    preferCanvas: isMobileMap,
    zoomAnimation: !isMobileMap,
    fadeAnimation: !isMobileMap,
    markerZoomAnimation: !isMobileMap,
    updateWhenIdle: true,
    wheelDebounceTime: isMobileMap ? 90 : 40
  }).setView([officeCoords.lat, officeCoords.lng], isMobileMap ? 12 : 13);

  if (isMobileMap) {
    const _mapEl = document.getElementById('map');
    if (_mapEl) _mapEl.classList.add('map-mobile', 'hide-marker-labels');
    const _lblBtn = document.getElementById('pillLabels');
    if (_lblBtn) _lblBtn.classList.remove('active');
    const _lblTxt = document.getElementById('labelToggleText');
    if (_lblTxt) _lblTxt.textContent = 'Label: OFF';
  }

  let currentEditingPolyline = null;
  let currentEditingCustomer = null;
  let showLabels = !isMobileMap;
  let currentFilter = 'all';
  let liveSessionKeys = new Set();
  let onuCluster = null;
  // Renderer bersama untuk semua jalur kabel (canvas = jauh lebih cepat di mobile/PWA)
  const cableRenderer = isMobileMap ? L.canvas({ padding: 0.5 }) : null;
  let cableSeq = 0; // batasi animasi garis agar tidak membebani CPU

  // Tile Layers
  const osm = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 21,
    maxNativeZoom: 19,
    attribution: '© OpenStreetMap'
  });

  const googleHybrid = L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
    maxZoom: 21,
    maxNativeZoom: 20,
    subdomains: ['mt0', 'mt1', 'mt2', 'mt3'],
    attribution: '© Google Satellite'
  });

  // Satelit bersih: hanya citra tanpa label/nama tempat (hanya resource billing yang tampil)
  const googleSat = L.tileLayer('https://{s}.google.com/vt/lyrs=s&x={x}&y={y}&z={z}', {
    maxZoom: 21,
    maxNativeZoom: 20,
    subdomains: ['mt0', 'mt1', 'mt2', 'mt3'],
    attribution: '© Google Satellite'
  });

  // Mode gelap (dark) — OSM + CSS filter (bebas API key, bekerja di semua level zoom)
  const googleDark = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 21,
    maxNativeZoom: 19,
    className: 'map-dark-tiles',
    attribution: '© OpenStreetMap'
  });

  // Hanya SATU basemap dirender sekaligus (dulu OSM + Hybrid dobel → boros CPU/bandwidth)
  googleHybrid.addTo(map);

  const baseMaps = {
    [I18N.layerOsm]: osm,
    [I18N.layerHybrid]: googleHybrid,
    [I18N.layerSat]: googleSat,
    [I18N.layerDark]: googleDark
  };

  L.control.layers(baseMaps, null, { collapsed: isMobileMap, position: 'topright' }).addTo(map);

  // Legenda warna jalur kabel: biru = online, merah = offline
  const cableLegend = L.control({ position: 'bottomleft' });
  cableLegend.onAdd = function () {
    const div = L.DomUtil.create('div', 'cable-legend');
    div.innerHTML =
      '<span><i class="cl-dot" style="background:#3b82f6"></i>' + I18N.cableOnline + '</span>' +
      '<span><i class="cl-dot" style="background:#ef4444"></i>' + I18N.cableOffline + '</span>';
    return div;
  };
  cableLegend.addTo(map);

  // ─── MARKER CLUSTERING (performa banyak marker) ───────────────────────
  if (typeof L.markerClusterGroup === 'function') {
    onuCluster = L.markerClusterGroup({
      chunkedLoading: true,
      maxClusterRadius: isMobileMap ? 60 : 50,
      disableClusteringAtZoom: 16,
      showCoverageOnHover: false,
      spiderfyOnMaxZoom: !isMobileMap,
      removeOutsideVisibleBounds: true,
      animate: !isMobileMap,
      iconCreateFunction: function (cluster) {
        const count = cluster.getChildCount();
        const size = count < 10 ? 34 : (count < 50 ? 40 : 48);
        return L.divIcon({
          html: '<div class="marker-cluster-custom" style="width:' + size + 'px;height:' + size + 'px;line-height:' + (size - 4) + 'px">' + count + '</div>',
          className: 'marker-cluster-custom-wrap',
          iconSize: L.point(size, size)
        });
      }
    });
    map.addLayer(onuCluster);
  }

  let customers = [];
  let odps = [];
  try {
    customers = JSON.parse(document.getElementById('customers-data').textContent || '[]');
    odps = JSON.parse(document.getElementById('odps-data').textContent || '[]');
  } catch (e) {
    console.error("Data mapping error:", e);
  }

  // ─── Render tabel daftar pelanggan & ODP di client (hemat ~400KB HTML) ───
  function renderCustomerTable() {
    var tb = document.getElementById('customersTableBody');
    if (!tb) return;
    if (!customers.length) { tb.innerHTML = '<tr><td colspan="6" style="padding:16px;text-align:center;color:#64748b;">Belum ada data pelanggan.</td></tr>'; return; }
    tb.innerHTML = customers.map(function (c) {
      var hasGps = Boolean(c.lat && c.lng);
      var isActive = c.status === 'active';
      var wa = c.phone ? normalizePhone(c.phone) : '';
      return '<tr data-id="' + c.id + '" data-name="' + escapeHtml(String(c.name || '').toLowerCase()) + '" data-pppoe="' + escapeHtml(String(c.pppoe_username || '').toLowerCase()) + '" data-phone="' + escapeHtml(String(c.phone || '').toLowerCase()) + '" data-code="' + escapeHtml(String(c.customer_code || '').toLowerCase()) + '" data-tag="' + escapeHtml(String(c.genieacs_tag || '').toLowerCase()) + '" data-address="' + escapeHtml(String(c.address || '').toLowerCase()) + '" data-status="' + escapeHtml(c.status) + '" data-hasgps="' + (hasGps ? '1' : '0') + '">' +
        '<td><div style="font-weight:800;color:var(--text);">' + escapeHtml(c.name) + '</div>' +
        '<div style="font-size:11px;color:#64748b;"><i class="bi bi-telephone"></i> ' + escapeHtml(c.phone || '-') + '</div></td>' +
        '<td><div style="font-weight:700;font-family:monospace;font-size:12px;color:#2563eb;">' + escapeHtml(c.pppoe_username || '-') + '</div>' +
        (c.genieacs_tag ? '<div style="font-size:11px;color:#64748b;"><i class="bi bi-tag"></i> ' + escapeHtml(c.genieacs_tag) + '</div>' : '') + '</td>' +
        '<td>' + (isActive ? '<span class="cp-chip cp-chip-active"><i class="bi bi-check-circle-fill"></i> <%= t('common.active','Aktif') %></span>' : '<span class="cp-chip cp-chip-suspended"><i class="bi bi-x-circle-fill"></i> Isolir</span>') + '</td>' +
        '<td><div style="font-weight:700;font-size:12px;">' + escapeHtml(c.package_name || '-') + '</div>' +
        '<div style="font-size:11px;color:#d97706;font-weight:700;"><i class="bi bi-box-seam"></i> ' + escapeHtml(c.odp_name || 'Tanpa ODP') + '</div></td>' +
        '<td>' + (hasGps ? '<span style="font-size:11.5px;font-family:monospace;color:var(--text);font-weight:700;">' + Number(c.lat).toFixed(5) + ', ' + Number(c.lng).toFixed(5) + '</span>' : '<span style="font-size:11px;color:#ef4444;font-weight:700;"><i class="bi bi-exclamation-circle"></i> Belum ada GPS</span>') + '</td>' +
        '<td style="text-align:right;white-space:nowrap;"><div class="act">' +
          '<button type="button" class="act-btn" title="Aksi" onclick="actToggle(event, this)"><i class="bi bi-three-dots-vertical"></i></button>' +
          '<div class="act-menu">' +
            (hasGps ? '<button type="button" class="act-item primary" onclick="focusCustomer(' + c.id + ')"><i class="bi bi-geo-alt"></i> Fokus ke Peta</button>' : '') +
            '<a class="act-item" href="/admin/customers?search=' + encodeURIComponent(c.name || '') + '"><i class="bi bi-eye"></i> Detail Pelanggan</a>' +
            (wa ? '<a class="act-item success" href="https://wa.me/' + wa + '" target="_blank"><i class="bi bi-whatsapp"></i> Kirim WA</a>' : '') +
          '</div>' +
        '</div></td></tr>';
    }).join('');
  }

  function renderOdpTable() {
    var tb = document.getElementById('odpsTbody');
    if (!tb) return;
    if (!odps.length) { tb.innerHTML = '<tr><td colspan="5" style="padding:16px;text-align:center;color:#64748b;">Belum ada data ODP.</td></tr>'; return; }
    tb.innerHTML = odps.map(function (o) {
      var pu = o.port_usage || { capacity: Number(o.port_capacity || 16) || 16, usedCount: 0, remaining: Number(o.port_capacity || 16) || 16 };
      return '<tr data-name="' + escapeHtml(String(o.name || '').toLowerCase()) + '" data-desc="' + escapeHtml(String(o.description || '').toLowerCase()) + '">' +
        '<td><div style="font-weight:800;color:var(--text);"><i class="bi bi-box-seam-fill text-warning me-1"></i> ' + escapeHtml(o.name) + '</div></td>' +
        '<td><div style="font-size:12px;color:#64748b;">' + escapeHtml(o.description || '-') + '</div></td>' +
        '<td><div style="font-weight:800;font-size:12px;">' +
          '<button type="button" class="btn btn-sm btn-g" style="font-weight:800;padding:2px 8px" onclick="showOdpPorts(' + Number(o.id) + ')" title="Lihat visual port terpakai"><i class="bi bi-diagram-2"></i> ' + pu.usedCount + '/' + pu.capacity + '</button>' +
          (pu.remaining === 0 ? ' <span class="cp-chip" style="background:#fee2e2;color:#991b1b;border-color:#fecaca"><i class="bi bi-exclamation-triangle-fill"></i> PENUH</span>' : ' <span style="font-size:11px;color:var(--muted)">sisa ' + pu.remaining + '</span>') +
        '</div><div style="font-size:11px;color:var(--muted);margin-top:2px">Klik untuk lihat visual port</div></td>' +
        '<td><div style="font-size:11.5px;font-family:monospace;color:#334155;font-weight:700;">' + (Number(o.lat) || 0).toFixed(6) + ', ' + (Number(o.lng) || 0).toFixed(6) + '</div></td>' +
        '<td style="white-space:nowrap"><div class="act">' +
          '<button type="button" class="act-btn" title="Aksi" onclick="actToggle(event, this)"><i class="bi bi-three-dots-vertical"></i></button>' +
          '<div class="act-menu">' +
            '<button type="button" class="act-item primary" data-odp-id="' + Number(o.id) + '" onclick="editOdpFromBtn(this)"><i class="bi bi-pencil"></i> Edit ODP</button>' +
            '<button type="button" class="act-item" data-odp-id="' + Number(o.id) + '" onclick="focusOdpFromBtn(this)"><i class="bi bi-geo-alt"></i> Fokus Peta</button>' +
            '<div class="act-sep"></div>' +
            '<button type="button" class="act-item danger" data-odp-id="' + Number(o.id) + '" onclick="deleteOdpFromBtn(this)"><i class="bi bi-trash"></i> Hapus ODP</button>' +
          '</div>' +
        '</div></td></tr>';
    }).join('');
  }
  renderCustomerTable();
  renderOdpTable();

  // Registries for quick search, focus, and filtering
  const odpMap = {}; // odpId -> { marker, data, coord }
  const customerMap = {}; // custId -> { marker, data, polyline }

  // 1. Render ODP Markers (Clean icon & floating text outline)
  odps.forEach(odp => {
    if (odp.lat && odp.lng) {
      const lat = parseFloat(odp.lat);
      const lng = parseFloat(odp.lng);
      
      const odpIcon = L.divIcon({
        className: 'custom-onu-icon',
        html: `
          <div class="odp-marker-node ${(odp.port_usage && odp.port_usage.remaining === 0) ? 'is-full' : ''}" id="odp-node-${odp.id}">
            <div class="odp-marker-pin" title="${escapeHtml(odp.name)} (ODP)${odp.port_usage ? ' • Port ' + odp.port_usage.usedCount + '/' + odp.port_usage.capacity : ''}">
              <i class="bi bi-box-seam-fill"></i>
            </div>
            <div class="odp-marker-label">
              <span class="odp-marker-name">${escapeHtml(odp.name)}${odp.port_usage ? ' (' + odp.port_usage.usedCount + '/' + odp.port_usage.capacity + ')' : ''}</span>
            </div>
          </div>
        `,
        iconSize: [26, 26],
        iconAnchor: [13, 13]
      });

      const marker = L.marker([lat, lng], { icon: odpIcon }).addTo(map);
      
      marker.bindPopup(`
        <div class="popup-content">
          <h6 style="font-weight: 800; color: var(--text); margin-bottom: 6px;"><i class="bi bi-box-seam-fill text-warning me-1"></i> ${escapeHtml(odp.name)}</h6>
          <div><strong>${I18N.popupDescription}:</strong> ${escapeHtml(odp.description || '-')}</div>
          <div><strong>Port:</strong> ${odp.port_usage ? (odp.port_usage.usedCount + '/' + odp.port_usage.capacity + (odp.port_usage.remaining === 0 ? ' (PENUH)' : ' • sisa ' + odp.port_usage.remaining)) : (odp.port_capacity || '-')}</div>
          <div id="odp-pop-ports-${odp.id}" class="odp-pop-ports"></div>
          <div class="odp-pop-legend">
            <span><i class="odp-lg" style="background:#22c55e"></i> terhubung</span>
            <span><i class="odp-lg" style="background:#ef4444"></i> offline</span>
            <span><i class="odp-lg" style="background:transparent;border:1px solid var(--muted)"></i> belum terhubung</span>
          </div>
          <div><strong>${I18N.popupLocation}:</strong> ${lat.toFixed(6)}, ${lng.toFixed(6)}</div>
          <div class="popup-actions" style="margin-top: 10px;">
            <button class="btn btn-sm btn-p" onclick='editOdp(${JSON.stringify(odp)})'><i class="bi bi-pencil me-1"></i>${I18N.popupEdit}</button>
          </div>
        </div>
      `);
      marker.on('popupopen', () => { renderOdpPopupPorts(odp.id); });

      odpMap[odp.id] = {
        marker,
        data: odp,
        coord: [lat, lng]
      };
    }
  });

  // 2. Render Customer ONU Markers (Clean pin & floating text outline without box)
  customers.forEach(cust => {
    if (cust.lat && cust.lng) {
      const lat = parseFloat(cust.lat);
      const lng = parseFloat(cust.lng);
      const is_active = cust.status === 'active';
      const _st = String(cust.status || '').toLowerCase();
      const isInactive = !['active', 'suspended', 'isolir', 'isolated', 'ditangguhkan'].includes(_st);
      const downMaxMbps = (cust.speed_down && Number(cust.speed_down) > 0) ? Math.max(1, Math.round(Number(cust.speed_down) / 1000)) : 10;
      const upMaxMbps = (cust.speed_up && Number(cust.speed_up) > 0) ? Math.max(1, Math.round(Number(cust.speed_up) / 1000)) : 10;
      const waLink = buildWaLink(cust.phone, cust.name);
      
      // Draw Cable Line to ODP if connected
      let polyline = null;
      if (cust.odp_id && odpMap[cust.odp_id]) {
        let pathCoords = [[lat, lng], odpMap[cust.odp_id].coord];
        
        if (cust.cable_path) {
          try {
            pathCoords = JSON.parse(cust.cable_path);
          } catch(e) {}
        }

        const _animateCable = !isMobileMap && cableSeq < 150; // batasi animasi bila garis sangat banyak
        cableSeq++;
        polyline = L.polyline(pathCoords, {
          color: '#94a3b8',                 // netral dulu; diwarnai biru/merah oleh status live
          weight: isMobileMap ? 2 : 3,
          opacity: 0.85,
          dashArray: '10, 10',
          smoothFactor: isMobileMap ? 2.5 : 1.5, // simplifikasi geometri → render lebih cepat
          renderer: cableRenderer, // null = default SVG (desktop); canvas saat mobile
          className: _animateCable ? 'flowing-line' : ''
        }).addTo(map);

        polyline.on('click', (e) => {
          if (currentEditingPolyline === polyline) {
             L.DomEvent.stopPropagation(e);
          }
        });
      }

      // Customer Marker Icon with Clean Floating Name
      const onuIcon = buildOnuIcon(cust);

      const marker = L.marker([lat, lng], { icon: onuIcon });
      if (onuCluster) onuCluster.addLayer(marker); else marker.addTo(map);

      // Popup dibangun LAZILY saat dibuka (hemat CPU/RAM saat ratusan marker — penting di mobile/PWA)
      marker.bindPopup(function () { return buildCustomerPopupHtml(cust); }, { maxWidth: 340, minWidth: 260 });

      marker.on('popupopen', () => startCustomerTrafficPopup(cust.id));
      marker.on('popupclose', () => stopCustomerTrafficPopup(cust.id));

      customerMap[cust.id] = {
        marker,
        data: cust,
        polyline
      };
    }
  });

  // ─── SEARCH & AUTOCOMPLETE LOGIC ──────────────────────────────────────────
  const searchInput = document.getElementById('mapGlobalSearch');
  const searchDropdown = document.getElementById('mapSearchDropdown');
  const resultsList = document.getElementById('msResultsList');
  const resultsCount = document.getElementById('msHeaderCount');
  const clearBtn = document.getElementById('mapSearchClearBtn');
  let selectedSearchIndex = -1;
  let currentSearchResults = [];

  function highlightMatch(text, query) {
    if (!text) return '';
    if (!query) return escapeHtml(text);
    const escaped = escapeHtml(text);
    const qEsc = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const regex = new RegExp(`(${qEsc})`, 'gi');
    return escaped.replace(regex, '<mark>$1</mark>');
  }

  function doMapSearch(query) {
    const q = (query || '').trim().toLowerCase();
    if (!q) {
      searchDropdown.classList.remove('active');
      clearBtn.style.display = 'none';
      currentSearchResults = [];
      selectedSearchIndex = -1;
      return;
    }

    clearBtn.style.display = 'block';

    const matchedCustomers = customers.filter(c => {
      return (
        String(c.name || '').toLowerCase().includes(q) ||
        String(c.customer_code || '').toLowerCase().includes(q) ||
        String(c.pppoe_username || '').toLowerCase().includes(q) ||
        String(c.phone || '').toLowerCase().includes(q) ||
        String(c.genieacs_tag || '').toLowerCase().includes(q) ||
        String(c.address || '').toLowerCase().includes(q) ||
        String(c.area || '').toLowerCase().includes(q) ||
        String(c.package_name || '').toLowerCase().includes(q) ||
        String(c.odp_name || '').toLowerCase().includes(q)
      );
    });

    const matchedOdps = odps.filter(o => {
      return (
        String(o.name || '').toLowerCase().includes(q) ||
        String(o.description || '').toLowerCase().includes(q)
      );
    });

    currentSearchResults = [
      ...matchedCustomers.map(c => ({ type: 'customer', data: c })),
      ...matchedOdps.map(o => ({ type: 'odp', data: o }))
    ];

    selectedSearchIndex = -1;
    resultsCount.textContent = `${currentSearchResults.length} Ditemukan`;

    if (currentSearchResults.length === 0) {
      resultsList.innerHTML = `
        <div class="ms-empty">
          <i class="bi bi-search" style="font-size: 24px; color: #cbd5e1; display: block; margin-bottom: 6px;"></i>
          Tidak ditemukan data untuk "<strong>${escapeHtml(query)}</strong>"
        </div>
      `;
    } else {
      let html = '';
      currentSearchResults.slice(0, 30).forEach((item, index) => {
        if (item.type === 'customer') {
          const c = item.data;
          const isActive = c.status === 'active';
          const hasGps = Boolean(c.lat && c.lng);
          html += `
            <div class="ms-item" data-index="${index}" onclick="selectSearchResult(${index})">
              <div class="ms-item-icon ${isActive ? 'active' : 'suspended'}">
                <i class="bi bi-router-fill"></i>
              </div>
              <div class="ms-item-info">
                <div class="ms-item-name">
                  <span>${highlightMatch(c.name, query)}</span>
                  ${!hasGps ? '<span style="color:#ef4444; font-size:10px; font-weight:700;"><i class="bi bi-exclamation-triangle"></i> <%= t('admin.map.no_gps','Tanpa GPS') %></span>' : ''}
                </div>
                <div class="ms-item-meta">
                  ${c.pppoe_username ? `<span>PPPoE: ${highlightMatch(c.pppoe_username, query)}</span> • ` : ''}
                  ${c.phone ? `<span>HP: ${highlightMatch(c.phone, query)}</span> • ` : ''}
                  ${c.odp_name ? `<span>ODP: ${highlightMatch(c.odp_name, query)}</span> • ` : ''}
                  <span>${escapeHtml(c.address || c.package_name || '-')}</span>
                </div>
              </div>
              <span class="ms-item-badge ${isActive ? 'ms-badge-active' : 'ms-badge-suspended'}">
                ${isActive ? 'Aktif' : 'Isolir'}
              </span>
            </div>
          `;
        } else {
          const o = item.data;
          html += `
            <div class="ms-item" data-index="${index}" onclick="selectSearchResult(${index})">
              <div class="ms-item-icon odp">
                <i class="bi bi-box-seam-fill"></i>
              </div>
              <div class="ms-item-info">
                <div class="ms-item-name">
                  <span>${highlightMatch(o.name, query)}</span>
                  <span style="font-size: 10px; color: #b45309; font-weight: 700;">(ODP Box)</span>
                </div>
                <div class="ms-item-meta">${highlightMatch(o.description || 'Titik Distribusi ODP', query)}</div>
              </div>
              <span class="ms-item-badge ms-badge-odp">ODP</span>
            </div>
          `;
        }
      });
      resultsList.innerHTML = html;
    }

    searchDropdown.classList.add('active');
  }

  function clearMapSearch() {
    searchInput.value = '';
    doMapSearch('');
    searchInput.focus();
  }

  function selectSearchResult(index) {
    if (!currentSearchResults[index]) return;
    const item = currentSearchResults[index];
    searchDropdown.classList.remove('active');

    if (item.type === 'customer') {
      focusCustomer(item.data.id);
    } else {
      focusOdp(item.data.id);
    }
  }

  // Keyboard navigation for search results
  searchInput.addEventListener('input', (e) => doMapSearch(e.target.value));
  searchInput.addEventListener('keydown', (e) => {
    if (!searchDropdown.classList.contains('active')) return;
    const items = resultsList.querySelectorAll('.ms-item');
    if (items.length === 0) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      selectedSearchIndex = (selectedSearchIndex + 1) % items.length;
      updateSearchSelection(items);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      selectedSearchIndex = (selectedSearchIndex - 1 + items.length) % items.length;
      updateSearchSelection(items);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (selectedSearchIndex >= 0 && selectedSearchIndex < items.length) {
        selectSearchResult(selectedSearchIndex);
      } else if (items.length > 0) {
        selectSearchResult(0);
      }
    } else if (e.key === 'Escape') {
      searchDropdown.classList.remove('active');
    }
  });

  function updateSearchSelection(items) {
    items.forEach((it, idx) => {
      if (idx === selectedSearchIndex) {
        it.classList.add('selected');
        it.scrollIntoView({ block: 'nearest' });
      } else {
        it.classList.remove('selected');
      }
    });
  }

  // Global hotkey: Ctrl+K or / to search
  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey && e.key.toLowerCase() === 'k') || (e.key === '/' && document.activeElement !== searchInput && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA')) {
      e.preventDefault();
      searchInput.focus();
      searchInput.select();
    }
  });

  // Close search dropdown when clicking outside
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.map-search-box')) {
      searchDropdown.classList.remove('active');
    }
  });

  // ─── FOCUS ACTIONS ────────────────────────────────────────────────────────
  function focusCustomer(id) {
    const entry = customerMap[id];
    if (!entry) {
      const c = customers.find(x => x.id === id);
      if (c && (!c.lat || !c.lng)) {
        alert(`Pelanggan "${c.name}" belum memiliki koordinat GPS.`);
      }
      return;
    }

    const { marker, data } = entry;
    const lat = parseFloat(data.lat);
    const lng = parseFloat(data.lng);

    map.flyTo([lat, lng], 18, { duration: 1 });

    setTimeout(() => {
      marker.openPopup();
      const node = document.getElementById(`onu-node-${id}`);
      if (node) {
        node.classList.add('marker-pulse-highlight');
        setTimeout(() => node.classList.remove('marker-pulse-highlight'), 2500);
      }
    }, 800);
  }

  function focusOdp(id) {
    const entry = odpMap[id];
    if (!entry) return;

    const { marker, coord } = entry;
    map.flyTo(coord, 18, { duration: 1 });

    setTimeout(() => {
      marker.openPopup();
      const node = document.getElementById(`odp-node-${id}`);
      if (node) {
        node.classList.add('marker-pulse-highlight');
        setTimeout(() => node.classList.remove('marker-pulse-highlight'), 2500);
      }
    }, 800);
  }

  function editOdpFromBtn(btn) {
    if (!btn || !btn.dataset) return;
    const odpId = Number(btn.dataset.odpId);
    const found = odps.find(o => Number(o.id) === odpId);
    if (found) editOdp(found);
  }

  function deleteOdpFromBtn(btn) {
    if (!btn || !btn.dataset) return;
    const odpId = btn.dataset.odpId;
    if (confirm('Apakah Anda yakin ingin menghapus ODP ini?')) {
      const form = document.createElement('form');
