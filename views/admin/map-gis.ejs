  // ── LAYER TOGGLE HANDLER ─────────────────────────────────────────────────
  function toggleLayerMenu() {
    document.getElementById('gisLayersMenu').classList.toggle('hidden');
  }

  // Close layer menu on outside click
  document.addEventListener('click', (e) => {
    if (!e.target.closest('#btnToggleLayers') && !e.target.closest('#gisLayersMenu')) {
      document.getElementById('gisLayersMenu')?.classList.add('hidden');
    }
  });

  function toggleLayerVisibility(layerKey) {
    if (layerKey === 'server') {
      const chk = document.getElementById('chkLayerServer').checked;
      chk ? groupServer.addTo(map) : map.removeLayer(groupServer);
    } else if (layerKey === 'odc') {
      const chk = document.getElementById('chkLayerOdc').checked;
      chk ? groupOdc.addTo(map) : map.removeLayer(groupOdc);
    } else if (layerKey === 'odp') {
      const chk = document.getElementById('chkLayerOdp').checked;
      chk ? groupOdp.addTo(map) : map.removeLayer(groupOdp);
    } else if (layerKey === 'htb') {
      const chk = document.getElementById('chkLayerHtb').checked;
      chk ? groupHtb.addTo(map) : map.removeLayer(groupHtb);
    } else if (layerKey === 'customer') {
      const chk = document.getElementById('chkLayerCust').checked;
      chk ? groupCustomer.addTo(map) : map.removeLayer(groupCustomer);
    } else if (layerKey === 'cables') {
      const chk = document.getElementById('chkLayerCables').checked;
      chk ? groupCables.addTo(map) : map.removeLayer(groupCables);
    } else if (layerKey === 'radius') {
      const chk = document.getElementById('chkLayerRadius').checked;
      chk ? groupRadius.addTo(map) : map.removeLayer(groupRadius);
    }
  }

  // ── SEARCH & ZOOM TO TARGET ──────────────────────────────────────────────
  function handleGisSearch(val) {
    const q = val.toLowerCase().trim();
    const dropdown = document.getElementById('gisSearchDropdown');
    const clearBtn = document.getElementById('clearGisSearchBtn');
    clearBtn.classList.toggle('hidden', q.length === 0);

    if (q.length < 2) {
      dropdown.classList.add('hidden');
      dropdown.innerHTML = '';
      return;
    }

    const results = [];
    Object.keys(markerRegistry).forEach(key => {
      const item = markerRegistry[key];
      const name = (item.data.name || item.data.title || '').toLowerCase();
      const extra = (item.data.pppoe_username || item.data.host || item.data.description || '').toLowerCase();
      if (name.includes(q) || extra.includes(q)) {
        results.push(item);
      }
    });

    if (results.length === 0) {
      dropdown.innerHTML = `<div class="p-3 text-center text-slate-500 italic">Tidak ditemukan titik "${val}"</div>`;
      dropdown.classList.remove('hidden');
      return;
    }

    dropdown.innerHTML = '';
    results.slice(0, 8).forEach(res => {
      const div = document.createElement('div');
      div.className = 'p-2.5 hover:bg-slate-800/80 cursor-pointer flex items-center justify-between transition';
      div.innerHTML = `
        <div>
          <div class="font-bold text-white">${res.data.name || res.data.title}</div>
          <div class="text-[10px] text-slate-400 capitalize">${res.type} • ${res.data.host || res.data.pppoe_username || ''}</div>
        </div>
        <i class="bi bi-arrow-right text-slate-500 text-xs"></i>
      `;
      div.onclick = () => {
        dropdown.classList.add('hidden');
        map.flyTo(res.latlng, 18, { animate: true, duration: 1.2 });
        setTimeout(() => { res.marker.openPopup(); }, 1300);
      };
      dropdown.appendChild(div);
    });

    dropdown.classList.remove('hidden');
  }

  function clearGisSearch() {
    const inp = document.getElementById('gisSearchInp');
    inp.value = '';
    document.getElementById('gisSearchDropdown').classList.add('hidden');
    document.getElementById('clearGisSearchBtn').classList.add('hidden');
  }

  function resetMapCenter() {
    map.flyTo(DEFAULT_MAP_CENTER, DEFAULT_ZOOM, { animate: true, duration: 1.0 });
  }

  // ── MEASUREMENT RULER TOOL ───────────────────────────────────────────────
  let isRulerActive = false;
  let rulerPoints = [];
  let rulerLine = null;
  let rulerMarkers = [];

  function toggleRulerTool() {
    isRulerActive = !isRulerActive;
    const btn = document.getElementById('btnRulerTool');
    const hud = document.getElementById('rulerHudBox');

    if (isRulerActive) {
      btn.className = 'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-sky-600 text-white border border-sky-500 text-xs font-semibold shadow-md transition';
      hud.classList.remove('hidden');
      map.getContainer().style.cursor = 'crosshair';
      clearMeasurement();
    } else {
      btn.className = 'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 hover:text-white text-xs font-semibold transition';
      hud.classList.add('hidden');
      map.getContainer().style.cursor = '';
      clearMeasurement();
    }
  }

  map.on('click', function(e) {
    if (!isRulerActive) return;

    rulerPoints.push(e.latlng);

    const m = L.circleMarker(e.latlng, {
      radius: 5,
      color: '#38BDF8',
      fillColor: '#FFFFFF',
      fillOpacity: 1
    }).addTo(map);
    rulerMarkers.push(m);

    if (rulerPoints.length > 1) {
      if (rulerLine) map.removeLayer(rulerLine);
      rulerLine = L.polyline(rulerPoints, {
        color: '#38BDF8',
        weight: 3,
        dashArray: '6, 6'
      }).addTo(map);

      // Compute total distance
      let totalMeters = 0;
      for (let i = 0; i < rulerPoints.length - 1; i++) {
        totalMeters += rulerPoints[i].distanceTo(rulerPoints[i + 1]);
      }

      const distText = totalMeters >= 1000 
        ? `${(totalMeters / 1000).toFixed(2)} km` 
        : `${Math.round(totalMeters)} meter`;
      document.getElementById('rulerDistanceText').textContent = distText;
    }
  });

  function clearMeasurement() {
    rulerPoints = [];
    if (rulerLine) {
      map.removeLayer(rulerLine);
      rulerLine = null;
    }
    rulerMarkers.forEach(m => map.removeLayer(m));
    rulerMarkers = [];
    document.getElementById('rulerDistanceText').textContent = '0 m';
  }

  // ── INITIALIZE ON LOAD ───────────────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', () => {
    populateGisNetwork();

    // Check query params (e.g. ?focus=odp&id=2)
    const urlParams = new URLSearchParams(window.location.search);
    const focusType = urlParams.get('focus');
    const focusId = urlParams.get('id');

    if (focusType && focusId) {
      const key = `${focusType}-${focusId}`;
      if (markerRegistry[key]) {
        setTimeout(() => {
          map.flyTo(markerRegistry[key].latlng, 18, { animate: true, duration: 1.2 });
          setTimeout(() => { markerRegistry[key].marker.openPopup(); }, 1300);
        }, 300);
      }
    }
  });
</script>

</body>
</html>
