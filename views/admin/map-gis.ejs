          <div>
            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">${d.type}</div>
            <div class="font-bold text-white text-sm">${d.title}</div>
          </div>
          <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase ${isOffline ? 'bg-rose-500/20 text-rose-300 border border-rose-500/30' : 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30'}">
            ${d.status || 'Active'}
          </span>
