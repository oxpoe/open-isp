      <div class="p-3.5 space-y-2 text-xs font-sans max-w-xs">
        <div class="flex items-center justify-between gap-2 border-b border-slate-700/80 pb-2">
          <div>
            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider"><%= t('common.customer','Pelanggan') %></div>
            <div class="font-bold text-white text-sm">${c.name}</div>
          </div>
          <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase ${c.status === 'active' ? 'bg-emerald-500/20 text-emerald-300' : 'bg-rose-500/20 text-rose-300'}">
