                <div class="wifi-row">
                  <div class="wifi-ico"><i class="ph-bold ph-wifi-high"></i></div>
                  <div class="wifi-meta">
                    <p class="wifi-label"><%= t('pwa.net.ssid','Nama WiFi (SSID)') %></p>
                    <p class="wifi-val" id="wifi-ssid"><%= portal.ssid %></p>
                  </div>
                </div>
                <div class="wifi-row">
                  <div class="wifi-ico"><i class="ph-fill ph-lock-key"></i></div>
                  <div class="wifi-meta">
                    <p class="wifi-label"><%= t('pwa.net.f_password','Password') %></p>
                    <p class="wifi-val" id="wifi-pwd">********</p>
                  </div>
                </div>
              </div>


              <div class="flex gap-3">
                <button onclick="confirmRestartModem()" class="btn-ghost press flex-1 py-3 text-sm flex items-center justify-center gap-2">
                  <i class="ph ph-power"></i><%= t('pwa.net.restart_modem','Restart Modem') %></button>
                <button onclick="openSettingModal()" class="btn-lime press flex-1 py-3 text-sm flex items-center justify-center gap-2">
                  <i class="ph ph-gear-six"></i><%= t('pwa.account.settings','Setting') %></button>
              </div>
            </div>
          </div>

          <!-- Connected Devices -->
          <div>
            <div class="flex items-center justify-between mb-3 px-1">
