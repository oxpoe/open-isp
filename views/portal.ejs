            <div class="flex items-start justify-between mb-3">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-[12px] flex items-center justify-center" style="background:var(--lime-dim);border:1px solid var(--lime-border);">
                  <i class="ph-fill ph-link text-xl" style="color:var(--lime);"></i>
                </div>
                <div>
                  <p class="text-[10px] font-semibold uppercase tracking-wider" style="color:var(--muted);"><%= t('pwa.net.f_pppoe','Koneksi PPPoE') %></p>
                  <p id="pppoe-user" class="text-sm font-bold" style="font-family:'Space Grotesk',sans-serif;color:var(--text);"><%= portal.pppoeUser %></p>
                </div>
              </div>
              <span class="badge-online<%= portal.pppoeOnline ? '' : ' badge-offline' %>" id="pppoe-badge"><span class="dot"></span><%= portal.pppoeOnline ? 'Online' : 'Offline' %></span>
            </div>



            <!-- Tombol Reconnect PPPoE — MERAH + konfirmasi -->
            <button onclick="confirmReconnect()" class="btn-danger-soft press w-full py-3 text-sm flex items-center justify-center gap-2" id="pppoe-btn"<%= portal.pppoeOnline ? '' : ' disabled style="opacity:.45;filter:grayscale(.5);cursor:not-allowed"' %>>
              <i class="ph-bold ph-arrow-clockwise text-base"></i> <%= portal.pppoeOnline ? 'Reconnect PPPoE' : 'PPPoE Offline' %>
            </button>
            <% if (!portal.pppoeOnline) { %><p class="text-[10px] mt-2 text-center" style="color:var(--muted-2);"><%= t('pwa.net.pppoe_off','Koneksi PPPoE tidak terdeteksi — tombol dinonaktifkan.') %></p><% } %>
          </div>

          <!-- ONT / MODEM CARD -->
