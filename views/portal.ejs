            <div class="relative z-10 p-5">
              <div class="flex items-center justify-between mb-5 gap-2">
                <div class="flex items-center gap-3 min-w-0">
                  <div class="w-12 h-12 rounded-[14px] flex items-center justify-center flex-shrink-0" style="background:var(--surface-2);border:1px solid var(--border);">
                    <i class="ph-fill ph-router text-2xl" style="color:var(--text);"></i>
                  </div>
                  <div class="min-w-0">
                    <h3 id="onu-model" class="font-bold text-sm truncate" style="font-family:'Space Grotesk',sans-serif;color:var(--text);"><%= portal.onuModel %></h3>
                    <p class="text-[11px] truncate" style="color:var(--muted);"><%= t('pwa.net.onu_primary','ONU Utama · GPON') %></p>
                  </div>
                </div>
                <div class="flex items-center gap-2 flex-shrink-0">
                  <span class="badge-online<%= portal.onuOnline ? '' : ' badge-offline' %>" id="onu-badge"><span class="dot"></span><%= portal.onuOnline ? 'Online' : 'Offline' %></span>
                </div>
              </div>

              <div class="flex justify-center my-4">
                <div class="speed-ring">
                  <svg width="120" height="120" viewBox="0 0 120 120">
                    <circle class="ring-track" cx="60" cy="60" r="54"/>
                    <circle class="ring-fill" cx="60" cy="60" r="54" id="speed-ring-circle"/>
                  </svg>
                  <div class="inner">
                    <p class="text-2xl font-black" style="font-family:'Space Grotesk',sans-serif;color:var(--lime);" id="speed-display"><%= portal.speedDown %></p>
                    <p class="text-[10px] font-medium" style="color:var(--muted);">Mbps</p>
                  </div>
                </div>
              </div>

              <button onclick="pollOnu(this)" class="press mx-auto flex mb-4 items-center gap-1.5 px-3 h-8 rounded-full" style="background:var(--surface-2);border:1px solid var(--border);color:var(--muted);font-size:11px;font-weight:600;" aria-label="<%= t('pwa.net.poll_onu','Poll ONU') %>">
                <i class="ph-bold ph-arrows-clockwise text-sm"></i><span><%= t('pwa.net.poll_onu','Poll ONU') %></span>
              </button>
              <div class="grid grid-cols-2 gap-px rounded-[14px] overflow-hidden" style="background:var(--border);margin-bottom:16px;">
                <div class="p-3" style="background:var(--surface-2);">
                  <p class="text-[10px] font-medium mb-0.5" style="color:var(--muted);"><%= t('pwa.net.f_ip_local','IP Lokal') %></p>
                  <p id="onu-ip" class="text-sm font-semibold" style="color:var(--text);"><%= portal.onuLocalIp %></p>
                </div>
                <div class="p-3" style="background:var(--surface-2);">
                  <p class="text-[10px] font-medium mb-0.5" style="color:var(--muted);"><%= t('pwa.net.f_uptime','Uptime') %></p>
                  <p id="onu-uptime" class="text-sm font-semibold" style="color:var(--text);"><%= portal.onuUptime %></p>
                </div>
                <div class="p-3" style="background:var(--surface-2);">
                  <p class="text-[10px] font-medium mb-0.5" style="color:var(--muted);"><%= t('pwa.net.f_serial_no','Serial Number') %></p>
                  <p id="onu-serial" class="text-sm font-semibold" style="color:var(--text);word-break:break-all;"><%= portal.serialNumber %></p>
                </div>
                <div class="p-3" style="background:var(--surface-2);">
                  <p class="text-[10px] font-medium mb-0.5" style="color:var(--muted);"><%= t('pwa.net.f_rx','Redaman (Rx)') %></p>
                  <p id="onu-rx" class="text-sm font-semibold" style="color:var(--lime);"><%= portal.rxPower %></p>
                </div>
              </div>

              <!-- WiFi panel: tombol salin SSID & password dihapus -->
