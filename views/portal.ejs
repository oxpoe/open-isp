        <!-- BILLING -->
        <section id="tab-billing" class="tab-content p-4 md:p-6 space-y-5">
          <div class="flex items-center justify-between px-1">
            <div class="flex items-center gap-2">
              <button onclick="switchTab('home')" class="press w-9 h-9 rounded-full flex items-center justify-center" style="background:var(--surface-2);border:1px solid var(--border);color:var(--text);" aria-label="<%= t('pwa.nav.back_home','Kembali ke Beranda') %>"><i class="bi bi-chevron-left"></i></button>
              <h2 class="text-xl font-bold" style="font-family:'Space Grotesk',sans-serif;"><%= t('pwa.nav.billing','Tagihan') %></h2>
            </div>
            <span class="text-xs font-bold px-2.5 py-1 rounded-full" style="<%= portal.bill ? 'background:rgba(251,191,36,0.12);color:#FBBF24;border:1px solid rgba(251,191,36,0.2);' : 'background:rgba(173,255,47,0.12);color:var(--lime);border:1px solid var(--lime-border);' %>"><%= portal.bill ? t('pwa.status.unpaid','BELUM BAYAR') : t('pwa.status.paid','LUNAS') %></span>
          </div>

          <div class="relative rounded-[24px] overflow-hidden noise" style="background:var(--surface);border:1px solid var(--lime-border);box-shadow:0 20px 50px -26px rgba(173,255,47,.5);">
            <div style="position:absolute;top:-60px;left:50%;transform:translateX(-50%);width:240px;height:120px;background:radial-gradient(ellipse,rgba(173,255,47,0.08),transparent 70%);pointer-events:none;"></div>
            <div class="relative z-10 text-center p-8">
              <p class="text-xs font-medium mb-2" style="color:var(--muted);"><%= portal.bill ? (t('pwa.total','Total') + ' ' + portal.bill.label + ' ' + t('pwa.billing.total_unique','(termasuk kode unik)')) : t('pwa.home.no_bill','Tidak ada tagihan') %></p>
              <h1 class="text-5xl font-black mb-2" style="font-family:'Space Grotesk',sans-serif;color:var(--text);"><%= portal.bill ? portal.bill.amountUnique : 'Rp 0' %></h1>
              <% if (portal.bill && portal.bill.uniqueCode) { %>
              <p class="text-[11px] mb-2" style="color:var(--muted);"><%= t('pwa.billing.nominal_note_pre','Harga paket') %> <%= portal.bill.amount %> <%= t('pwa.billing.nominal_note_mid','+ kode unik') %> <b style="color:var(--lime);"><%= portal.bill.uniqueCode %></b></p>
              <% } %>
              <p class="text-xs mb-6" style="color:<%= portal.bill && portal.bill.overdue ? '#EF4444' : 'var(--muted)' %>;"><%= portal.bill ? portal.bill.dueFull : t('pwa.thanks','Terima kasih') %></p>
              <button class="btn-lime press w-full py-4 text-base flex items-center justify-center gap-2" onclick="payWith('Bayar Sekarang')">
                <i class="ph-fill ph-credit-card text-lg"></i><%= t('pwa.billing.pay_now','Bayar Sekarang') %>
              </button>
              <p class="text-[11px] mt-3" style="color:var(--muted);"><%= t('pwa.billing.methods','Metode pembayaran: QRIS · Transfer Bank · E-Wallet') %></p>
            </div>
          </div>

          <div class="p-4 rounded-[18px]" style="background:var(--surface);border:1px solid var(--border);">
            <p class="text-xs font-semibold mb-3" style="color:var(--muted);letter-spacing:0.06em;text-transform:uppercase;"><%= t('pwa.billing.pkg_detail','Detail Paket') %></p>
            <div class="space-y-2">
              <div class="flex justify-between">
                <span class="text-sm" style="color:var(--muted);"><%= portal.detail.name %></span>
                <span class="text-sm font-semibold" style="color:var(--text);"><%= portal.detail.amount %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm" style="color:var(--muted);"><%= t('pwa.field.period','Periode') %></span>
                <span class="text-sm font-semibold" style="color:var(--text);"><%= portal.detail.period %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm" style="color:var(--muted);"><%= t('common.status','Status') %></span>
                <span class="text-sm font-semibold" style="color:<%= portal.detail.paid ? 'var(--lime)' : '#FBBF24' %>;"><%= portal.detail.status %></span>
              </div>
            </div>
          </div>

          <% if (portal.refInvoiceId) { %>
          <div>
            <p class="text-xs font-semibold mb-3 px-1" style="color:var(--muted);letter-spacing:0.06em;text-transform:uppercase;"><%= t('pwa.billing.actions','Aksi Tagihan') %></p>
            <div class="grid grid-cols-1 gap-3">
              <button type="button" onclick="downloadInvoicePdf(<%= portal.refInvoiceId %>, '<%= portal.code %>')" class="btn-lime press py-3.5 text-sm flex items-center justify-center gap-2" style="border-radius:14px;"><i class="bi bi-file-earmark-pdf-fill"></i><%= t('pwa.billing.download_pdf','Download Tagihan (PDF)') %></button>
            </div>
          </div>
          <% } %>

          <div>
            <p class="text-xs font-semibold mb-3 px-1" style="color:var(--muted);letter-spacing:0.06em;text-transform:uppercase;"><%= t('pwa.billing.history','Riwayat Pembayaran') %></p>
            <div id="historyList" class="rounded-[18px] overflow-hidden" style="background:var(--surface);border:1px solid var(--border);">
<button class="press w-full py-4 text-sm font-semibold text-center" style="color:var(--lime);"><%= t('pwa.billing.view_history','Lihat Semua Riwayat') %><i class="ph ph-caret-right text-sm"></i>
              </button>
            </div>
          </div>
        </section>

        <!-- SPEED TEST -->
        <section id="tab-speedtest" class="tab-content p-4 md:p-6 space-y-5">
          <div class="flex items-center gap-2 px-1">
            <button onclick="switchTab('home')" class="press w-9 h-9 rounded-full flex items-center justify-center" style="background:var(--surface-2);border:1px solid var(--border);color:var(--text);" aria-label="<%= t('pwa.nav.back_home','Kembali ke Beranda') %>"><i class="bi bi-chevron-left"></i></button>
            <div><h2 class="text-xl font-bold" style="font-family:'Space Grotesk',sans-serif;">Speed Test</h2>
            <p class="text-xs mt-1" style="color:var(--muted);"><%= t('pwa.speedtest.subtitle','Ukur kecepatan internet Anda') %></p></div>
          </div>

          <% if (portal.speedtestUrl) { %>
          <% if ((portal.speedtestMode || 'iframe') === 'tab') { %>
          <div class="p-6 rounded-[24px] text-center" style="background:var(--surface);border:1px solid var(--border);">
            <i class="bi bi-speedometer2" style="font-size:38px;color:var(--lime);"></i>
            <p class="text-sm font-semibold mt-2" style="color:var(--text);"><%= t('pwa.speedtest.open_title','Buka Speed Test') %></p>
            <p class="text-xs mt-1" style="color:var(--muted);"><%= t('pwa.speedtest.open_hint','Speed test akan dibuka di jendela baru. Tuntaskan pengukuran, lalu kembali ke aplikasi.') %></p>
            <a class="btn-lime press inline-flex items-center gap-2 mt-4" style="padding:13px 18px;border-radius:14px;font-size:14px;text-decoration:none;" href="<%= portal.speedtestUrl %>" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right"></i> <%= t('pwa.speedtest.open_btn','Mulai Speed Test') %></a>
          </div>
          <% } else { %>
          <div class="flex items-center justify-between gap-2 px-1">
            <p class="text-xs font-semibold" style="color:var(--muted);"><%= t('pwa.speedtest.provider','Penyedia Speed Test') %></p>
            <button type="button" onclick="reloadSpeedtest()" class="press inline-flex items-center gap-1.5" style="padding:8px 12px;border-radius:11px;background:var(--surface-2);border:1px solid var(--border);color:var(--text);font-size:12px;font-weight:700;"><i class="bi bi-arrow-clockwise"></i> <%= t('common.reload','Muat Ulang') %></button>
          </div>
          <div class="relative rounded-[24px] overflow-hidden" style="background:var(--surface);border:1px solid var(--border);">
            <iframe id="speedtestFrame" data-base="<%= portal.speedtestUrl %>" src="<%= portal.speedtestUrl %>" title="Speed Test" style="width:100%;height:74vh;border:0;display:block;background:var(--surface);" loading="lazy" referrerpolicy="no-referrer"></iframe>
          </div>
          <% } %>
          <div class="alert-box" style="background:var(--lime-dim);border:1px solid var(--lime-border);">
            <i class="ph-fill ph-info text-xl flex-shrink-0" style="color:var(--lime);margin-top:1px;"></i>
            <div>
              <p class="text-sm font-semibold" style="color:var(--lime);"><%= t('pwa.speedtest.tips','Tips Speed Test') %></p>
              <p class="text-xs mt-0.5" style="color:var(--muted);"><%= t('pwa.speedtest.note','Untuk hasil akurat, tutup aplikasi lain yang menggunakan internet dan dekatkan perangkat ke router.') %></p>
            </div>
          </div>
          <div class="flex justify-center">
            <button type="button" onclick="clearAppCache()" class="press inline-flex items-center gap-2" style="padding:10px 14px;border-radius:12px;background:var(--surface-2);border:1px solid var(--border);color:var(--muted);font-size:12px;font-weight:700;"><i class="bi bi-trash3"></i> <%= t('pwa.speedtest.clear_cache','Bersihkan Cache') %></button>
          </div>
<% } else { %>
          <div class="p-7 rounded-[24px] text-center" style="background:var(--surface);border:1px dashed var(--border);">
            <img src="<%= brandLogo %>" alt="<%= brandName %>" style="height:56px;max-width:70%;object-fit:contain;margin:0 auto 12px;display:block;" onerror="this.style.display='none'">
            <p class="text-sm font-semibold" style="color:var(--text);"><%= t('pwa.speedtest.not_set','Speedtest belum di setup') %></p>
            <p class="text-xs mt-1" style="color:var(--muted);"><%= t('pwa.speedtest.not_set_hint','Admin belum mengatur Link Speed Test. Silakan hubungi admin.') %></p>
            <a class="btn-ghost press inline-flex items-center gap-2 mt-4" style="padding:11px 16px;border-radius:12px;font-size:13px;" href="https://wa.me/<%= portal.waPhone %>" target="_blank" rel="noopener"><i class="bi bi-whatsapp" style="color:#22C55E;"></i><%= t('pwa.speedtest.contact_admin','Hubungi Admin') %></a>
          </div>
<% } %>
        </section>

        <!-- NETWORK -->
        <section id="tab-network" class="tab-content p-4 md:p-6 space-y-5">
          <div class="flex items-center gap-2 px-1">
            <button onclick="switchTab('home')" class="press w-9 h-9 rounded-full flex items-center justify-center" style="background:var(--surface-2);border:1px solid var(--border);color:var(--text);" aria-label="<%= t('pwa.nav.back_home','Kembali ke Beranda') %>"><i class="bi bi-chevron-left"></i></button>
            <div><h2 class="text-xl font-bold" style="font-family:'Space Grotesk',sans-serif;"><%= t('pwa.nav.network','Jaringan') %></h2>
            <p class="text-xs mt-1" style="color:var(--muted);"><%= t('pwa.net.subtitle','Monitoring ONU & perangkat terhubung') %></p></div>
