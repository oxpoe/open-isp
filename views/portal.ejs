          <div class="nav-ico-wrap"><i class="ph-fill ph-house"></i></div>
          <span><%= t('common.home','Beranda') %></span>
        </button>
        <button onclick="switchTab('billing')" id="nav-m-billing" class="bottom-nav-item press">
          <div class="nav-ico-wrap"><i class="ph ph-receipt"></i></div>
          <span><%= t('pwa.nav.billing','Tagihan') %></span>
