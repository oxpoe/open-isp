            <div>
              <p class="text-sm font-semibold" id="net-alert-title" style="color:var(--c);"><%= t('pwa.net.maintenance','Pemeliharaan Jaringan') %></p>
              <p class="text-xs mt-0.5" id="net-alert-msg" style="color:var(--muted);"></p>
            </div>
          </div>
