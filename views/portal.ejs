    /* ═══════ PERBAIKAN ═══════ */
    nav.bottom-nav > div { width:100%; }
    .bottom-nav-item { overflow:hidden; padding:4px 2px; }
    .bottom-nav-item span { max-width:100%; overflow:hidden; text-overflow:ellipsis; font-size:10px; line-height:1.2; }
    body.preview-mobile nav.bottom-nav { left:0; right:0; bottom:0; width:100%; }
    @media (max-width:359px){ .bottom-nav-item span { font-size:9px; } }

    .avatar-init{display:flex;align-items:center;justify-content:center;border-radius:50%;
      background:linear-gradient(135deg,#ADFF2F,#7ECB0F);color:#0A0D14;font-family:'Space Grotesk',sans-serif;font-weight:700;letter-spacing:.02em}

    @media (max-width:767px){ .ambient-glow{display:none} }
    :focus-visible{outline:2px solid var(--lime);outline-offset:2px}
    button:focus:not(:focus-visible){outline:none}
    .st-center{width:160px}
    html.light .toast{background:rgba(255,255,255,0.94)}
    html.light .st-track,html.light .speed-ring .ring-track{stroke:rgba(0,0,0,0.08)}

    .qa-tile{background:var(--lime-dim);border:1px solid var(--lime-border);transition:border-color .2s}
    .qa-tile:hover{border-color:var(--lime)}
    .bill-card{position:relative;overflow:hidden;display:flex;align-items:center;justify-content:space-between;gap:12px;
      padding:14px 14px 14px 16px;border-radius:20px;color:#0A0D14;background:linear-gradient(135deg,#C9FF6B 0%,#ADFF2F 50%,#8EDB1C 100%);
      box-shadow:0 14px 32px -16px rgba(173,255,47,.55),inset 0 1px 0 rgba(255,255,255,.5)}
    .bill-card::before{content:'';position:absolute;right:-40px;top:-60px;width:150px;height:150px;border-radius:50%;
      background:radial-gradient(circle,rgba(255,255,255,.45),transparent 70%);pointer-events:none}
    .bill-label{font-size:11px;font-weight:600;opacity:.7}
    .bill-amount{font-family:'Space Grotesk',sans-serif;font-weight:800;font-size:26px;line-height:1.1;letter-spacing:-.02em;margin:1px 0 3px}
    .bill-meta{display:flex;align-items:center;gap:4px;font-size:11px;font-weight:600;opacity:.8;white-space:nowrap}
    .bill-cta{position:relative;z-index:1;flex-shrink:0;display:flex;align-items:center;gap:6px;padding:11px 16px;border-radius:13px;
      background:#0A0D14;color:#ADFF2F;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:14px}
    html.light .bill-card{box-shadow:0 14px 30px -18px rgba(98,160,9,.6),inset 0 1px 0 rgba(255,255,255,.5)}

    .busy-overlay{position:fixed;inset:0;z-index:600;display:flex;align-items:center;justify-content:center;
      background:rgba(5,7,14,.42);-webkit-backdrop-filter:blur(16px) saturate(1.2);backdrop-filter:blur(16px) saturate(1.2);
      opacity:0;visibility:hidden;pointer-events:none;transition:opacity .25s,visibility .25s}
    .busy-overlay.show{opacity:1;visibility:visible;pointer-events:none !important} /* FIX: overlay tidak boleh menelan klik */
    body.preview-mobile .busy-overlay{position:absolute}
    html.light .busy-overlay{background:rgba(240,242,248,.5)}
    .busy-panel{display:flex;flex-direction:column;align-items:center;gap:14px;min-width:210px;max-width:80%;padding:26px 28px 22px;
      border-radius:26px;background:var(--surface);border:1px solid var(--border);box-shadow:0 24px 60px -20px rgba(0,0,0,.6);
      transform:scale(.94);transition:transform .3s cubic-bezier(.2,.9,.3,1)}
    .busy-overlay.show .busy-panel{transform:scale(1)}
    .busy-ico{width:64px;height:64px;border-radius:50%;display:flex;align-items:center;justify-content:center;
      background:var(--lime-dim);border:1px solid var(--lime-border);color:var(--lime);font-size:32px;
      transition:background .2s,border-color .2s,color .2s}
    .busy-overlay.error .busy-ico{background:var(--red-dim);border-color:var(--red-border);color:var(--red)}
    .busy-spin{animation:spin .8s linear infinite}
    .busy-overlay.done .busy-ico i{animation:busyPop .45s cubic-bezier(.2,1.4,.4,1)}
    @keyframes busyPop{from{transform:scale(.3);opacity:0}to{transform:scale(1);opacity:1}}
    .busy-text{font-family:'Space Grotesk',sans-serif;font-weight:600;font-size:14px;text-align:center;color:var(--text)}

    .wifi-panel{background:var(--surface-2);border:1px solid var(--border);border-radius:16px;margin-bottom:16px;overflow:hidden}
    .wifi-row{display:flex;align-items:center;gap:12px;padding:12px 14px}
    .wifi-row + .wifi-row{border-top:1px solid var(--border)}
    .wifi-ico{width:36px;height:36px;border-radius:11px;display:flex;align-items:center;justify-content:center;flex-shrink:0;
      background:var(--lime-dim);border:1px solid var(--lime-border);color:var(--lime);font-size:18px}
    .wifi-meta{flex:1;min-width:0}
    .wifi-label{font-size:10px;font-weight:500;color:var(--muted);margin-bottom:2px}
    .wifi-val{font-family:'Space Grotesk',sans-serif;font-size:14px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .wifi-val.mask{letter-spacing:.2em}
    .wifi-actions{display:flex;gap:6px;flex-shrink:0}
    .wifi-btn{width:32px;height:32px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:15px;
      background:var(--surface);border:1px solid var(--border);color:var(--muted);transition:color .2s,border-color .2s}
    .wifi-btn:hover,.wifi-btn.copied{color:var(--lime);border-color:var(--lime-border)}

    .net-badge[data-state=normal],.net-alert[data-state=normal]{--c:var(--lime);--cd:var(--lime-dim);--cb:var(--lime-border)}
    .net-badge[data-state=maintenance],.net-alert[data-state=maintenance]{--c:#FBBF24;--cd:rgba(251,191,36,.1);--cb:rgba(251,191,36,.28)}
    .net-badge[data-state=outage],.net-alert[data-state=outage]{--c:#F87171;--cd:rgba(239,68,68,.1);--cb:rgba(239,68,68,.32)}
    .net-badge{display:inline-flex;align-items:center;gap:6px;height:30px;padding:0 11px;border-radius:99px;flex-shrink:0;white-space:nowrap;
      font-size:11px;font-weight:700;color:var(--c);background:var(--cd);border:1px solid var(--cb);cursor:pointer;transition:background .2s,color .2s,border-color .2s}
    .net-badge .dot{width:6px;height:6px;border-radius:50%;background:var(--c);box-shadow:0 0 5px var(--c);animation:netPulse 2s infinite}
    .net-badge[data-state=normal] .dot{animation:none}
    @keyframes netPulse{50%{opacity:.4}}
    .net-alert{background:var(--cd);border:1px solid var(--cb)}
    .net-alert[hidden]{display:none}
    .net-alert strong{color:var(--text)}
    .net-alert.flash{animation:alertFlash 1.4s ease 1}
    @keyframes alertFlash{0%,50%{box-shadow:0 0 0 0 var(--cb)}25%,75%{box-shadow:0 0 0 7px var(--cd)}100%{box-shadow:0 0 0 0 transparent}}
    #topbar{container-type:inline-size}
    @container (max-width:399px){.brand-word{display:none}}
  </style>
</head>
<body class="dark">

<div id="app-wrap" class="flex h-dvh w-full relative overflow-hidden" style="background:var(--bg)">

  <!-- Ambient blur glow — statis, murah di GPU -->
  <div class="ambient-glow ambient-glow-1"></div>
  <div class="ambient-glow ambient-glow-2"></div>

  <!-- SIDEBAR -->
  <aside class="desktop-only hidden md:flex flex-col w-64" style="background:var(--surface);border-right:1px solid var(--border);z-index:20;flex-shrink:0;">
    <div class="p-6 flex items-center gap-3">
      <div class="w-9 h-9 rounded-[11px] flex items-center justify-center" style="background:var(--lime-dim);border:1px solid var(--lime-border);overflow:hidden;">
        <img src="<%= brandLogo %>" alt="<%= brandName %>" style="width:100%;height:100%;object-fit:contain;padding:3px;" onerror="this.style.display='none';if(this.nextElementSibling)this.nextElementSibling.style.display=''"><i class="ph-bold ph-wifi-high" style="display:none;color:var(--lime);font-size:15px;"></i>
      </div>
      <div>
        <h1 class="font-bold text-base tracking-tight" style="font-family:'Space Grotesk',sans-serif;color:var(--text);">
          <% if (brandName === 'OPEN-ISP') { %>SKY<span style="color:var(--lime);">FIBER</span><% } else { %><%= brandName %><% } %>
        </h1>
        <p class="text-[10px]" style="color:var(--muted);margin-top:1px;"><%= t('pwa.title','Portal Pelanggan') %></p>
      </div>
    </div>
    <hr class="divider mx-4 mb-3">
    <nav class="flex-1 px-3 space-y-1 overflow-y-auto no-scrollbar">
      <button onclick="switchTab('home')" id="nav-d-home" class="nav-item active press">
        <i class="ph-fill ph-house nav-icon"></i><%= t('common.home','Beranda') %></button>
      <button onclick="switchTab('billing')" id="nav-d-billing" class="nav-item press">
        <i class="ph ph-receipt nav-icon"></i><%= t('pwa.nav.billing','Tagihan') %></button>
      <button onclick="switchTab('speedtest')" id="nav-d-speedtest" class="nav-item press">
        <i class="ph ph-gauge nav-icon"></i> Speed Test
      </button>
      <button onclick="switchTab('network')" id="nav-d-network" class="nav-item press">
        <i class="ph ph-wifi-high nav-icon"></i><%= t('pwa.nav.network','Jaringan') %></button>
      <button onclick="switchTab('profile')" id="nav-d-profile" class="nav-item press">
        <i class="ph ph-user-circle nav-icon"></i><%= t('pwa.nav.account','Akun') %></button>
    </nav>
    <div class="p-3 mt-auto" style="border-top:1px solid var(--border);">
      <div class="flex items-center gap-3 p-3 rounded-[14px] press cursor-pointer">
        <div class="avatar-ring" style="width:38px;height:38px;padding:2px;">
          <span class="avatar-init" style="width:34px;height:34px;font-size:13px;" role="img" aria-label="<%= portal.name %>"><%= portal.initials %></span>
        </div>
        <div style="flex:1;overflow:hidden;">
          <p class="text-sm font-semibold truncate" style="color:var(--text);"><%= portal.name %></p>
          <p class="text-[11px] truncate" style="color:var(--muted);"><%= portal.packageName %><%= portal.speedDown !== '-' ? ' · ' + portal.speedDown + ' Mbps' : '' %></p>
        </div>
        <i class="ph ph-caret-right text-sm" style="color:var(--muted-2);"></i>
      </div>
    </div>
  </aside>

  <!-- MAIN -->
  <main class="flex-1 flex flex-col h-full relative overflow-hidden" style="min-width:0;">

    <header id="topbar" class="pt-safe sticky top-0 z-30" style="background:rgba(10,13,20,0.72);backdrop-filter:blur(20px) saturate(1.6);-webkit-backdrop-filter:blur(20px) saturate(1.6);border-bottom:1px solid var(--border);">
      <div class="flex items-center justify-between px-4 md:px-6" style="height:56px;">
        <div class="flex mobile-only md:hidden items-center gap-2.5">
          <div class="w-8 h-8 rounded-[9px] flex items-center justify-center" style="background:var(--lime-dim);border:1px solid var(--lime-border);overflow:hidden;">
            <img src="<%= brandLogo %>" alt="<%= brandName %>" style="width:100%;height:100%;object-fit:contain;padding:3px;" onerror="this.style.display='none';if(this.nextElementSibling)this.nextElementSibling.style.display=''"><i class="ph-bold ph-wifi-high" style="display:none;color:var(--lime);font-size:15px;"></i>
          </div>
          <span class="brand-word font-bold text-base tracking-tight" style="font-family:'Space Grotesk',sans-serif;color:var(--text);">
            <% if (brandName === 'OPEN-ISP') { %>SKY<span style="color:var(--lime);">FIBER</span><% } else { %><%= brandName %><% } %>
          </span>
        </div>
        <div class="hidden md:block desktop-title">
          <h2 id="page-title" class="font-semibold text-base" style="font-family:'Space Grotesk',sans-serif;color:var(--text);"><%= t('common.home','Beranda') %></h2>
        </div>
        <div class="flex items-center gap-2 ml-auto">
          <button id="net-badge" class="net-badge press" data-state="<%= portal.netState %>" onclick="goToNetworkStatus()" aria-label="<%= t('pwa.net.status_aria','Status jaringan') %>">
            <span class="dot"></span><span id="net-badge-text"><%= t('pwa.net.maintenance_short','Perawatan') %></span>
          </button>
          <button onclick="toggleTheme()" class="mobile-only md:hidden press w-9 h-9 rounded-full flex items-center justify-center" style="color:var(--muted);" aria-label="<%= t('common.toggle_theme','Toggle tema') %>">
            <i class="ph-fill ph-moon text-lg" id="theme-icon-mobile"></i>
          </button>
          <button id="notif-bell" class="press relative w-9 h-9 rounded-full flex items-center justify-center" style="color:var(--muted);" aria-label="<%= t('pwa.notif.title','Notifikasi') %>" onclick="openNotifPanel()">
            <i class="ph-fill ph-bell text-lg" style="color:var(--text);"></i>
            <span class="notif-dot"<%= (portal.notifications && portal.notifications.length) ? '' : ' style="display:none"' %>></span>
          </button>
          <div class="mobile-only md:hidden avatar-ring" style="padding:2px;cursor:pointer;" onclick="switchTab('profile')">
            <span class="avatar-init" style="width:32px;height:32px;font-size:12px;" role="img" aria-label="<%= portal.name %>"><%= portal.initials %></span>
          </div>
        </div>
      </div>
    </header>

    <div id="scroll-area" class="flex-1 overflow-y-auto no-scrollbar scroll-pad">
      <div class="max-w-2xl md:max-w-3xl mx-auto w-full">

        <!-- HOME -->
        <section id="tab-home" class="tab-content active-tab tab-visible p-4 md:p-6 space-y-5">

          <!-- CREDIT CARD -->
          <div>
            <div class="cc">
              <div class="cc-orb cc-orb-1"></div>
              <div class="cc-orb cc-orb-2"></div>
              <div class="cc-arcs">
                <svg viewBox="0 0 400 252" preserveAspectRatio="none">
                  <defs>
                    <linearGradient id="arcGrad" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0%" stop-color="#ADFF2F" stop-opacity="0.4"/>
                      <stop offset="100%" stop-color="#ADFF2F" stop-opacity="0"/>
                    </linearGradient>
                  </defs>
                  <path d="M -20 220 Q 200 60 420 180" fill="none" stroke="url(#arcGrad)" stroke-width="1"/>
                  <path d="M -20 250 Q 200 90 420 210" fill="none" stroke="url(#arcGrad)" stroke-width="1" opacity="0.6"/>
                  <path d="M -20 280 Q 200 120 420 240" fill="none" stroke="url(#arcGrad)" stroke-width="1" opacity="0.3"/>
                </svg>
              </div>

              <div class="cc-content">
                <div class="cc-top">
                  <div class="cc-brand">
                    <div class="cc-brand-mark" style="overflow:hidden;">
                      <img src="<%= brandLogo %>" alt="<%= brandName %>" style="width:100%;height:100%;object-fit:contain;padding:2px;" onerror="this.style.display='none';if(this.nextElementSibling)this.nextElementSibling.style.display=''"><i class="ph-bold ph-wifi-high" style="display:none;font-size:11px;"></i>
                    </div>
                    <span style="color:#fff;"><% if (brandName === 'OPEN-ISP') { %>SKY<span>FIBER</span><% } else { %><%= brandName %><% } %></span>
                  </div>
                  <div class="cc-top-badges">
                    <span class="cc-status"><span class="dot"></span><%= portal.statusText %></span>
                    <span class="cc-tier"><%= portal.packageName %></span>
                  </div>
                </div>

                <div class="cc-identity">
                  <p class="cc-greet"><%= t('pwa.greeting','Selamat datang kembali') %></p>
                  <p class="cc-name"><%= portal.name %></p>
                </div>

                <div class="cc-chip-row">
                  <div class="cc-chip">
                    <span class="chip-line-1"></span>
                    <span class="chip-line-2"></span>
                  </div>
                  <div class="cc-id-wrap">
                    <span class="cc-id" id="customer-id"><%= portal.code %></span>
                    <button class="cc-copy" onclick="copyCustomerId(this)" title="<%= t('pwa.account.copy_id','Salin ID') %>" aria-label="<%= t('pwa.account.copy_id','Salin ID') %>">
                      <i class="ph-bold ph-copy"></i>
                    </button>
                  </div>
                </div>

                <div class="cc-footer">
                  <div class="cc-foot-block">
                    <span class="cc-label"><%= t('pwa.speed','Kecepatan') %></span>
                    <span class="cc-speed"><%= portal.speedDown %> <small>Mbps</small></span>
                  </div>
                  <div class="cc-foot-block" style="flex:1;">
                    <div class="cc-label-row">
                      <span class="cc-label"><%= t('pwa.active_period','Masa Aktif') %></span>
                      <span class="cc-label cc-lime"><%= portal.activeDaysText %></span>
                    </div>
                    <div class="cc-progress"><div class="cc-progress-fill" style="width:<%= portal.activePct %>%"></div></div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- TAGIHAN -->
          <div class="bill-card"<% if (portal.bill) { %> style="background:linear-gradient(135deg,#FCA5A5 0%,#EF4444 55%,#B91C1C 100%);color:#fff;box-shadow:0 14px 32px -16px rgba(239,68,68,.6),inset 0 1px 0 rgba(255,255,255,.35)"<% } %>>
            <div class="min-w-0 relative z-10">
              <p class="bill-label"><%= portal.bill ? portal.bill.label : t('pwa.home.no_bill','Tidak ada tagihan') %></p>
              <p class="bill-amount"><%= portal.bill ? portal.bill.amount : 'Rp 0' %></p>
              <p class="bill-meta"><i class="ph-fill <%= portal.bill ? 'ph-warning-circle' : 'ph-check-circle' %>"></i> <%= portal.bill ? portal.bill.metaText : t('pwa.home.paid','Lunas') %></p>
              <p class="bill-meta" style="margin-top:3px;opacity:.92;"><i class="bi bi-calendar-x"></i> <%= t('pwa.isolir','Isolir:') %> <%= portal.isolirText %></p>
            </div>
            <button onclick="switchTab('billing')" class="bill-cta press"><i class="ph-fill ph-credit-card"></i> <%= t('pwa.billing.quick','Bayar') %></button>
          </div>

          <!-- Promo -->
          <div class="swiper promoSwiper" id="promoBox" style="border-radius:20px;overflow:hidden;">
            <div class="swiper-wrapper">
              <div class="swiper-slide relative aspect-[2/1] md:aspect-[21/9]" style="background:radial-gradient(ellipse at 80% 0%,rgba(173,255,47,0.14),transparent 60%),linear-gradient(135deg,#131A29 0%,#0B0F18 100%);">
                <div class="absolute inset-0 flex flex-col justify-end p-5" style="background:linear-gradient(to top,rgba(0,0,0,0.55),transparent);">
                  <span class="text-xs font-bold mb-1" style="color:var(--lime);letter-spacing:0.1em;"><%= t('pwa.promo.b1','PROMO OKTOBER') %></span>
                  <h4 class="font-bold text-base text-white"><%= t('pwa.promo.s1_title','Upgrade ke 100 Mbps — diskon 30%') %></h4>
                  <p class="text-xs text-white/60 mt-0.5"><%= t('pwa.promo.s1_text','Berlaku hingga 31 Oktober 2026') %></p>
                </div>
              </div>
              <div class="swiper-slide relative aspect-[2/1] md:aspect-[21/9]" style="background:radial-gradient(ellipse at 15% 100%,rgba(173,255,47,0.12),transparent 60%),linear-gradient(135deg,#10170C 0%,#0A0E08 100%);">
                <div class="absolute inset-0 flex flex-col justify-end p-5" style="background:linear-gradient(to top,rgba(0,0,0,0.55),transparent);">
                  <span class="text-xs font-bold mb-1" style="color:var(--lime);letter-spacing:0.1em;"><%= t('pwa.promo.b2','REWARD PELANGGAN') %></span>
                  <h4 class="font-bold text-base text-white"><%= t('pwa.promo.s2_title','Bayar tepat waktu, dapat cashback Rp 20.000') %></h4>
                  <p class="text-xs text-white/60 mt-0.5"><%= t('pwa.promo.s2_text','Program loyalitas khusus pelanggan aktif') %></p>
                </div>
              </div>
              <div class="swiper-slide relative aspect-[2/1] md:aspect-[21/9]" style="background:radial-gradient(ellipse at 85% 100%,rgba(96,165,250,0.14),transparent 60%),linear-gradient(135deg,#0C1322 0%,#080C16 100%);">
                <div class="absolute inset-0 flex flex-col justify-end p-5" style="background:linear-gradient(to top,rgba(0,0,0,0.55),transparent);">
                  <span class="text-xs font-bold mb-1" style="color:#7CB9FF;letter-spacing:0.1em;">MONITORING</span>
                  <h4 class="font-bold text-base text-white"><%= t('pwa.promo.s3_title','Jaringan dipantau 24/7 oleh tim teknis') %></h4>
                  <p class="text-xs text-white/60 mt-0.5"><%= t('pwa.promo.s3_text','Respon gangguan kurang dari 2 jam') %></p>
                </div>
              </div>
            </div>
            <div class="swiper-pagination" style="bottom:10px;"></div>
          </div>

          <!-- Quick Actions -->
          <div>
            <p class="text-xs font-semibold mb-3 px-1" style="color:var(--muted);letter-spacing:0.06em;text-transform:uppercase;"><%= t('pwa.quick.title','Aksi Cepat') %></p>
            <div class="grid grid-cols-4 gap-3">
              <button onclick="switchTab('network')" class="press flex flex-col items-center gap-2">
                <div class="w-14 h-14 rounded-[18px] flex items-center justify-center qa-tile">
                  <i class="ph-fill ph-router text-2xl" style="color:var(--lime);"></i>
                </div>
                <span class="text-[11px] font-medium" style="color:var(--muted);"><%= t('pwa.home.modem','Modem') %></span>
              </button>
              <button onclick="switchTab('billing')" class="press flex flex-col items-center gap-2">
                <div class="w-14 h-14 rounded-[18px] flex items-center justify-center qa-tile">
                  <i class="ph-fill ph-receipt text-2xl" style="color:var(--lime);"></i>
                </div>
                <span class="text-[11px] font-medium" style="color:var(--muted);"><%= t('pwa.nav.billing','Tagihan') %></span>
              </button>
              <button onclick="switchTab('speedtest')" class="press flex flex-col items-center gap-2">
                <div class="w-14 h-14 rounded-[18px] flex items-center justify-center qa-tile">
                  <i class="ph-fill ph-gauge text-2xl" style="color:var(--lime);"></i>
                </div>
                <span class="text-[11px] font-medium" style="color:var(--muted);">Speed Test</span>
              </button>
              <button onclick="openBantuan()" class="press flex flex-col items-center gap-2">
                <div class="w-14 h-14 rounded-[18px] flex items-center justify-center qa-tile">
                  <i class="ph-fill ph-headset text-2xl" style="color:var(--lime);"></i>
                </div>
                <span class="text-[11px] font-medium" style="color:var(--muted);"><%= t('pwa.home.help','Bantuan') %></span>
              </button>
            </div>
          </div>

          <!-- Network Stats (real-time) -->
          <div>
            <div class="flex items-center justify-between mb-3 px-1">
              <p class="text-xs font-semibold" style="color:var(--muted);letter-spacing:0.06em;text-transform:uppercase;"><%= t('pwa.net.status_title','Status Jaringan') %></p>
              <span class="text-[10px] font-semibold flex items-center gap-1.5" style="color:var(--muted);"><span id="live-dot" style="width:7px;height:7px;border-radius:50%;background:var(--muted);display:inline-block"></span> Live</span>
            </div>
            <p class="text-[10px] mb-3 px-1" style="color:var(--muted-2);"><i class="bi bi-info-circle"></i> <%- t('pwa.net.realtime_note','Kartu di bawah menampilkan <b>kecepatan real-time</b> berdasarkan pemakaian WiFi saat ini — angka kecil atau 0 wajar bila tidak ada aktivitas.') %></p>
