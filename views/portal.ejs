              </div>
              <div class="stat-card">
                <div class="flex items-center justify-between mb-3">
                  <i class="ph-fill ph-arrow-fat-up text-xl" style="color:var(--lime);"></i>
                  <span class="text-[10px] font-medium" style="color:var(--muted);">Upload</span>
                </div>
                <p class="text-xl font-black" style="font-family:'Space Grotesk',sans-serif;color:var(--text);"><span id="live-tx">-</span><small class="text-xs font-normal ml-0.5">Mbps</small></p>
