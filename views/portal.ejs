                </div>
                <p class="text-sm font-black" style="font-family:'Space Grotesk',sans-serif;color:var(--muted);"><%= t('pwa.coming_soon','Coming soon') %></p>
                <p class="text-[10px] mt-1" style="color:var(--muted-2);"><%= t('pwa.coming_soon','Segera hadir') %></p>
              </div>
            </div>
          </div>

          <div class="alert-box net-alert" id="net-alert" data-state="maintenance" style="cursor:pointer" onclick="openGangguan()" title="<%= t('pwa.net.view_detail','Lihat detail gangguan') %>">
