<!DOCTYPE html>
<html lang="id" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes, viewport-fit=cover">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="theme-color" content="#0A0D14">
  <title><%= portal.title %> | <%= portal.company %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400..900&family=Space+Grotesk:wght@500..700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/img/icons/icon-192.png">
  <link rel="apple-touch-icon" href="/img/icons/apple-touch-icon.png">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: { extend: {
        fontFamily: {
          sans: ['Inter', 'ui-sans-serif', 'system-ui', 'sans-serif'],
          display: ['Space Grotesk', 'Inter', 'sans-serif'],
        },
        colors: {
          lime: { DEFAULT:'#ADFF2F',50:'#F4FFD6',100:'#E8FFB0',200:'#D6FF78',300:'#ADFF2F',400:'#9AEA1A',500:'#7ECB0F',600:'#62A009',700:'#487605',800:'#304D03',900:'#182501' },
          dark: { DEFAULT:'#0A0D14',50:'#1A1F2E',100:'#141824',200:'#0F121B',300:'#0A0D14' }
        }
      }}
    }
  </script>

  <style>
    :root {
      --lime:#ADFF2F; --lime-dim:rgba(173,255,47,0.12); --lime-border:rgba(173,255,47,0.2);
      --surface:#141824; --surface-2:#1A1F2E; --surface-3:#1F2538; --bg:#0A0D14;
      --border:rgba(255,255,255,0.07); --text:#FFFFFF;
      --muted:rgba(255,255,255,0.5); --muted-2:rgba(255,255,255,0.3);
      --red:#EF4444; --red-dim:rgba(239,68,68,0.1); --red-border:rgba(239,68,68,0.3);
    }
    html.light {
      --lime:#62A009; --lime-dim:rgba(98,160,9,0.1); --lime-border:rgba(98,160,9,0.25);
      --surface:#FFFFFF; --surface-2:#F4F6FA; --surface-3:#EEF0F5; --bg:#F0F2F8;
      --border:rgba(0,0,0,0.07); --text:#0A0D14;
      --muted:rgba(10,13,20,0.5); --muted-2:rgba(10,13,20,0.3);
    }

    html.dark { color-scheme: dark; }
    html.light { color-scheme: light; }
    * { box-sizing: border-box; }
    body {
      font-family: 'Inter', sans-serif;
      -webkit-tap-highlight-color: transparent;
      overscroll-behavior: none;
      background: var(--bg); color: var(--text);
      overflow: hidden; height: 100dvh;
      transition: background 0.3s, color 0.3s;
    }

    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    .pb-safe { padding-bottom: env(safe-area-inset-bottom, 0px); }
    .pt-safe { padding-top: env(safe-area-inset-top, 0px); }

    .press {
      transition: transform 0.15s cubic-bezier(.4,0,.2,1), opacity 0.15s ease;
      transform-origin: center; -webkit-user-select: none; user-select: none;
    }
    .press:active { transform: scale(0.96); opacity: 0.75; }

    .tab-content { display: none; opacity: 0; transform: translateY(14px) scale(0.98); transition: opacity 0.28s cubic-bezier(.25,1,.5,1), transform 0.28s cubic-bezier(.25,1,.5,1); }
    .tab-content.active-tab { display: block; }
    .tab-content.active-tab.tab-visible { opacity: 1; transform: translateY(0) scale(1); }

    .btn-lime {
      background: var(--lime); color: #0A0D14; font-weight: 700;
      font-family: 'Space Grotesk', sans-serif; border-radius: 14px;
      transition: box-shadow 0.2s, transform 0.15s, filter 0.2s;
    }
    .btn-lime:hover { box-shadow: 0 0 14px rgba(173,255,47,0.3); filter: brightness(1.05); }
    .btn-lime:active { transform: scale(0.94); }

    .btn-ghost {
      background: var(--surface-2); color: var(--text);
      border: 1px solid var(--border); border-radius: 14px; font-weight: 600;
      transition: background 0.2s, border-color 0.2s;
    }
    .btn-ghost:hover { border-color: var(--lime-border); }
    .btn-ghost:active { transform: scale(0.94); }

    .btn-danger-soft {
      background: var(--red-dim); color: var(--red);
      border: 1px solid var(--red-border); border-radius: 14px;
      font-weight: 700; font-family: 'Space Grotesk', sans-serif;
      transition: background 0.2s, border-color 0.2s, transform 0.15s;
    }
    .btn-danger-soft:hover { background: rgba(239,68,68,0.18); border-color: rgba(239,68,68,0.5); }
    .btn-danger-soft:active { transform: scale(0.96); }

    .nav-item {
      display: flex; align-items: center; gap: 12px;
      padding: 12px 16px; border-radius: 14px;
      font-weight: 500; font-size: 14px;
      color: var(--muted);
      transition: background 0.2s, color 0.2s;
      cursor: pointer; border: none; background: transparent; width: 100%; text-align: left;
    }
    .nav-item:hover { background: var(--surface-2); color: var(--text); }
    .nav-item.active { background: var(--lime-dim); color: var(--lime); border: 1px solid var(--lime-border); }
    .nav-item .nav-icon { font-size: 20px; transition: transform 0.2s; }
    .nav-item.active .nav-icon { transform: scale(1.1); }

    /* ── BOTTOM NAV iOS (5 tabs) ── */
    .bottom-nav-item {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      gap: 2px; flex: 1; height: 100%; cursor: pointer;
      color: var(--muted); border: none; background: transparent;
      transition: color 0.2s; position: relative; padding: 4px 0;
      min-width: 0;
    }
    .bottom-nav-item .nav-ico-wrap {
      width: 40px; height: 26px;
      display: flex; align-items: center; justify-content: center;
      border-radius: 13px;
      transition: background 0.25s;
    }
    .bottom-nav-item .nav-ico-wrap i { font-size: 22px; transition: transform 0.2s; }
    .bottom-nav-item span {
      font-size: 9.5px; font-weight: 500; letter-spacing: 0.01em;
      white-space: nowrap;
    }
    .bottom-nav-item.active { color: var(--lime); }
    .bottom-nav-item.active .nav-ico-wrap { background: var(--lime-dim); }
    .bottom-nav-item.active .nav-ico-wrap i { transform: scale(1.05); }
    .bottom-nav-item.active span { font-weight: 600; }

    .badge-online {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 4px 10px; border-radius: 100px;
      background: rgba(173,255,47,0.12);
      border: 1px solid rgba(173,255,47,0.25);
      color: var(--lime); font-size: 11px; font-weight: 600;
    }
    .badge-online .dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--lime); box-shadow: 0 0 5px rgba(173,255,47,0.6);
      animation: pulse-dot 2s infinite;
    }
    .badge-offline { background: var(--red-dim); border-color: var(--red-border); color: var(--red); }
    .badge-offline .dot { background: var(--red); box-shadow: 0 0 5px rgba(239,68,68,0.6); animation: none; }
    @keyframes pulse-dot {
      0%, 100% { opacity: 1; box-shadow: 0 0 5px rgba(173,255,47,0.6); }
      50% { opacity: 0.65; box-shadow: 0 0 2px rgba(173,255,47,0.25); }
    }

    .speed-ring { position: relative; display: inline-flex; align-items: center; justify-content: center; }
    .speed-ring svg { transform: rotate(-90deg); }
    .speed-ring .ring-track { fill: none; stroke: rgba(255,255,255,0.06); stroke-width: 6; }
    .speed-ring .ring-fill {
      fill: none; stroke: var(--lime); stroke-width: 6;
      stroke-linecap: round; stroke-dasharray: 339.3; stroke-dashoffset: 339.3;
      filter: drop-shadow(0 0 3px rgba(173,255,47,0.4));
      transition: stroke-dashoffset 1.2s cubic-bezier(.4,0,.2,1);
    }
    .speed-ring .inner { position: absolute; text-align: center; }

    .swiper-pagination-bullet { background: rgba(255,255,255,0.4) !important; }
    .swiper-pagination-bullet-active { background: var(--lime) !important; }

    #topbar { transition: box-shadow 0.3s, background 0.3s; }
    #topbar.scrolled { box-shadow: 0 1px 0 var(--border), 0 4px 20px rgba(0,0,0,0.4); }

    .divider { border: none; border-top: 1px solid var(--border); margin: 0; }

    body.preview-mobile {
      background: #05070E;
      display: flex; align-items: center; justify-content: center;
      padding: 64px 16px 24px;
    }
    body.preview-mobile #app-wrap {
      max-width: 390px; width: 100%;
      height: min(844px, 100%); margin: 0 auto;
      box-shadow: 0 0 0 1px rgba(255,255,255,0.08), 0 32px 80px rgba(0,0,0,0.7);
      border-radius: 44px; overflow: hidden;
      flex-shrink: 0;
    }
    body.preview-mobile aside.desktop-only { display: none !important; }
    body.preview-mobile .mobile-only { display: flex !important; }
    body.preview-mobile .desktop-title { display: none !important; }
    body.preview-mobile .md\:grid-cols-4 { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
    body.preview-mobile nav.bottom-nav { display: flex !important; position: absolute !important; }

    .noise::after {
      content: ''; position: absolute; inset: 0; border-radius: inherit;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      opacity: 0.04; mix-blend-mode: overlay; pointer-events: none; z-index: 1;
    }

    .progress-bar { height: 6px; border-radius: 99px; background: var(--surface-3); overflow: hidden; }
    .progress-fill {
      height: 100%; border-radius: 99px;
      background: linear-gradient(90deg, var(--lime), #9AEA1A);
      box-shadow: 0 0 4px rgba(173,255,47,0.35);
      transition: width 1s cubic-bezier(.4,0,.2,1);
    }

    .stat-card {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 16px; padding: 16px; transition: border-color 0.2s;
    }

    .avatar-ring {
      padding: 3px;
      background: linear-gradient(135deg, var(--lime), #62A009);
      border-radius: 50%; display: inline-block;
    }
    .avatar-ring img { border-radius: 50%; display: block; }

    .notif-dot {
      position: absolute; top: 6px; right: 6px;
      width: 8px; height: 8px; border-radius: 50%;
      background: #EF4444; border: 2px solid var(--bg);
      box-shadow: 0 0 5px rgba(239,68,68,0.4);
    }

    .plan-badge {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 11px; font-weight: 700; letter-spacing: 0.08em;
      padding: 3px 8px; border-radius: 6px;
      background: var(--lime-dim); color: var(--lime);
      border: 1px solid var(--lime-border); text-transform: uppercase;
    }

    .promoSwiper .swiper-slide { border-radius: 20px; overflow: hidden; }

    .list-row {
      display: flex; align-items: center; justify-content: space-between;
      padding: 14px 16px; transition: background 0.15s; cursor: pointer;
    }
    .list-row:hover { background: rgba(255,255,255,0.03); }

    #scroll-area { overflow-y: auto; flex: 1; }
    .scroll-pad { padding-bottom: calc(92px + env(safe-area-inset-bottom, 0px)); }
    @media (min-width: 768px) {
      .scroll-pad { padding-bottom: 32px; }
    }

    /* Ambient blur glow — statis, murah di GPU */
    .ambient-glow {
      position: absolute; border-radius: 50%;
      filter: blur(90px); pointer-events: none; z-index: 0;
      opacity: 0.55;
    }
    .ambient-glow-1 {
      width: 420px; height: 420px; top: -160px; right: -120px;
      background: radial-gradient(circle, rgba(173,255,47,0.10), transparent 70%);
    }
    .ambient-glow-2 {
      width: 380px; height: 380px; bottom: -140px; left: -100px;
      background: radial-gradient(circle, rgba(96,165,250,0.08), transparent 70%);
    }
    html.light .ambient-glow { opacity: 0.35; }
    body.preview-mobile .ambient-glow { opacity: 0.3; }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    @media (min-width: 768px) {
      .mobile-only { display: none !important; }
      nav.bottom-nav { display: none !important; }
    }
    @media (max-width: 767px) {
      aside.desktop-only { display: none !important; }
    }

    .alert-box {
      border-radius: 16px; padding: 14px 16px;
      display: flex; align-items: flex-start; gap: 12px;
    }
    .alert-warn { background: rgba(251,191,36,0.08); border: 1px solid rgba(251,191,36,0.2); }

    #preview-bar {
      position: fixed; top: 12px; left: 50%; transform: translateX(-50%);
      z-index: 500; background: rgba(20,24,36,0.72);
      backdrop-filter: blur(20px) saturate(1.5);
      -webkit-backdrop-filter: blur(20px) saturate(1.5);
      border: 1px solid var(--border); border-radius: 99px;
      display: none; gap: 2px; padding: 4px;
      box-shadow: 0 4px 24px rgba(0,0,0,0.5);
    }
    @media (min-width: 768px) {
      #preview-bar { display: flex; }
    }
    .preview-btn {
      padding: 6px 14px; border-radius: 99px; font-size: 12px; font-weight: 600;
      border: none; cursor: pointer; transition: background 0.2s, color 0.2s;
      display: flex; align-items: center; gap: 6px;
      color: var(--muted); background: transparent;
    }
    .preview-btn.active { background: var(--lime-dim); color: var(--lime); border: 1px solid var(--lime-border); }

    /* ═══════ CREDIT CARD (glow dikurangi) ═══════ */
    .cc {
      position: relative; aspect-ratio: 1.586 / 1; width: 100%;
      max-width: 600px; margin-inline: auto;
      border-radius: 20px; overflow: hidden; isolation: isolate;
      container-type: inline-size;
      background:
        radial-gradient(circle at 100% 0%, rgba(173,255,47,0.13), transparent 55%),
        radial-gradient(circle at 0% 100%, rgba(96,165,250,0.09), transparent 55%),
        linear-gradient(135deg, #1B2233 0%, #0F1420 45%, #0A0D14 100%);
      border: 1px solid rgba(255,255,255,0.09);
      box-shadow: 0 20px 50px -22px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.05);
      transition: transform 0.4s cubic-bezier(.2,.9,.3,1), box-shadow 0.4s;
    }
    .cc:hover {
      transform: translateY(-2px) rotateX(1.5deg) rotateY(-1.5deg);
      box-shadow: 0 26px 60px -22px rgba(0,0,0,0.7), 0 0 24px -12px rgba(173,255,47,0.18);
    }
    .cc::before {
      content: ''; position: absolute; inset: -50%;
      background: linear-gradient(115deg, transparent 30%, rgba(173,255,47,0.07) 45%, rgba(255,255,255,0.13) 50%, rgba(173,255,47,0.07) 55%, transparent 70%);
      transform: translateX(-30%); transition: transform 1.2s ease;
      pointer-events: none; z-index: 3; mix-blend-mode: screen;
    }
    .cc:hover::before { transform: translateX(30%); }
    .cc::after {
      content: ''; position: absolute; inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      opacity: 0.05; mix-blend-mode: overlay; pointer-events: none; z-index: 4;
    }
    .cc-arcs { position: absolute; inset: 0; z-index: 1; pointer-events: none; opacity: 0.4; }
    .cc-arcs svg { width: 100%; height: 100%; }

    .cc-content {
      position: relative; z-index: 5; height: 100%;
      padding: 5% 6%;
      display: flex; flex-direction: column; justify-content: space-between;
      gap: 2%; color: #fff;
    }

    .cc-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .cc-brand {
      display: flex; align-items: center; gap: 7px;
      font-family: 'Space Grotesk', sans-serif; font-weight: 700;
      letter-spacing: 0.14em; font-size: clamp(10px, 2.6cqw, 12px); color: #fff;
    }
    .cc-brand-mark {
      width: 20px; height: 20px; border-radius: 6px;
      background: linear-gradient(135deg, var(--lime) 0%, #7ECB0F 100%);
      display: flex; align-items: center; justify-content: center;
      color: #0A0D14; font-weight: 900; font-size: 12px;
      box-shadow: 0 0 8px rgba(173,255,47,0.3);
    }
    .cc-brand span { color: var(--lime); }
    .cc-top-badges { display: flex; align-items: center; gap: 6px; }

    .cc-status {
      display: inline-flex; align-items: center; gap: 4px;
      font-size: 9px; font-weight: 700; letter-spacing: 0.08em;
      color: var(--lime); text-transform: uppercase;
      padding: 3px 8px; border-radius: 100px;
      background: rgba(173,255,47,0.12);
      border: 1px solid rgba(173,255,47,0.3);
    }
    .cc-status .dot {
      width: 5px; height: 5px; border-radius: 50%;
      background: var(--lime); box-shadow: 0 0 4px var(--lime);
      animation: pulse-dot 2s infinite;
    }
    .cc-tier {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 9px; font-weight: 700; letter-spacing: 0.18em;
      padding: 3px 9px; border-radius: 100px;
      background: rgba(173,255,47,0.14);
      border: 1px solid rgba(173,255,47,0.35);
      color: var(--lime); text-transform: uppercase;
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }

    .cc-identity { display: flex; flex-direction: column; gap: 1px; margin: 2% 0; }
    .cc-greet {
      font-size: 10.5px;
      font-weight: 500; color: rgba(255,255,255,0.55);
      letter-spacing: 0.02em;
    }
    .cc-name {
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(16px, 5cqw, 21px);
      font-weight: 700; letter-spacing: -0.01em;
      color: #fff; line-height: 1.1;
    }

    .cc-chip-row { display: flex; align-items: center; gap: 10px; margin: 1% 0; }
    .cc-chip {
      width: 36px; height: 28px; border-radius: 6px;
      background: linear-gradient(135deg, #E8C86A 0%, #B8934A 45%, #F0DA8A 100%);
      position: relative; flex-shrink: 0;
      box-shadow: 0 2px 5px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.5);
      overflow: hidden;
    }
    .cc-chip::before, .cc-chip::after { content: ''; position: absolute; background: rgba(0,0,0,0.35); }
    .cc-chip::before { left: 50%; top: 8%; bottom: 8%; width: 1px; transform: translateX(-50%); }
    .cc-chip::after { top: 50%; left: 8%; right: 8%; height: 1px; transform: translateY(-50%); }
    .cc-chip .chip-line-1, .cc-chip .chip-line-2 { position: absolute; background: rgba(0,0,0,0.35); }
    .cc-chip .chip-line-1 { left: 22%; right: 22%; top: 22%; height: 1px; }
    .cc-chip .chip-line-2 { left: 22%; right: 22%; bottom: 22%; height: 1px; }

    .cc-id-wrap {
      display: flex; align-items: center; gap: 6px;
      min-width: 0; flex: 1;
    }
    .cc-id {
      font-family: 'Space Grotesk', monospace; font-variant-numeric: tabular-nums;
      font-size: clamp(13px, 3.8cqw, 16px); font-weight: 600;
      letter-spacing: 0.14em; color: rgba(255,255,255,0.92);
      text-shadow: 0 1px 2px rgba(0,0,0,0.5);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .cc-copy {
      width: 28px; height: 28px; border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.1);
      color: rgba(255,255,255,0.75);
      cursor: pointer; flex-shrink: 0;
      transition: background 0.2s, color 0.2s, transform 0.15s;
      font-size: 12px;
    }
    .cc-copy:hover { background: rgba(173,255,47,0.15); color: var(--lime); border-color: rgba(173,255,47,0.35); }
    .cc-copy:active { transform: scale(0.9); }
    .cc-copy.copied { background: rgba(173,255,47,0.2); color: var(--lime); border-color: rgba(173,255,47,0.5); }

    .cc-footer {
      display: flex; align-items: flex-end; gap: 14px;
      padding-top: 4%;
      border-top: 1px solid rgba(255,255,255,0.08);
    }
    .cc-foot-block { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .cc-label {
      font-size: 8px; font-weight: 600;
      letter-spacing: 0.14em;
      color: rgba(255,255,255,0.5);
      text-transform: uppercase;
    }
    .cc-label-row {
      display: flex; justify-content: space-between;
      align-items: baseline; gap: 6px;
    }
    .cc-lime { color: var(--lime) !important; }

    .cc-speed {
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(18px, 5cqw, 22px);
      font-weight: 800; line-height: 1;
      color: #fff; letter-spacing: -0.02em;
    }
    .cc-speed small {
      font-size: 9px; font-weight: 500;
      color: rgba(255,255,255,0.6);
      margin-left: 1px;
    }
    .cc-progress {
      height: 4px; border-radius: 99px;
      background: rgba(255,255,255,0.12);
      overflow: hidden; margin-top: 3px;
    }
    .cc-progress-fill {
      height: 100%; width: 65%;
      background: linear-gradient(90deg, var(--lime), #9AEA1A);
      box-shadow: 0 0 4px rgba(173,255,47,0.4);
      border-radius: 99px;
      transition: width 1s cubic-bezier(.4,0,.2,1);
    }

    .cc-orb { position: absolute; border-radius: 50%; filter: blur(50px); pointer-events: none; z-index: 0; }
    .cc-orb-1 { width: 130px; height: 130px; top: -50px; right: -30px; background: radial-gradient(circle, rgba(173,255,47,0.22), transparent 70%); }
    .cc-orb-2 { width: 110px; height: 110px; bottom: -50px; left: -20px; background: radial-gradient(circle, rgba(96,165,250,0.16), transparent 70%); }

    /* ═══════ iOS SETTINGS ═══════ */
    .ios-section-label {
      font-size: 11px; font-weight: 600; letter-spacing: 0.08em;
      text-transform: uppercase; color: var(--muted);
      padding: 0 16px 8px;
    }
    .ios-group {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 14px; overflow: hidden;
    }
    .ios-row {
      display: flex; align-items: center; gap: 14px;
      padding: 11px 14px; cursor: pointer;
      transition: background 0.15s;
      border-bottom: 1px solid var(--border);
      text-decoration: none;
    }
    .ios-row:last-child { border-bottom: none; }
    .ios-row:hover { background: var(--surface-2); }
    .ios-icon {
      width: 28px; height: 28px; border-radius: 7px;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .ios-icon i { font-size: 15px; color: #fff; }
    .ios-label {
      flex: 1; font-size: 14px; font-weight: 400;
      color: var(--text); letter-spacing: -0.01em;
    }
    .ios-value { font-size: 13px; color: var(--muted); margin-right: 2px; }
    .ios-chevron { color: var(--muted-2); font-size: 14px; }

    /* ═══════ SPEED TEST ═══════ */
    .st-wrap {
      position: relative;
      display: flex; align-items: center; justify-content: center;
      margin: 6px 0 10px;
    }
    .st-center {
      position: absolute; text-align: center;
      top: 50%; left: 50%; transform: translate(-50%, -50%);
      width: 140px;
    }
    .st-value {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 44px; font-weight: 800;
      line-height: 1; letter-spacing: -0.03em;
      color: var(--lime);
      transition: color 0.3s;
    }
    .st-unit {
      font-size: 11px; font-weight: 600;
      letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--muted);
      margin-top: 4px;
    }
    .st-status {
      font-size: 11px; margin-top: 6px;
      color: var(--muted);
    }
    .st-result-grid {
      display: grid; grid-template-columns: 1fr 1fr 1fr;
      gap: 1px; background: var(--border);
      border-radius: 14px; overflow: hidden;
      margin-top: 6px;
    }
    .st-result-cell {
      background: var(--surface-2);
      padding: 12px 8px; text-align: center;
    }
    .st-result-cell .st-ic { font-size: 16px; margin-bottom: 4px; }
    .st-result-cell .st-rt {
      font-size: 9px; letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted); font-weight: 600;
    }
    .st-result-cell .st-rv {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 17px; font-weight: 700;
      color: var(--text); margin-top: 2px;
    }
    .st-result-cell .st-rv small {
      font-size: 9px; font-weight: 500;
      color: var(--muted); margin-left: 1px;
    }

    /* ═══════ MODAL ═══════ */
    .modal-backdrop {
      position: fixed; inset: 0; z-index: 300;
      background: rgba(0,0,0,0.55);
      backdrop-filter: blur(8px) saturate(1.3);
      -webkit-backdrop-filter: blur(8px) saturate(1.3);
      display: none; align-items: center; justify-content: center;
      padding: 16px;
      animation: fadeIn 0.2s ease;
    }
    .modal-backdrop.open { display: flex; }
    /* FIX: saat tertutup jangan menangkap klik (bug desktop: overlay transparan memblokir tombol sidebar) */
    .modal-backdrop:not(.open) { display: none !important; pointer-events: none !important; visibility: hidden !important; }
    body.preview-mobile .modal-backdrop { position: absolute; }
    body.preview-mobile .modal-sheet { max-height: 88%; }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

    .modal-sheet {
      width: 100%; max-width: 480px;
      background: var(--surface);
      border-radius: 24px;
      border: 1px solid var(--border);
      padding: 10px 20px 20px;
      animation: slideUp 0.3s cubic-bezier(.2,.9,.3,1);
      max-height: 86vh; overflow-y: auto;
    }
    @media (min-width: 768px) {
      .modal-backdrop { align-items: center; }
      .modal-sheet { border-radius: 24px; border-bottom: 1px solid var(--border); }
    }
    @keyframes slideUp {
      from { transform: translateY(30px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    .modal-grip {
      width: 40px; height: 4px; border-radius: 99px;
      background: var(--muted-2);
      margin: 4px auto 12px;
    }
    .modal-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 17px; font-weight: 700;
      color: var(--text); margin-bottom: 4px;
    }
    .modal-sub {
      font-size: 12px; color: var(--muted);
      margin-bottom: 18px;
    }
    .field { margin-bottom: 14px; }
    .field-label {
      font-size: 11px; font-weight: 600;
      letter-spacing: 0.06em; text-transform: uppercase;
      color: var(--muted); margin-bottom: 6px;
      display: block;
    }
    .field-input-wrap {
      display: flex; align-items: center; gap: 8px;
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 12px; padding: 0 12px;
      transition: border-color 0.2s;
    }
    .field-input-wrap:focus-within { border-color: var(--lime-border); }
    .field-input {
      flex: 1;
      background: transparent; border: none; outline: none;
      color: var(--text); font-size: 14px;
      padding: 12px 0;
      font-family: 'Space Grotesk', sans-serif;
      letter-spacing: 0.02em;
    }
    .field-input[type="password"] { letter-spacing: 0.2em; font-family: 'Inter', monospace; }
    /* Kotak input mandiri (textarea / file) agar kontras dengan background */
    .field-box {
      display: block; width: 100%;
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px 14px;
      color: var(--text);
      font-size: 14px;
      line-height: 1.45;
      outline: none;
      font-family: 'Inter', system-ui, sans-serif;
      transition: border-color .2s, background .2s;
    }
    .field-box:focus { border-color: var(--lime-border); background: var(--surface-3); }
    .field-box::placeholder { color: var(--muted-2); }
    .field-box[type="file"] { padding: 11px 12px; font-size: 12px; cursor: pointer; }
    .field-box[type="file"]::file-selector-button {
      background: var(--lime-dim); color: var(--lime);
      border: 1px solid var(--lime-border); border-radius: 9px;
      padding: 7px 12px; margin-right: 10px; font-weight: 700; font-size: 12px; cursor: pointer;
    }
    select.field-box { appearance: none; -webkit-appearance: none; }
    .field-box-hint { font-size: 11px; color: var(--muted-2); margin-top: 5px; }
    .info-list { border: 1px solid var(--border); border-radius: 14px; overflow: hidden; background: var(--surface-2); margin-bottom: 14px; }
    .info-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; padding: 11px 14px; border-bottom: 1px solid var(--border); }
    .info-row:last-child { border-bottom: none; }
    .info-k { font-size: 12px; color: var(--muted); flex-shrink: 0; }
    .info-v { font-size: 13px; font-weight: 600; color: var(--text); text-align: right; word-break: break-word; }
    .ios-row .ios-icon i.bi { font-size: 16px; }
    .field-toggle {
      background: transparent; border: none;
      color: var(--muted); cursor: pointer;
      padding: 6px; border-radius: 8px;
      display: flex; align-items: center;
      transition: color 0.2s;
    }
    .field-toggle:hover { color: var(--text); }
    .field-hint {
      font-size: 11px; color: var(--muted);
      margin-top: 6px; line-height: 1.4;
    }
    .modal-actions {
      display: flex; gap: 10px; margin-top: 20px;
    }
    .modal-actions button {
      flex: 1; padding: 13px 16px;
      font-size: 14px; font-weight: 700;
      border-radius: 12px; border: none;
      cursor: pointer; transition: transform 0.15s, background 0.2s;
      font-family: 'Space Grotesk', sans-serif;
    }
    .modal-actions button:active { transform: scale(0.96); }
    .btn-cancel {
      background: var(--surface-2); color: var(--text);
      border: 1px solid var(--border) !important;
    }
    .btn-cancel:hover { background: var(--surface-3); }
    .btn-save {
      background: var(--lime); color: #0A0D14;
    }
    .btn-save:hover { filter: brightness(1.05); }
    .btn-danger {
      background: var(--red); color: #fff;
    }
    .btn-danger:hover { filter: brightness(1.08); }

    /* Confirm modal centered */
    .confirm-sheet {
      max-width: 380px !important;
      text-align: center;
    }
    .confirm-icon-wrap {
      width: 56px; height: 56px; border-radius: 50%;
      background: rgba(239,68,68,0.12);
      border: 1px solid rgba(239,68,68,0.25);
      display: inline-flex; align-items: center; justify-content: center;
      margin-bottom: 14px;
    }
    .confirm-icon-wrap i {
      font-size: 28px; color: var(--red);
    }

    /* ── Toast ── */
    .toast {
      position: fixed; left: 50%; bottom: 100px;
      transform: translateX(-50%) translateY(20px);
      background: rgba(20,24,36,0.9);
      backdrop-filter: blur(16px) saturate(1.4);
      -webkit-backdrop-filter: blur(16px) saturate(1.4);
      border: 1px solid var(--lime-border);
      color: var(--text);
      padding: 12px 18px;
      border-radius: 99px;
      font-size: 13px; font-weight: 600;
      display: flex; align-items: center; gap: 8px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.5);
      opacity: 0; pointer-events: none;
      transition: opacity 0.3s, transform 0.3s;
      z-index: 400;
    }
    .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
    .toast i { color: var(--lime); font-size: 16px; }
    .toast.error { border-color: var(--red-border); }
    .toast.error i { color: var(--red); }

    body.preview-mobile .toast { position: absolute; }

    @keyframes spin { to { transform: rotate(360deg); } }
    @keyframes ptrSpin { to { transform: rotate(360deg); } }
    .ptr-spin { animation: ptrSpin .7s linear infinite !important; }
    @keyframes badgePulse { 0%,100% { box-shadow: 0 0 0 0 rgba(251,191,36,.38); } 50% { box-shadow: 0 0 0 7px rgba(251,191,36,0); } }
    .net-badge[data-state="maintenance"] { animation: badgePulse 2.2s ease-in-out infinite; }
    .net-badge[data-state="outage"] { animation: badgePulse 1.6s ease-in-out infinite; }

