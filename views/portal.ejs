      <div class="modal-grip"></div>
      <h3 class="modal-title"><%= t('pwa.account.personal_info','Informasi Pribadi') %></h3>
      <p class="modal-sub"><%= t('pwa.account.data_note','Data akun Anda. Untuk mengubah data, ajukan ke admin.') %></p>
      <div class="info-list">
        <div class="info-row"><span class="info-k"><%= t('pwa.field.name','Nama') %></span><span class="info-v"><%= portal.profileInfo.name %></span></div>
        <div class="info-row"><span class="info-k"><%= t('pwa.field.customer_id','ID Pelanggan') %></span><span class="info-v"><%= portal.profileInfo.code %></span></div>
        <div class="info-row"><span class="info-k"><%= t('pwa.field.phone','No. HP / WA') %></span><span class="info-v"><%= portal.profileInfo.phone %></span></div>
        <div class="info-row"><span class="info-k"><%= t('pwa.field.address','Alamat') %></span><span class="info-v"><%= portal.profileInfo.address %></span></div>
        <div class="info-row"><span class="info-k"><%= t('pwa.field.area','Area') %></span><span class="info-v"><%= portal.profileInfo.area %></span></div>
        <div class="info-row"><span class="info-k"><%= t('pwa.field.package','Paket') %></span><span class="info-v"><%= portal.profileInfo.packageName %></span></div>
        <div class="info-row"><span class="info-k"><%= t('common.status','Status') %></span><span class="info-v" style="color:var(--lime);"><%= portal.profileInfo.status %></span></div>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn-cancel" onclick="closeInfoPribadi()"><%= t('common.close','Tutup') %></button>
        <a href="https://wa.me/<%= portal.waPhone %>?text=<%= encodeURIComponent(t('pwa.wa_edit_prefix','Halo Admin, saya ingin mengubah data pelanggan saya. ID: ') + portal.profileInfo.code + ' (' + portal.profileInfo.name + '). Data yang ingin diubah: ') %>" target="_blank" rel="noopener" style="flex:1;display:flex;align-items:center;justify-content:center;padding:14px 16px;border-radius:14px;background:var(--lime);color:#0A0D14;font-weight:700;font-family:'Space Grotesk',sans-serif;text-decoration:none;font-size:14px;"><%= t('pwa.wifi.apply','Ajukan Perubahan') %></a>
      </div>
    </div>
  </div>

  <!-- ═══════════════ MODAL: Data Layanan ═══════════════ -->
  <div class="modal-backdrop" id="layanan-modal" onclick="if(event.target===this)closeLayanan()">
    <div class="modal-sheet" role="dialog" aria-modal="true">
      <div class="modal-grip"></div>
      <h3 class="modal-title"><%= t('pwa.account.service_data','Data Layanan') %></h3>
      <p class="modal-sub"><%= t('pwa.account.tech_info_note','Informasi teknis untuk keperluan bantuan/teknisi.') %></p>
      <div class="info-list">
        <div class="info-row"><span class="info-k"><%= t('pwa.net.f_pppoe_short','PPPoE') %></span><span class="info-v"><%= portal.pppoeUser %></span></div>
        <div class="info-row"><span class="info-k"><%= t('pwa.net.f_ip_public','IP Publik') %></span><span class="info-v"><%= portal.pppoeIp %></span></div>
        <div class="info-row"><span class="info-k"><%= t('pwa.net.f_serial','Serial ONU') %></span><span class="info-v"><%= portal.serialNumber %></span></div>
        <div class="info-row"><span class="info-k"><%= t('pwa.net.f_model','Model ONU') %></span><span class="info-v"><%= portal.onuModel %></span></div>
        <div class="info-row"><span class="info-k"><%= t('pwa.net.ssid_short','SSID WiFi') %></span><span class="info-v"><%= portal.ssid %></span></div>
        <div class="info-row"><span class="info-k"><%= t('pwa.net.f_rx','Redaman (Rx)') %></span><span class="info-v"><%= portal.rxPower %></span></div>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn-cancel" onclick="closeLayanan()"><%= t('common.close','Tutup') %></button>
        <button type="button" class="btn-save" onclick="copyLayanan()"><%= t('pwa.account.copy_all','Salin Semua') %></button>
      </div>
    </div>
  </div>

  <!-- ═══════════════ MODAL: Riwayat Pembayaran ═══════════════ -->
  <div class="modal-backdrop" id="riwayat-modal" onclick="if(event.target===this)closeRiwayat()">
    <div class="modal-sheet" role="dialog" aria-modal="true">
      <div class="modal-grip"></div>
      <h3 class="modal-title"><%= t('pwa.billing.history','Riwayat Pembayaran') %></h3>
      <p class="modal-sub"><%= t('pwa.billing.paid_note','Tagihan yang sudah lunas.') %></p>
      <div id="riwayatList" style="max-height:50vh;overflow-y:auto;">
        <% if (!portal.history || !portal.history.length) { %>
          <p class="text-sm" style="color:var(--muted);text-align:center;padding:16px 0;"><%= t('pwa.billing.no_history','Belum ada riwayat pembayaran.') %></p>
        <% } %>
        <div class="info-list" style="margin-bottom:0;<%= (portal.history && portal.history.length) ? '' : 'display:none' %>">
          <% (portal.history || []).forEach(function(h){ %>
          <div class="info-row"><span class="info-k"><%= h.month %><br><span style="font-size:10px;color:var(--muted-2);"><%= h.paidText %></span></span><span class="info-v"><%= h.amount %><br><span style="font-size:10px;color:var(--lime);"><%= h.statusText %></span></span></div>
          <% }); %>
        </div>
      </div>
      <div class="modal-actions"><button type="button" class="btn-save" style="width:100%" onclick="closeRiwayat()"><%= t('common.close','Tutup') %></button></div>
    </div>
  </div>

  <!-- ═══════════════ MODAL: Tentang Aplikasi ═══════════════ -->
  <div class="modal-backdrop" id="tentang-modal" onclick="if(event.target===this)closeTentang()">
    <div class="modal-sheet" role="dialog" aria-modal="true">
      <div class="modal-grip"></div>
      <h3 class="modal-title"><%= t('pwa.account.about','Tentang Aplikasi') %></h3>
      <p class="modal-sub"><%= t('pwa.title','Portal Pelanggan') %><%= portal.companyInfo.name %></p>
      <div class="info-list">
        <div class="info-row"><span class="info-k"><%= t('pwa.account.apps','Aplikasi') %></span><span class="info-v"><%= portal.companyInfo.name %> PWA v<%= pwaVersion %> (<%= appVersionName %>) · Billing v<%= appVersion %></span></div>
        <div class="info-row"><span class="info-k"><%= t('pwa.field.company','Perusahaan') %></span><span class="info-v"><%= portal.companyInfo.name %></span></div>
        <div class="info-row"><span class="info-k"><%= t('pwa.field.address','Alamat') %></span><span class="info-v"><%= portal.companyInfo.address %></span></div>
        <div class="info-row"><span class="info-k"><%= t('pwa.field.phone_plain','Telepon') %></span><span class="info-v"><%= portal.companyInfo.phone %></span></div>
        <div class="info-row"><span class="info-k"><%= t('pwa.field.email','Email') %></span><span class="info-v"><%= portal.companyInfo.email %></span></div>
      </div>
      <p class="text-[10px]" style="color:var(--muted-2);margin-bottom:12px;"><i class="bi bi-shield-check"></i><%= t('pwa.help.official_note','Hanya percaya kontak resmi di atas. Admin tidak pernah meminta password.') %></p>
      <div class="modal-actions"><button type="button" class="btn-save" style="width:100%" onclick="closeTentang()"><%= t('common.close','Tutup') %></button></div>
    </div>
  </div>

  <!-- ═══════════════ MODAL: Bantuan ═══════════════ -->
  <div class="modal-backdrop" id="bantuan-modal" onclick="if(event.target===this)closeBantuan()">
    <div class="modal-sheet" role="dialog" aria-modal="true" aria-labelledby="bantuan-title">
      <div class="modal-grip"></div>
      <h3 class="modal-title" id="bantuan-title"><%= t('pwa.help.needed','Butuh Bantuan?') %></h3>
      <p class="modal-sub"><%= t('pwa.help.subtitle','Kirim laporan gangguan ke admin (foto opsional), atau chat langsung via WhatsApp.') %></p>
      <form id="bantuan-form" action="/customer/tickets/create" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="customerId" value="<%= portal.customerId || '' %>">
        <input type="hidden" name="gps_lat" id="bt-lat" value="">
        <input type="hidden" name="gps_lng" id="bt-lng" value="">
        <div class="field">
          <label class="field-label" for="bt-subject"><%= t('pwa.help.issue_type','Jenis Kendala') %></label>
          <select class="field-box" id="bt-subject" name="subject" required>
            <option value="" disabled selected><%= t('pwa.help.pick_issue','-- Pilih jenis kendala --') %></option>
            <option><%= t('pwa.help.i_disconnected','Koneksi Terputus / Tidak Bisa Konek') %></option>
            <option><%= t('pwa.help.i_slow','Koneksi Lambat / Lemot') %></option>
            <option><%= t('pwa.help.i_pon','Lampu PON Merah / Los Sinyal') %></option>
            <option><%= t('pwa.help.i_pwd','Kendala Lupa Password WiFi') %></option>
            <option><%= t('pwa.help.topic_billing','Pertanyaan Tagihan &amp; Pembayaran') %></option>
            <option><%= t('pwa.help.i_other','Lainnya') %></option>
          </select>
          <p class="field-box-hint"><i class="bi bi-chevron-down"></i><%= t('pwa.help.pick_hint','Ketuk untuk memilih jenis kendala') %></p>
        </div>
        <div class="field">
          <label class="field-label" for="bt-msg"><%= t('pwa.help.message','Detail Pesan') %></label>
          <textarea class="field-box" id="bt-msg" name="message" rows="3" placeholder="<%= t('pwa.help.message_ph','Jelaskan kendala Anda…') %>" required style="min-height:92px;resize:vertical;"></textarea>
        </div>
        <div class="field">
          <label class="field-label" for="bt-photo"><%= t('pwa.help.photo','Foto Lampiran (opsional)') %></label>
          <input class="field-box" type="file" id="bt-photo" name="photos" accept="image/*" multiple>
          <p class="field-box-hint"><%= t('pwa.help.photo_note','Opsional — boleh dikosongkan jika tidak ada foto.') %></p>
        </div>
        <div class="modal-actions">
          <button type="button" class="btn-cancel" onclick="closeBantuan()"><%= t('common.cancel','Batal') %></button>
          <button type="submit" class="btn-save"><%= t('pwa.help.submit','Kirim Gangguan') %></button>
        </div>
      </form>
      <button type="button" onclick="openWaHelp()" class="btn-ghost press" style="width:100%;margin-top:10px;padding:13px;border-radius:14px;display:flex;align-items:center;justify-content:center;gap:8px;font-weight:600;">
        <i class="bi bi-whatsapp" style="color:#22C55E;"></i><%= t('pwa.help.chat_wa_alt','Chat via WhatsApp') %></button>
    </div>
  </div>

  <!-- ═══════════════ MODAL: Info Gangguan ═══════════════ -->
  <div class="modal-backdrop" id="gangguan-modal" onclick="if(event.target===this)closeGangguan()">
    <div class="modal-sheet confirm-sheet" role="dialog" aria-modal="true">
      <div class="modal-grip"></div>
      <div class="confirm-icon-wrap" id="gangguan-ico"><i class="ph-fill ph-warning-circle"></i></div>
      <h3 class="modal-title" id="gangguan-title"><%= t('pwa.help.info','Info Gangguan') %></h3>
      <p class="modal-sub" id="gangguan-msg" style="margin-bottom:0"></p>
      <p class="modal-sub" id="gangguan-eta" style="margin-bottom:0"></p>
      <div class="modal-actions">
        <button type="button" class="btn-cancel" onclick="closeGangguan()"><%= t('common.close','Tutup') %></button>
        <a href="https://wa.me/<%= portal.waPhone %>" target="_blank" rel="noopener" style="flex:1;display:flex;align-items:center;justify-content:center;padding:14px 16px;border-radius:14px;background:var(--lime);color:#0A0D14;font-weight:700;font-family:'Space Grotesk',sans-serif;text-decoration:none;font-size:14px;"><%= t('pwa.speedtest.contact_admin','Hubungi Admin') %></a>
      </div>
    </div>
  </div>

  <!-- ═══════════════ MODAL: ONU tidak terdeteksi ═══════════════ -->
  <div class="modal-backdrop" id="onu-modal" onclick="if(event.target===this)closeOnuModal()">
    <div class="modal-sheet confirm-sheet" role="dialog" aria-modal="true">
      <div class="modal-grip"></div>
      <div class="confirm-icon-wrap"><i class="ph-fill ph-warning-circle"></i></div>
      <h3 class="modal-title"><%= t('pwa.net.onu_missing','ONU Tidak Terdeteksi') %></h3>
      <p class="modal-sub" style="margin-bottom:0;"><%= t('pwa.net.onu_missing_note','Perangkat ONU/modem Anda belum terdeteksi di sistem. Pastikan modem menyala dan kabel fiber terpasang dengan benar. Bila tetap tidak terdeteksi, hubungi admin.') %></p>
      <div class="modal-actions">
        <button type="button" class="btn-cancel" onclick="closeOnuModal()"><%= t('common.close','Tutup') %></button>
        <a href="https://wa.me/<%= portal.waPhone %>" target="_blank" rel="noopener" style="flex:1;display:flex;align-items:center;justify-content:center;padding:14px 16px;border-radius:14px;background:var(--lime);color:#0A0D14;font-weight:700;font-family:'Space Grotesk',sans-serif;text-decoration:none;font-size:14px;"><%= t('pwa.speedtest.contact_admin','Hubungi Admin') %></a>
      </div>
    </div>
  </div>

  <!-- ═══════════════ MODAL: Notifikasi ═══════════════ -->
  <div class="modal-backdrop" id="notif-modal" onclick="if(event.target===this)closeNotifPanel()">
    <div class="modal-sheet" role="dialog" aria-modal="true" aria-labelledby="notif-title">
      <div class="modal-grip"></div>
      <h3 class="modal-title" id="notif-title"><%= t('pwa.notif.title','Notifikasi') %></h3>
      <p class="modal-sub"><%= t('pwa.notif.subtitle','Pemberitahuan terbaru untuk akun Anda') %></p>
      <div id="notifList" style="max-height:52vh;overflow-y:auto;display:flex;flex-direction:column;gap:10px;margin-bottom:10px;"></div>
      <div class="modal-actions">
        <button type="button" class="btn-save" style="width:100%" onclick="closeNotifPanel()"><%= t('common.close','Tutup') %></button>
      </div>
    </div>
  </div>

  <!-- ═══════════════ MODAL: Confirm (generic) ═══════════════ -->
  <div class="modal-backdrop" id="confirm-modal" onclick="if(event.target===this)closeConfirm()">
    <div class="modal-sheet confirm-sheet" role="dialog" aria-modal="true" aria-labelledby="confirm-title">
      <div class="modal-grip"></div>
      <div class="confirm-icon-wrap">
        <i class="ph-fill ph-warning-circle" id="confirm-icon"></i>
      </div>
      <h3 class="modal-title" id="confirm-title"><%= t('pwa.confirm.title','Konfirmasi') %></h3>
      <p class="modal-sub" id="confirm-message" style="margin-bottom:0;"><%= t('pwa.confirm.sure','Apakah Anda yakin?') %></p>
      <div class="modal-actions">
        <button type="button" class="btn-cancel" onclick="closeConfirm()"><%= t('common.cancel','Batal') %></button>
        <button type="button" class="btn-danger" id="confirm-action-btn" onclick="runConfirm()"><%= t('pwa.confirm.yes','Ya, Lanjutkan') %></button>
      </div>
    </div>
  </div>

  <!-- Loading overlay -->
  <div class="busy-overlay" id="busy" role="status" aria-live="polite">
    <div class="busy-panel">
      <div class="busy-ico" id="busy-ico"><i class="ph ph-circle-notch busy-spin"></i></div>
      <p class="busy-text" id="busy-text"><%= t('common.processing','Memproses...') %></p>
    </div>
  </div>

  <!-- Toast -->
  <div class="toast" id="toast">
    <i class="ph-fill ph-check-circle" id="toast-icon"></i>
    <span id="toast-text"><%= t('common.success','Berhasil') %></span>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
  let swiper = null;
  const tabs = ['home', 'billing', 'speedtest', 'network', 'profile'];
  const pageTitles = { home: '<%= t('common.home','Beranda') %>', billing: '<%= t('pwa.nav.billing','Tagihan') %>', speedtest: 'Speed Test', network: '<%= t('pwa.nav.network','Jaringan') %>', profile: '<%= t('pwa.nav.account','Akun') %>' };
  let activeTab = 'home';

  function switchTab(id) {
    if (id === activeTab) return;
    activeTab = id;
    tabs.forEach(t => {
      const el = document.getElementById(`tab-${t}`);
      if (t === id) {
        el.classList.add('active-tab');
        requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('tab-visible')));
      } else {
        el.classList.remove('tab-visible', 'active-tab');
      }
    });
    document.getElementById('page-title').innerText = pageTitles[id];
    document.getElementById('scroll-area').scrollTo({ top: 0, behavior: 'smooth' });
    updateNav(id);
    if (id === 'network') animateSpeedRing();
  }

  function updateNav(active) {
    const mItems = {
      home: 'nav-m-home', billing: 'nav-m-billing', speedtest: 'nav-m-speedtest',
      network: 'nav-m-network', profile: 'nav-m-profile',
    };
    const mIcons = {
      home: ['ph-fill ph-house','ph ph-house'],
      billing: ['ph-fill ph-receipt','ph ph-receipt'],
      speedtest: ['ph-fill ph-gauge','ph ph-gauge'],
      network: ['ph-bold ph-wifi-high','ph ph-wifi-high'],
      profile: ['ph-fill ph-user-circle','ph ph-user-circle'],
    };

    // Mobile bottom nav
    tabs.forEach(t => {
      const btn = document.getElementById(mItems[t]); if (!btn) return;
      const iconEl = btn.querySelector('.nav-ico-wrap i');
      const [fillCls, outlineCls] = mIcons[t];
      if (t === active) { btn.classList.add('active'); if (iconEl) iconEl.className = fillCls; }
      else { btn.classList.remove('active'); if (iconEl) iconEl.className = outlineCls; }
    });

    // Desktop sidebar
    const dNavMap = {
      home: 'nav-d-home', billing: 'nav-d-billing', speedtest: 'nav-d-speedtest',
      network: 'nav-d-network', profile: 'nav-d-profile',
    };
    tabs.forEach(t => {
      const btn = document.getElementById(dNavMap[t]); if (!btn) return;
      const iconEl = btn.querySelector('i');
      const [fillCls, outlineCls] = mIcons[t];
      if (t === active) { btn.classList.add('active'); if (iconEl) iconEl.className = `${fillCls} nav-icon`; }
      else { btn.classList.remove('active'); if (iconEl) iconEl.className = `${outlineCls} nav-icon`; }
    });
  }

  function animateSpeedRing() {
    const circle = document.getElementById('speed-ring-circle'); if (!circle) return;
    const circ = 2 * Math.PI * 54;
    circle.style.strokeDashoffset = circ * (1 - 0.5);
  }

  /* ═══════ Copy Customer ID ═══════ */
  function copyCustomerId(btn) {
    const id = document.getElementById('customer-id').textContent.trim();
    const doSuccess = () => {
      btn.classList.add('copied');
      const icon = btn.querySelector('i');
      if (icon) icon.className = 'ph-bold ph-check';
      showToast(`ID ${id} disalin`);
      setTimeout(() => {
        btn.classList.remove('copied');
        if (icon) icon.className = 'ph-bold ph-copy';
      }, 1600);
    };
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(id).then(doSuccess).catch(() => fallbackCopy(id, doSuccess));
    } else {
      fallbackCopy(id, doSuccess);
    }
  }
  function fallbackCopy(text, cb) {
    const ta = document.createElement('textarea');
    ta.value = text; ta.style.position = 'fixed'; ta.style.left = '-9999px';
    document.body.appendChild(ta); ta.select();
    try { document.execCommand('copy'); cb(); } catch(e) {}
    document.body.removeChild(ta);
  }

  /* ═══════ WiFi (SSID & password) ═══════ */
  const wifi = { ssid: <%- JSON.stringify(portal.ssid).split('<').join('\\u003c') %>, pwd: '', show: false };
  function renderWifi() {
    const s = document.getElementById('wifi-ssid'); if (s) s.textContent = wifi.ssid;
    const p = document.getElementById('wifi-pwd'); if (p) p.textContent = '********';
  }

  /* ═══════ Status jaringan (situasional) ═══════ */
  const NET = {
    normal: { label: 'Normal' },
    maintenance: { label: 'Perbaikan', icon: 'ph-fill ph-warning-circle', title: <%- JSON.stringify((portal.notice && portal.notice.label) || 'Perbaikan Sistem').split('<').join('\\u003c') %>, msg: <%- JSON.stringify((portal.notice && portal.notice.text) || 'Sedang ada perbaikan sistem.').split('<').join('\\u003c') %><% if (portal.notice && portal.notice.estimateText) { %> + ' <strong><%= t('pwa.estimate_prefix','Estimasi:') %> <%= portal.notice.estimateText %></strong>'<% } %> },
    outage: { label: 'Gangguan', icon: 'ph-fill ph-x-circle', title: <%- JSON.stringify((portal.notice && portal.notice.label) || 'Gangguan Masal').split('<').join('\\u003c') %>, msg: <%- JSON.stringify((portal.notice && portal.notice.text) || 'Sedang terjadi gangguan jaringan.').split('<').join('\\u003c') %><% if (portal.notice && portal.notice.estimateText) { %> + ' <strong><%= t('pwa.estimate_prefix','Estimasi:') %> <%= portal.notice.estimateText %></strong>'<% } %> }
  };
  let netState = '<%= portal.netState %>';
  function setNetworkStatus(s) {
    const c = NET[s]; if (!c) return; netState = s;
    const badge = document.getElementById('net-badge'), al = document.getElementById('net-alert');
    badge.dataset.state = s;
    document.getElementById('net-badge-text').textContent = c.label;
    badge.setAttribute('aria-label', '<%= t('pwa.net.status_prefix','Status jaringan: ') %>' + c.label);
    if (s === 'normal') { al.hidden = true; return; }
    al.hidden = false; al.dataset.state = s;
    document.getElementById('net-alert-icon').className = c.icon + ' text-xl flex-shrink-0';
    document.getElementById('net-alert-title').textContent = c.title;
    document.getElementById('net-alert-msg').innerHTML = c.msg;
  }
  function cycleNetworkStatus() {
    const o = ['normal', 'maintenance', 'outage'];
    setNetworkStatus(o[(o.indexOf(netState) + 1) % o.length]);
  }
  function goToNetworkStatus() {
    if (netState === 'normal') { switchTab('network'); return; }
    const go = () => {
      const el = document.getElementById('net-alert'), sa = document.getElementById('scroll-area');
      const r = el.getBoundingClientRect(), s = sa.getBoundingClientRect();
      sa.scrollTo({ top: sa.scrollTop + (r.top - s.top) - (sa.clientHeight - r.height) / 2, behavior: 'smooth' });
      el.classList.remove('flash'); void el.offsetWidth; el.classList.add('flash');
    };
    if (activeTab !== 'home') { switchTab('home'); setTimeout(go, 240); } else go();
  }

  /* ═══════ Aksi dengan loading: blur → spinner → ikon sukses → toast ═══════ */
  let busy = false;
  function runAction(o = {}) {
    if (busy) return; busy = true;
    const ov = document.getElementById('busy'), ico = document.getElementById('busy-ico'), txt = document.getElementById('busy-text');
    const icon = o.icon || 'ph-fill ph-check-circle';
    ov.classList.remove('done');
    ico.innerHTML = '<i class="ph ph-circle-notch busy-spin"></i>';
    txt.textContent = o.loading || '<%= t('common.processing','Memproses...') %>';
    ov.classList.add('show');
    setTimeout(() => {
      ov.classList.add('done');
      ico.innerHTML = `<i class="${icon}"></i>`;
      txt.textContent = o.success || '<%= t('common.success','Berhasil') %>';
      setTimeout(() => {
        if (o.onDone) o.onDone();
        ov.classList.remove('show'); busy = false;
        showToast(o.toast || o.success || '<%= t('common.success','Berhasil') %>', false, icon);
      }, 900);
    }, o.duration || 1400);
  }
  function payWith(m) {
    const t = { 'Bayar Sekarang': ['Menyiapkan pembayaran...', 'Instruksi pembayaran dikirim'], QRIS: ['Membuat kode QRIS...', 'Kode QRIS siap dipakai'], Transfer: ['Mengambil detail rekening...', 'Detail transfer siap'] }[m];
    runAction({ loading: t[0], success: t[1], icon: 'ph-fill ph-credit-card', duration: 1600 });
  }
  function refreshDevices() { runAction({ loading: '<%= t('pwa.js.loading_devices','Memuat perangkat...') %>', success: '<%= t('pwa.js.devices_updated','Daftar perangkat diperbarui') %>', duration: 1200 }); }
  function confirmLogout(e) {
    e.preventDefault();
    openConfirm({ title: '<%= t('pwa.js.logout_title','Keluar dari akun?') %>', message: '<%= t('pwa.js.logout_msg','Anda perlu masuk lagi untuk mengakses portal.') %>', actionText: '<%= t('pwa.js.logout_yes','Ya, Keluar') %>',
      onConfirm: () => runAction({ loading: '<%= t('pwa.js.logging_out','Mengeluarkan akun...') %>', success: '<%= t('pwa.js.logged_out','Berhasil keluar') %>', duration: 1300 }) });
  }

  /* ═══════ Toast ═══════ */
  let toastTimer = null;
  function showToast(msg, isError = false, iconCls) {
    const toast = document.getElementById('toast');
    document.getElementById('toast-text').textContent = msg;
    toast.classList.toggle('error', isError);
    document.getElementById('toast-icon').className = iconCls || (isError ? 'ph-fill ph-x-circle' : 'ph-fill ph-check-circle');
    toast.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove('show'), 2400);
  }

  /* ═══════ Confirm modal (generic) ═══════ */
  let confirmCallback = null;
  function openConfirm(opts) {
    document.getElementById('confirm-title').textContent = opts.title || 'Konfirmasi';
    document.getElementById('confirm-message').textContent = opts.message || '';
    document.getElementById('confirm-action-btn').textContent = opts.actionText || 'Ya, Lanjutkan';
    confirmCallback = opts.onConfirm || null;
    document.getElementById('confirm-modal').classList.add('open');
  }
  function closeConfirm() {
    document.getElementById('confirm-modal').classList.remove('open');
    confirmCallback = null;
  }
  function runConfirm() {
    const cb = confirmCallback;
    closeConfirm();
    if (cb) cb();
  }

  /* ═══════ PPPoE Reconnect (dengan konfirmasi) ═══════ */
  function confirmReconnect() {
    openConfirm({
      title: '<%= t('pwa.js.reconnect_title','Reconnect PPPoE?') %>',
      message: '<%= t('pwa.js.reconnect_msg','Koneksi internet akan terputus sementara selama proses reconnect. Lanjutkan?') %>',
      actionText: '<%= t('pwa.js.reconnect_yes','Ya, Reconnect') %>',
      onConfirm: () => doReconnect()
    });
  }
  function doReconnect() {
    runAction({ loading: '<%= t('pwa.js.reconnecting','Menyambung ulang PPPoE...') %>', success: '<%= t('pwa.js.reconnected','PPPoE tersambung') %>', duration: 2000 });
  }

  /* ═══════ Restart Modem (dengan konfirmasi) ═══════ */
  function confirmRestartModem() {
    openConfirm({
      title: '<%= t('pwa.js.restart_title','Restart Modem?') %>',
      message: '<%= t('pwa.js.restart_msg_old','Modem ZTE F609 akan direstart. Koneksi internet akan terputus sekitar 1-2 menit.') %>',
      actionText: '<%= t('pwa.js.restart_yes','Ya, Restart') %>',
      onConfirm: () => {
        runAction({ loading: '<%= t('pwa.js.restarting','Mengirim perintah restart...') %>', success: '<%= t('pwa.js.restarted','Modem sedang restart') %>', toast: '<%= t('pwa.js.restart_sent','Perintah restart dikirim ke modem') %>', duration: 1800 });
      }
    });
  }

  /* ═══════ Poll ONU ═══════ */
  function pollOnu() {
    runAction({ loading: '<%= t('pwa.js.polling','Memperbarui status ONU...') %>', success: '<%= t('pwa.js.polled','Status ONU diperbarui') %>', duration: 1200 });
  }

  /* ═══════ Setting Modal ═══════ */
  function openSettingModal() {
    if ((window.__PORTAL__ || {}).onuDetected === false) { showToast('<%= t('pwa.js.onu_missing_wifi2','ONU tidak terdeteksi — pengaturan WiFi tidak tersedia.') %>', true); setTimeout(window.openOnuModal, 900); return; }
    document.getElementById('ssid-input').value = wifi.ssid;
    document.getElementById('pwd-input').value = '';
    document.getElementById('setting-modal').classList.add('open');
  }
  function closeSettingModal() {
    document.getElementById('setting-modal').classList.remove('open');
  }
  function togglePwdVisibility(btn) {
    const input = document.getElementById('pwd-input');
    const icon = btn.querySelector('i');
    if (input.type === 'password') {
      input.type = 'text';
      icon.className = 'ph ph-eye-slash text-lg';
    } else {
      input.type = 'password';
      icon.className = 'ph ph-eye text-lg';
    }
  }
  function saveWifiSetting() {
    const ssid = document.getElementById('ssid-input').value.trim();
    const pwd = document.getElementById('pwd-input').value;
    if (!ssid) { showToast('<%= t('pwa.js.ssid_empty','SSID tidak boleh kosong') %>', true); return; }
    if (pwd.length < 8) { showToast('Password minimal 8 karakter', true); return; }
    runAction({ loading: '<%= t('pwa.js.saving_wifi','Menyimpan pengaturan WiFi...') %>', success: '<%= t('pwa.js.wifi_saved','Pengaturan WiFi tersimpan') %>', icon: 'ph-bold ph-wifi-high', duration: 1600, onDone: () => { wifi.ssid = ssid; wifi.pwd = pwd; renderWifi(); closeSettingModal(); } });
  }
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && !busy) { closeSettingModal(); closeConfirm(); }
  });

  /* ═══════ Speed Test ═══════ */
  let stTesting = false;
  function _stGauge(mbps, maxMbps) {
    const fill = document.getElementById('st-gauge-fill'); if (!fill) return;
    const pct = Math.min(Math.max(mbps / (maxMbps || 100), 0), 1);
    fill.style.strokeDashoffset = 424.1 * (1 - pct);
  }
  function renderSpeedHistory() {
    const box = document.getElementById('stHistory'); if (!box) return;
    let h = [];
    try { h = JSON.parse(localStorage.getItem('sf-speed-history') || '[]'); } catch (e) { h = []; }
    if (!h.length) { box.innerHTML = '<div class="list-row"><p class="text-sm" style="color:var(--muted)"><%= t('pwa.speedtest.no_history','Belum ada riwayat tes.') %></p></div>'; return; }
    box.innerHTML = h.map(function (r, i) {
      const d = new Date(r.t || Date.now());
      const when = d.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) + ' · ' + d.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
      const val = Number(r.d) || 0;
      const label = val >= 40 ? 'SANGAT BAIK' : val >= 15 ? 'BAIK' : 'CUKUP';
      return '<div class="list-row"' + (i < h.length - 1 ? ' style="border-bottom:1px solid var(--border);"' : '') + '>'
        + '<div class="flex items-center gap-3"><div class="w-9 h-9 rounded-[11px] flex items-center justify-center" style="background:var(--surface-2);"><i class="ph-fill ph-gauge" style="color:var(--lime);font-size:16px;"></i></div>'
        + '<div><p class="text-sm font-semibold" style="color:var(--text);">' + val.toFixed(1) + ' Mbps</p><p class="text-[11px]" style="color:var(--muted);">' + when + ' · ↓' + val.toFixed(1) + ' ↑' + (Number(r.u) || 0).toFixed(1) + ' · ' + (r.p || '-') + 'ms</p></div></div>'
        + '<span class="text-[10px] font-semibold" style="color:var(--lime);">' + label + '</span></div>';
    }).join('');
  }
  window.startSpeedTest = async function () {
    if (stTesting) return; stTesting = true;
    const btn = document.getElementById('st-start-btn');
    const valueEl = document.getElementById('st-value');
    const statusEl = document.getElementById('st-status');
    const t0El = document.getElementById('st-download');
    const origHTML = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<i class="ph ph-circle-notch" style="animation:spin 1s linear infinite;"></i> Mengukur...';
    valueEl.textContent = '0'; _stGauge(0);
    try {
      // 1) PING
      statusEl.textContent = 'Mengukur latensi...';
      const pings = [];
      for (let i = 0; i < 5; i++) {
        const s0 = performance.now();
        await fetch('/customer/speedtest/ping?_=' + Date.now(), { cache: 'no-store', credentials: 'same-origin' });
        pings.push(performance.now() - s0);
      }
      pings.sort(function (a, b) { return a - b; });
      const pingMs = Math.round(pings[1] != null ? pings[1] : pings[0]);
      document.getElementById('st-ping').innerHTML = pingMs + '<small>ms</small>';

      // 2) DOWNLOAD (ukur selama ~8 detik)
      statusEl.textContent = '<%= t('pwa.js.speed_down','Mengukur kecepatan unduh...') %>';
      const ctrl = new AbortController();
      const d0 = performance.now();
      let dbytes = 0;
      const anim = setInterval(function () {
        const secs = (performance.now() - d0) / 1000;
        if (secs > 0.4) { const m = (dbytes * 8 / 1e6) / secs; valueEl.textContent = m.toFixed(1); _stGauge(m); }
      }, 250);
      try {
        const resp = await fetch('/customer/speedtest/download?ms=8000&_=' + Date.now(), { cache: 'no-store', credentials: 'same-origin', signal: ctrl.signal });
        if (!resp.ok || !resp.body) throw new Error('HTTP ' + resp.status);
        const reader = resp.body.getReader();
        while (true) {
          const r = await reader.read();
          if (r.done) break;
          dbytes += r.value.length;
          if ((performance.now() - d0) / 1000 >= 8) { try { ctrl.abort(); } catch (e) {} break; }
        }
      } catch (e) { if (!dbytes) throw e; }
      clearInterval(anim);
      const dsecs = Math.max((performance.now() - d0) / 1000, 0.7);
      const downMbps = (dbytes * 8 / 1e6) / dsecs;
      valueEl.textContent = downMbps.toFixed(1); _stGauge(downMbps);
      t0El.innerHTML = downMbps.toFixed(1) + '<small>Mbps</small>';

      // 3) UPLOAD (ukur selama ~8 detik)
      statusEl.textContent = '<%= t('pwa.js.speed_up','Mengukur kecepatan unggah...') %>';
      const upChunk = new Uint8Array(1024 * 1024);
      for (let i = 0; i < upChunk.length; i += 65536) upChunk.set(ST_RAND.subarray(0, Math.min(65536, upChunk.length - i)), i);
      const u0 = performance.now();
      let ubytes = 0;
      while ((performance.now() - u0) < 8000) {
        const r = await fetch('/customer/speedtest/upload?_=' + Date.now(), { method: 'POST', headers: { 'Content-Type': 'application/octet-stream' }, body: upChunk, cache: 'no-store', credentials: 'same-origin' });
        if (!r.ok) break;
        ubytes += upChunk.length;
      }
      const usecs = Math.max((performance.now() - u0) / 1000, 0.7);
      const upMbps = (ubytes * 8 / 1e6) / usecs;
      document.getElementById('st-upload').innerHTML = upMbps.toFixed(1) + '<small>Mbps</small>';

      statusEl.textContent = '<%= t('pwa.js.speed_done','Tes selesai') %>';
      try {
        const h = JSON.parse(localStorage.getItem('sf-speed-history') || '[]');
        h.unshift({ d: +downMbps.toFixed(1), u: +upMbps.toFixed(1), p: pingMs, t: Date.now() });
        localStorage.setItem('sf-speed-history', JSON.stringify(h.slice(0, 5)));
      } catch (e) {}
      renderSpeedHistory();
      window.showToast('Tes selesai — ↓' + downMbps.toFixed(1) + ' Mbps · ↑' + upMbps.toFixed(1) + ' Mbps · ' + pingMs + ' ms');
    } catch (e) {
      statusEl.textContent = '<%= t('pwa.js.speed_done_fail','Tes gagal') %>';
      window.showToast('<%= t('pwa.js.speed_failed','Tes kecepatan gagal:') %>' + (e && e.message ? e.message : 'error'), true);
    }
    btn.disabled = false;
    btn.innerHTML = '<i class="ph-bold ph-arrows-clockwise text-lg"></i> Tes Ulang';
    stTesting = false;
  };
  var ST_RAND = (function () { var b = new Uint8Array(65536); if (window.crypto && crypto.getRandomValues) crypto.getRandomValues(b); return b; })();
  renderSpeedHistory();
  function startSpeedTest_DISABLED() {
    if (stTesting) return;
    stTesting = true;
    const btn = document.getElementById('st-start-btn');
    const valueEl = document.getElementById('st-value');
    const statusEl = document.getElementById('st-status');
    const fill = document.getElementById('st-gauge-fill');

    btn.disabled = true;
    btn.innerHTML = '<i class="ph ph-circle-notch" style="animation:spin 1s linear infinite;"></i> Mengukur...';
    statusEl.textContent = 'Mengukur ping...';
    valueEl.textContent = '0';
    fill.style.strokeDashoffset = 424.1;

    const maxMbps = 100;
    const targetMbps = 47 + Math.random() * 4;

    setTimeout(() => {
      statusEl.textContent = '<%= t('pwa.js.speed_measuring','Mengukur kecepatan...') %>';
      let current = 0;
      const step = () => {
        current += (targetMbps - current) * 0.12 + 0.4;
        if (current > targetMbps) current = targetMbps;
        const pct = Math.min(current / maxMbps, 1);
        fill.style.strokeDashoffset = 424.1 * (1 - pct);
        valueEl.textContent = current.toFixed(1);
        if (current < targetMbps - 0.3) {
          requestAnimationFrame(step);
        } else {
          valueEl.textContent = targetMbps.toFixed(1);
          statusEl.textContent = '<%= t('pwa.js.speed_done','Tes selesai') %>';
          document.getElementById('st-download').innerHTML = targetMbps.toFixed(1) + '<small>Mbps</small>';
          document.getElementById('st-upload').innerHTML = (targetMbps - 1.5).toFixed(1) + '<small>Mbps</small>';
          document.getElementById('st-ping').innerHTML = (7 + Math.floor(Math.random()*3)) + '<small>ms</small>';
          btn.disabled = false;
          btn.innerHTML = '<i class="ph-fill ph-arrow-clockwise text-lg"></i> Tes Ulang';
          stTesting = false;
          showToast('Tes kecepatan selesai');
        }
      };
      requestAnimationFrame(step);
    }, 700);
  }

  /* ═══════ Theme ═══════ */
  function applyTheme(isDark) {
    const html = document.documentElement;
    if (isDark) { html.classList.add('dark'); html.classList.remove('light'); }
    else { html.classList.remove('dark'); html.classList.add('light'); }
    const barIcon = document.getElementById('theme-icon-bar');
    const mobIcon = document.getElementById('theme-icon-mobile');
    const iconCls = isDark ? 'ph-fill ph-moon' : 'ph-fill ph-sun';
    if (barIcon) barIcon.className = `${iconCls} text-base`;
    if (mobIcon) mobIcon.className = `${iconCls} text-lg`;
    const topbar = document.getElementById('topbar');
    if (topbar) topbar.style.background = isDark ? 'rgba(10,13,20,0.72)' : 'rgba(240,242,248,0.72)';
    const appWrap = document.getElementById('app-wrap');
    if (appWrap) appWrap.style.background = 'var(--bg)';
    const bottomNav = document.querySelector('nav.bottom-nav');
    if (bottomNav) bottomNav.style.background = isDark ? 'rgba(10,13,20,0.82)' : 'rgba(240,242,248,0.82)';
    const previewBar = document.getElementById('preview-bar');
    if (previewBar) previewBar.style.background = isDark ? 'rgba(20,24,36,0.72)' : 'rgba(255,255,255,0.72)';
  }
  function toggleTheme() {
    const isDark = document.documentElement.classList.contains('dark');
    applyTheme(!isDark);
    localStorage.setItem('sf-theme', !isDark ? 'dark' : 'light');
  }

  /* ═══════ Preview Switcher ═══════ */
  function setPreview(mode) {
    const body = document.body;
    const dBtn = document.getElementById('btn-desktop');
    const mBtn = document.getElementById('btn-mobile');
    if (mode === 'mobile') {
      body.classList.add('preview-mobile');
      dBtn.classList.remove('active'); mBtn.classList.add('active');
    } else {
      body.classList.remove('preview-mobile');
      mBtn.classList.remove('active'); dBtn.classList.add('active');
    }
    setTimeout(() => {
      window.dispatchEvent(new Event('resize'));
      if (swiper) swiper.update();
    }, 300);
  }

  /* ═══════ Topbar shadow ═══════ */
  const scrollArea = document.getElementById('scroll-area');
  const topbar = document.getElementById('topbar');
  if (scrollArea && topbar) {
    scrollArea.addEventListener('scroll', () => {
      topbar.classList.toggle('scrolled', scrollArea.scrollTop > 4);
    }, { passive: true });
  }

  /* ═══════ Init ═══════ */
  function initSwiper() {
    if (swiper || typeof Swiper === 'undefined') return;
    swiper = new Swiper('.promoSwiper', {
      loop: true,
      autoplay: { delay: 4000, disableOnInteraction: false, pauseOnMouseEnter: true },
      pagination: { el: '.swiper-pagination', dynamicBullets: true },
      effect: 'slide', speed: 600,
      observer: true,
      observeParents: true,
    });
  }
  window.addEventListener('load', () => {
    initSwiper();
    setTimeout(() => { if (swiper) swiper.update(); }, 500);
  });

  window.addEventListener('DOMContentLoaded', () => {
    initSwiper();
    const saved = localStorage.getItem('sf-theme') || 'dark';
    applyTheme(saved === 'dark');
    animateSpeedRing();
    renderWifi();
    setNetworkStatus(netState);
  });
</script>
<script>
window.__PORTAL__ = <%- portalJson %>;
(function(){
  var P = window.__PORTAL__ || {};
  function esc(v){ return String(v==null?'':v).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];}); }
  function realAction(url, o){
    o = o || {};
    if (typeof busy !== 'undefined' && busy) return; if (typeof busy !== 'undefined') busy = true;
    var ov=document.getElementById('busy'), ico=document.getElementById('busy-ico'), txt=document.getElementById('busy-text');
    ov.classList.remove('done', 'error');
    var _om0 = document.getElementById('onu-modal'); if (_om0) _om0.classList.remove('open'); ico.innerHTML='<i class="ph ph-circle-notch busy-spin"></i>'; txt.textContent=o.loading||'<%= t('common.processing','Memproses...') %>'; ov.classList.add('show');
    var body = new URLSearchParams(o.body||{}).toString();
    fetch(url,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded','X-Requested-With':'fetch','Accept':'application/json'},body:body,credentials:'same-origin'})
    .then(function(r){ return r.json().catch(function(){ return { success: true }; }); })
    .then(function(res){
      var ok = !(res && res.success === false);
      ov.classList.toggle('error', !ok);
      var _om = document.getElementById('onu-modal'); if (_om) _om.classList.remove('open');
      ov.classList.add('done'); ico.innerHTML='<i class="'+(ok?'ph-fill ph-check-circle':'ph-fill ph-x-circle')+'"></i>';
      txt.textContent=(res && res.message) || (ok?o.success:'<%= t('common.failed','Gagal') %>') || 'Selesai';
      setTimeout(function(){
        ov.classList.remove('show'); if (typeof busy !== 'undefined') busy=false;
        if (o.onDone) { try { o.onDone(); } catch(e) {} }
        if (o.redirect) { window.location.href=o.redirect; return; }
        if (ok && o.reload) setTimeout(function(){ location.reload(); }, 350);
      }, 1400);
    })
    .catch(function(){ ov.classList.remove('show'); if (typeof busy !== 'undefined') busy=false; showToast('<%= t('pwa.js.conn_failed','Koneksi gagal') %>', true); });
  }
  window.realAction = realAction;

  // Semua notifikasi ditampilkan sebagai overlay (bukan toast kecil di bawah)
  window.showToast = function(msg, isError, iconCls){
    var ov = document.getElementById('busy'), ico = document.getElementById('busy-ico'), txt = document.getElementById('busy-text');
    if (!ov) return;
    ov.classList.remove('done');
    ov.classList.toggle('error', !!isError);
    var _om1 = document.getElementById('onu-modal'); if (_om1) _om1.classList.remove('open');
    ico.innerHTML = '<i class="ph ph-circle-notch busy-spin"></i>';
    txt.textContent = '<%= t('common.processing','Memproses...') %>';
    ov.classList.add('show');
    setTimeout(function(){
      ov.classList.add('done');
      ico.innerHTML = '<i class="' + (iconCls || (isError ? 'ph-fill ph-x-circle' : 'ph-fill ph-check-circle')) + '"></i>';
      txt.textContent = msg || (isError ? '<%= t('common.failed','Gagal') %>' : '<%= t('common.success','Berhasil') %>');
      setTimeout(function(){ ov.classList.remove('show'); }, 1250);
    }, 450);
  };

  // Riwayat pembayaran
  var hl = document.getElementById('historyList');
  if (hl) {
    if (!P.history || !P.history.length) { hl.innerHTML='<div class="list-row"><p class="text-sm" style="color:var(--muted)"><%= t('pwa.billing.no_history','Belum ada riwayat pembayaran.') %></p></div>'; }
    else hl.innerHTML = P.history.map(function(h){
      return '<div class="list-row press" style="border-bottom:1px solid var(--border);">'
        + '<div class="flex items-center gap-3"><div class="w-9 h-9 rounded-[11px] flex items-center justify-center" style="background:rgba(173,255,47,0.1);"><i class="ph-fill ph-check-circle" style="color:var(--lime);font-size:18px;"></i></div>'
        + '<div><p class="text-sm font-semibold" style="color:var(--text);">'+esc(h.month)+'</p><p class="text-[11px]" style="color:var(--muted);">'+esc(h.paidText)+'</p></div></div>'
        + '<div class="text-right"><p class="text-sm font-bold" style="color:var(--text);">'+esc(h.amount)+'</p><span class="text-[10px] font-semibold" style="color:var(--lime);">'+esc(h.statusText||'<%= t('pwa.status.paid','LUNAS') %>')+'</span></div></div>';
    }).join('');
  }
  // Perangkat terhubung
  var dl = document.getElementById('devicesList');
  if (dl) {
    if (!P.devices || !P.devices.length) { dl.innerHTML='<div class="list-row"><p class="text-sm" style="color:var(--muted)"><%= t('pwa.net.no_devices','Tidak ada perangkat terdeteksi.') %></p></div>'; }
    else dl.innerHTML = P.devices.map(function(d,i){
      return '<div class="list-row press"'+(i<P.devices.length-1?' style="border-bottom:1px solid var(--border);"':'')+'>'
        + '<div class="flex items-center gap-3"><div class="w-10 h-10 rounded-[12px] flex items-center justify-center" style="background:var(--surface-2);"><i class="ph-fill '+esc(d.icon||'ph-device-mobile')+' text-xl" style="color:var(--lime);"></i></div>'
        + '<div><p class="text-sm font-semibold" style="color:var(--text);">'+esc(d.name)+'</p><p class="text-[10px]" style="color:var(--muted);">'+esc(d.mac)+'</p></div></div>'
        + '<div class="text-right">'+(d.band?'<span class="text-xs font-bold px-2 py-0.5 rounded-full" style="background:rgba(173,255,47,0.1);color:var(--lime);">'+esc(d.band)+'</span>':'')+(d.rssi?'<p class="text-[10px] mt-0.5" style="color:var(--muted);">'+esc(d.rssi)+'</p>':'')+'</div></div>';
    }).join('');
    var cnt = document.getElementById('devicesCount'); if (cnt) cnt.textContent = '<%= t('pwa.net.devices_connected','Perangkat Terhubung (') %>' + (P.devices||[]).length + ')';
  }
  // Promo slides
  var promo = document.querySelector('.promoSwiper .swiper-wrapper');
  if (promo) {
    fetch('/customer/api/promo-slides', {cache:'no-store'}).then(function(r){return r.json();}).then(function(sl){
      if (!sl || !sl.length) { var _pb = document.getElementById('promoBox'); if (_pb) _pb.style.display = 'none'; return; }
      promo.innerHTML = sl.map(function(x){
        var img = '<img src="'+esc(x.image_path)+'" alt="'+esc(x.title||'Promo')+'" style="width:100%;height:100%;object-fit:cover;">';
        var inner = x.url ? '<a href="'+esc(x.url)+'" target="_blank" rel="noopener external">'+img+'</a>' : img;
        return '<div class="swiper-slide relative aspect-[2/1] md:aspect-[21/9]">'+inner+'</div>';
      }).join('');
      if (typeof swiper !== 'undefined' && swiper) { try { swiper.update(); } catch(e){} }
    }).catch(function(){});
  }
  // Override aksi -> endpoint nyata
  window.payWith = function(m){
    if (P.bill && P.bill.id) { window.location.href = '/customer/payment/create/' + P.bill.id + '?method=' + encodeURIComponent(m || 'BayarSekarang'); }
    else showToast('Tidak ada tagihan aktif', true);
  };
  /* ═══ Speed Test: muat ulang & bersihkan cache ═══ */
  window.reloadSpeedtest = function () {
    var f = document.getElementById('speedtestFrame');
    if (!f) return;
    var base = f.getAttribute('data-base');
    if (!base) { base = String(f.getAttribute('src') || ''); f.setAttribute('data-base', base); }
    f.src = base + (base.indexOf('?') === -1 ? '?' : '&') + '_ts=' + Date.now();
    if (typeof window.showToast === 'function') window.showToast('<%= t("pwa.speedtest.reloading","Memuat ulang Speed Test...") %>', false, 'bi bi-arrow-clockwise');
  };
  window.clearAppCache = function () {
    var doIt = function () {
      var jobs = [];
      try { if ('serviceWorker' in navigator) jobs.push(navigator.serviceWorker.getRegistrations().then(function (rs) { return Promise.all(rs.map(function (r) { return r.unregister().catch(function () {}); })); })); } catch (e) {}
      try { if (window.caches && caches.keys) jobs.push(caches.keys().then(function (ks) { return Promise.all(ks.map(function (k) { return caches.delete(k).catch(function () {}); })); })); } catch (e) {}
      Promise.all(jobs).catch(function () {}).then(function () {
        try { sessionStorage.clear(); } catch (e) {}
        location.reload();
      });
    };
    try {
      if (typeof openConfirm === 'function') {
        openConfirm({ title: '<%= t("pwa.cache.confirm_title","Bersihkan Cache?") %>', message: '<%= t("pwa.cache.confirm_msg","Cache aplikasi akan dihapus lalu halaman dimuat ulang.") %>', actionText: '<%= t("pwa.cache.confirm_yes","Ya, Bersihkan") %>', onConfirm: doIt });
      } else { doIt(); }
    } catch (e) { doIt(); }
  };

  window.doReconnect = function(){ realAction('/customer/customer/reconnect', {loading:'<%= t('pwa.js.reconnecting','Menyambung ulang PPPoE...') %>', success:'<%= t('pwa.js.reconnected','PPPoE tersambung') %>', reload:true}); };
  window.confirmLogout = function(e){ if(e && e.preventDefault) e.preventDefault();
    openConfirm({ title:'<%= t('pwa.js.logout_title','Keluar dari akun?') %>', message:'<%= t('pwa.js.logout_msg','Anda perlu masuk lagi untuk mengakses portal.') %>', actionText:'<%= t('pwa.js.logout_yes','Ya, Keluar') %>',
      onConfirm:function(){ realAction('/customer/logout', {loading:'<%= t('pwa.js.logging_out','Mengeluarkan akun...') %>', success:'<%= t('pwa.js.logged_out','Berhasil keluar') %>', redirect:'/customer/login'}); } }); };
  window.confirmRestartModem = function(){
    if (P.onuDetected === false) { showToast('<%= t('pwa.js.onu_missing_restart','ONU tidak terdeteksi — restart modem tidak dapat dilakukan.') %>', true); setTimeout(window.openOnuModal, 900); return; }
    openConfirm({ title:'<%= t('pwa.js.restart_title','Restart Modem?') %>', message:'Modem '+(P.onuModel||'')+'<%= t('pwa.js.restart_msg',' akan direstart. Koneksi terputus sekitar 1-2 menit.') %>', actionText:'<%= t('pwa.js.restart_yes','Ya, Restart') %>',
      onConfirm:function(){ realAction('/customer/reboot', {loading:'<%= t('pwa.js.restarting','Mengirim perintah restart...') %>', success:'<%= t('pwa.js.restarted','Modem sedang restart') %>', toast:'<%= t('pwa.js.restart_sent_short','Perintah restart dikirim') %>'}); } }); };
  function _setTxt(id, val){ var el=document.getElementById(id); if (el && val != null) el.textContent = val; }
  function _applySummary(s){
    if (!s || s.ok === false) return;
    _setTxt('onu-model', s.model); _setTxt('onu-ip', s.ip); _setTxt('onu-uptime', s.uptime);
    _setTxt('onu-serial', s.serial); _setTxt('onu-rx', s.rx); _setTxt('pppoe-user', s.pppoeUser);
    var ms = document.getElementById('modem-status');
    if (ms) {
      ms.textContent = s.onuOnline ? 'Normal' : (s.onuDetected ? 'Offline' : '<%= t('pwa.js.st_na','Tidak terdeteksi') %>');
      ms.style.color = s.onuOnline ? 'var(--lime)' : (s.onuDetected ? '#FBBF24' : '#EF4444');
    }
    _setTxt('modem-sub', s.onuOnline ? '<%= t('pwa.js.st_connected','ONU / Modem terkoneksi') %>' : (s.onuDetected ? '<%= t('pwa.js.st_detected_no_conn','ONU terdeteksi, koneksi terputus') %>' : '<%= t('pwa.js.st_not_detected','ONU / Modem tidak terdeteksi') %>'));
    var ob = document.getElementById('onu-badge');
    if (ob) { ob.innerHTML = '<span class="dot"></span>' + (s.onuOnline ? 'Online' : 'Offline'); ob.classList.toggle('badge-offline', !s.onuOnline); }
    var pb = document.getElementById('pppoe-badge');
    if (pb) { pb.innerHTML = '<span class="dot"></span>' + (s.pppoeOnline ? 'Online' : 'Offline'); pb.classList.toggle('badge-offline', !s.pppoeOnline); }
    var btn = document.getElementById('pppoe-btn');
    if (btn) {
      if (s.pppoeOnline) { btn.disabled = false; btn.style.opacity=''; btn.style.filter=''; btn.style.cursor=''; btn.innerHTML = '<i class="ph-bold ph-arrow-clockwise text-base"></i> Reconnect PPPoE'; }
      else { btn.disabled = true; btn.style.opacity='.45'; btn.style.filter='grayscale(.5)'; btn.style.cursor='not-allowed'; btn.innerHTML = '<i class="ph-bold ph-arrow-clockwise text-base"></i> PPPoE Offline'; }
    }
    var w = document.getElementById('wifi-ssid'); if (w) w.textContent = s.ssid;
  }
  function _refreshSummary(){
    return fetch('/customer/api/device-summary', { cache:'no-store', credentials:'same-origin' })
      .then(function(r){ return r.json(); }).then(_applySummary).catch(function(){});
  }
  window.pollOnu = function(){ realAction('/customer/api/device/refresh', {loading:'<%= t('pwa.js.polling','Memperbarui status ONU...') %>', success:'<%= t('pwa.js.polled','Status ONU diperbarui') %>', onDone:_refreshSummary}); };
  window.refreshDevices = function(){ realAction('/customer/api/device/refresh', {loading:'<%= t('pwa.js.loading_devices','Memuat perangkat...') %>', success:'<%= t('pwa.js.devices_updated','Daftar perangkat diperbarui') %>', onDone:_refreshSummary}); };
  window.saveWifiSetting = function(){
    if ((window.__PORTAL__ || {}).onuDetected === false) { showToast('<%= t('pwa.js.onu_missing_wifi','ONU tidak terdeteksi — ubah sandi tidak dapat dilakukan.') %>', true); setTimeout(window.openOnuModal, 900); return; }
    var ssid = document.getElementById('ssid-input').value.trim();
    var pwd  = document.getElementById('pwd-input').value;
    if (!ssid) { showToast('<%= t('pwa.js.ssid_empty','SSID tidak boleh kosong') %>', true); return; }
    if (pwd && pwd.length < 8) { showToast('Password minimal 8 karakter', true); return; }
    var chain = Promise.resolve();
    if (pwd) chain = chain.then(function(){ return doPost('/customer/change-password', {password:pwd}); });
    chain = chain.then(function(){ return doPost('/customer/change-ssid', {ssid:ssid}); });
    chain.then(function(){ wifi.ssid = ssid; wifi.pwd = pwd; renderWifi(); closeSettingModal(); showToast('<%= t('pwa.js.wifi_saved','Pengaturan WiFi tersimpan') %>'); })
         .catch(function(err){ showToast(err||'<%= t('pwa.js.save_failed','Gagal menyimpan') %>', true); });
  };
  function doPost(url, body){
    return fetch(url,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded','X-Requested-With':'fetch','Accept':'application/json'},body:new URLSearchParams(body).toString(),credentials:'same-origin'})
      .then(function(r){ return r.json().catch(function(){ return {ok:true}; }); })
      .then(function(res){ if (res && (res.ok===false || res.success===false)) throw (res.message||'<%= t('common.failed','Gagal') %>'); return res; });
  }
  // ── Panel notifikasi ──
  window.openNotifPanel = function(){
    var box = document.getElementById('notifList');
    var list = P.notifications || [];
    if (box) {
      if (!list.length) box.innerHTML = '<p class="text-sm" style="color:var(--muted);text-align:center;padding:18px 0;"><%= t('pwa.notif.empty','Belum ada notifikasi.') %></p>';
      else box.innerHTML = list.map(function(n){
        var color = n.type === 'payment' ? 'var(--lime)' : (n.type === 'warning' ? '#FBBF24' : 'var(--text)');
        var icon = n.type === 'payment' ? 'ph-fill ph-check-circle' : (n.type === 'warning' ? 'ph-fill ph-warning-circle' : 'ph-fill ph-info');
        return '<div style="background:var(--surface-2);border:1px solid var(--border);border-radius:14px;padding:12px 14px;">'
          + '<div style="display:flex;gap:8px;align-items:flex-start;">'
          + '<i class="'+icon+'" style="color:'+color+';font-size:18px;margin-top:1px;flex-shrink:0;"></i>'
          + '<div style="min-width:0;"><p style="font-weight:700;font-size:13px;color:var(--text);margin:0 0 3px;">'+esc(n.title)+'</p>'
          + '<p style="font-size:12px;color:var(--muted);margin:0 0 4px;line-height:1.45;">'+esc(n.message)+'</p>'
          + '<p style="font-size:10px;color:var(--muted-2);margin:0;">'+esc(n.time||'')+'</p></div></div></div>';
      }).join('');
    }
    document.getElementById('notif-modal').classList.add('open');
  };
  window.closeNotifPanel = function(){ document.getElementById('notif-modal').classList.remove('open'); };
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape') window.closeNotifPanel(); });
  // ── Unduh PDF tagihan + notifikasi (proses -> berhasil/gagal) ──
  window.downloadInvoicePdf = function(id, code){
    if (typeof busy !== 'undefined' && busy) return;
    if (typeof busy !== 'undefined') busy = true;
    var ov = document.getElementById('busy'), ico = document.getElementById('busy-ico'), txt = document.getElementById('busy-text');
    ov.classList.remove('done', 'error');
    var _om = document.getElementById('onu-modal'); if (_om) _om.classList.remove('open');
    ico.innerHTML = '<i class="ph ph-circle-notch busy-spin"></i>';
    txt.textContent = 'Menyiapkan PDF...';
    ov.classList.add('show');
    fetch('/customer/invoice/' + id + '/pdf?dl=1', { credentials: 'same-origin', cache: 'no-store' })
      .then(function(r){ if (!r.ok) throw new Error('HTTP ' + r.status); return r.blob(); })
      .then(function(blob){
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url; a.download = '<%= t('pwa.js.bill_prefix','Tagihan-') %>' + (code || '') + '.pdf';
        document.body.appendChild(a); a.click();
        setTimeout(function(){ try { URL.revokeObjectURL(url); a.remove(); } catch(e) {} }, 5000);
        ov.classList.add('done'); ov.classList.remove('error');
        ico.innerHTML = '<i class="ph-fill ph-check-circle"></i>';
        txt.textContent = '<%= t('pwa.js.pdf_ok','PDF berhasil diunduh (') %>' + (blob.size > 1024 ? Math.round(blob.size / 1024) + ' KB' : blob.size + ' B') + ')';
        setTimeout(function(){ ov.classList.remove('show'); if (typeof busy !== 'undefined') busy = false; }, 1500);
      })
      .catch(function(){
        ov.classList.add('done'); ov.classList.add('error');
        ico.innerHTML = '<i class="ph-fill ph-x-circle"></i>';
        txt.textContent = '<%= t('pwa.js.pdf_fail','Gagal mengunduh PDF. Coba lagi ya.') %>';
        setTimeout(function(){ ov.classList.remove('show'); if (typeof busy !== 'undefined') busy = false; }, 1700);
      });
  };

  // ── Profil: modal info/layanan/riwayat/tentang + salin + toggle promo ──
  window.copyText = function(txt, btn){
    var done = function(){
      if (btn) { var i = btn.querySelector('i'); if (i) { var old = i.className; i.className = 'bi bi-check-lg'; setTimeout(function(){ i.className = old; }, 1400); } }
      window.showToast('Disalin: ' + txt);
    };
    if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(txt).then(done).catch(function(){ fallbackCopy(txt, done); });
    else fallbackCopy(txt, done);
  };
  window.copyLayanan = function(){
    var t = 'PPPoE: ' + (P.pppoeUser || '-') + '\nIP: ' + (P.pppoeIp || '-') + '\nSerial ONU: ' + (P.serialNumber || '-') + '\nModel: ' + (P.onuModel || '-') + '\nSSID: ' + (P.ssid || '-');
    window.copyText(t, null);
  };
  window.openInfoPribadi = function(){ document.getElementById('info-modal').classList.add('open'); };
  window.closeInfoPribadi = function(){ document.getElementById('info-modal').classList.remove('open'); };
  window.openLayanan = function(){ document.getElementById('layanan-modal').classList.add('open'); };
  window.closeLayanan = function(){ document.getElementById('layanan-modal').classList.remove('open'); };
  window.openRiwayat = function(){ document.getElementById('riwayat-modal').classList.add('open'); };
  window.closeRiwayat = function(){ document.getElementById('riwayat-modal').classList.remove('open'); };
  window.openTentang = function(){ document.getElementById('tentang-modal').classList.add('open'); };
  window.closeTentang = function(){ document.getElementById('tentang-modal').classList.remove('open'); };
  function _promoOn(){ try { return localStorage.getItem('sf-promo-show') !== 'off'; } catch(e) { return true; } }
  function _applyPromo(){
    var on = _promoOn();
    var el = document.getElementById('promoBox');
    if (el) el.style.display = on ? '' : 'none';
    var v = document.getElementById('promoVal'); if (v) v.textContent = on ? '<%= t('pwa.promo.show_short','Tampil') %>' : '<%= t('pwa.promo.hidden','Disembunyikan') %>';
    if (on && typeof swiper !== 'undefined' && swiper) { try { swiper.update(); } catch(e) {} }
  }
  window.togglePromo = function(e){
    if (e && e.preventDefault) e.preventDefault();
    try { localStorage.setItem('sf-promo-show', _promoOn() ? 'off' : 'on'); } catch(_) {}
    _applyPromo();
    window.showToast(_promoOn() ? 'Promo ditampilkan' : 'Promo disembunyikan');
  };
  _applyPromo();

  // ── Bantuan: kirim gangguan (foto opsional) / chat WA ──
  window.openBantuan = function(){
    var m = document.getElementById('bantuan-modal'); if (m) m.classList.add('open');
    try {
      if (navigator.geolocation) navigator.geolocation.getCurrentPosition(function(p){
        var la=document.getElementById('bt-lat'), lo=document.getElementById('bt-lng');
        if (la) la.value = p.coords.latitude; if (lo) lo.value = p.coords.longitude;
      }, function(){}, { enableHighAccuracy:false, timeout:4000, maximumAge:600000 });
    } catch(e) {}
  };
  window.closeBantuan = function(){ var m = document.getElementById('bantuan-modal'); if (m) m.classList.remove('open'); };
  window.openWaHelp = function(){ window.open('https://wa.me/' + (P.waPhone || ''), '_blank'); };
  // Flash message (mis. hasil kirim gangguan) tampil sebagai overlay
  if (P.notif && P.notif.text) {
    setTimeout(function(){ window.showToast(P.notif.text, P.notif.type === 'danger' || P.notif.type === 'warning'); }, 700);
  }

  // ── Tombol gangguan: buka modal detail ──
  window.openGangguan = function(){
    var n = P.notice || {};
    var t = document.getElementById('gangguan-title');
    var m = document.getElementById('gangguan-msg');
    var e = document.getElementById('gangguan-eta');
    var _act = n.active !== false;
    if (t) t.textContent = _act ? (n.label || 'Info Jaringan') : '<%= t('pwa.js.net_ok','Jaringan Normal') %>';
    if (m) m.textContent = _act ? (n.text || '<%= t('pwa.js.net_issue','Sedang terjadi gangguan pada jaringan.') %>') : '<%= t('pwa.js.net_fine','Tidak ada gangguan pada jaringan saat ini. Layanan berjalan normal.') %>';
    if (e) e.textContent = (_act && n.estimateText) ? ('<%= t('pwa.js.estimate','Estimasi selesai:') %>' + n.estimateText) : '';
    document.getElementById('gangguan-modal').classList.add('open');
  };
  window.closeGangguan = function(){ document.getElementById('gangguan-modal').classList.remove('open'); };
  window.goToNetworkStatus = function(){
    if (netState === 'normal') { switchTab('network'); return; }
    window.openGangguan();
  };

  // ── ONU tidak terdeteksi: popup saat halaman dibuka ──
  window.openOnuModal = function(){
    var ov = document.getElementById('busy');
    if (ov && ov.classList.contains('show')) { setTimeout(window.openOnuModal, 1200); return; }
    if (document.querySelector('.modal-backdrop.open')) return; // hindari tumpuk modal
    var m = document.getElementById('onu-modal'); if (m) m.classList.add('open');
  };
  window.closeOnuModal = function(){ var m=document.getElementById('onu-modal'); if (m) m.classList.remove('open'); };
  // FIX (2026-10-09): JANGAN auto-buka modal ONU saat load — overlay modal menelan klik
  // (bug: tombol tab Akun di sidebar desktop tidak bisa diklik utk pelanggan tanpa ONU).
  // Cukup tampilkan toast non-blocking.
  if (P.onuDetected === false) {
    setTimeout(function () {
      try { if (typeof window.showToast === 'function') window.showToast('<%= t('pwa.js.onu_missing_wifi2','ONU tidak terdeteksi — pengaturan WiFi tidak tersedia.') %>', true); } catch (e) {}
    }, 900);
  }
  // ── Persist tab: reload tidak balik ke Beranda, tombol back antar-tab ──
  var _origSwitch = window.switchTab;
  function _setHash(id){ try { history.replaceState(history.state, '', '#' + id); } catch(e) { try { location.hash = id; } catch(_){} } }
  function _pushGuard(){ try { history.pushState({ sfGuard: 1 }, '', location.hash || '#home'); } catch(e) {} }
  window.switchTab = function(id, fromState){
    _origSwitch(id);
    if (!fromState) _setHash(id);
  };
  function _closeAnyModal(){
    var m = document.querySelector('.modal-backdrop.open');
    if (m) { m.classList.remove('open'); return true; }
    return false;
  }
  function _hashTab(){ var h = (location.hash || '').replace('#',''); return tabs.indexOf(h) !== -1 ? h : 'home'; }
  // Tombol back HARDWARE: 1x = kembali (tutup modal / ke Beranda),
  // dan TIDAK PERNAH keluar ke halaman login — selalu ditahan di dalam aplikasi.
  window.addEventListener('popstate', function(){
    if (_closeAnyModal()) { _pushGuard(); return; }
    if (activeTab !== 'home') { _origSwitch('home'); _setHash('home'); _pushGuard(); return; }
    _pushGuard(); // di Beranda: tahan (jangan sampai logout karena back)
  });
  window.addEventListener('DOMContentLoaded', function(){
    var t = _hashTab(); if (t && t !== 'home') _origSwitch(t);
    _pushGuard();
  });

  // Pull-to-refresh dengan animasi (spinner mengikuti tarikan)
  (function(){
    var sa = document.getElementById('scroll-area'); if (!sa) return;
    var startY = null, active = false, TH = 70;
    var ind = document.createElement('div');
    ind.style.cssText = 'position:fixed;left:50%;top:10px;transform:translate(-50%,-14px);z-index:250;pointer-events:none;opacity:0;transition:opacity .18s,transform .18s;display:flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:50%;background:var(--surface-2);border:1px solid var(--border);box-shadow:0 10px 24px -10px rgba(0,0,0,.65)';
    ind.innerHTML = '<i class="ph-bold ph-arrow-clockwise" style="color:var(--lime);font-size:20px;display:block"></i>';
    document.body.appendChild(ind);
    var ico = ind.firstChild;
    function pull(d){
      var p = Math.min(1, d / TH);
      ind.style.opacity = String(0.25 + p * 0.75);
      ind.style.transform = 'translate(-50%,' + (-14 + p * 20) + 'px)';
      ico.style.transform = 'rotate(' + Math.round(d * 3.2) + 'deg)';
    }
    document.addEventListener('touchstart', function(e){
      if (e.touches.length === 1 && sa.scrollTop <= 0) { startY = e.touches[0].clientY; active = true; }
      else { active = false; startY = null; }
    }, { passive: true });
    document.addEventListener('touchmove', function(e){
      if (!active || startY == null) return;
      var d = e.touches[0].clientY - startY;
      if (d > 6) { if (e.cancelable) { try { e.preventDefault(); } catch(_) {} } pull(d); }
    }, { passive: false });
    function end(e){
      if (!active) return;
      var d = (e.changedTouches && e.changedTouches[0]) ? (e.changedTouches[0].clientY - startY) : 0;
      active = false; startY = null;
      if (d > TH) {
        ind.style.opacity = '1';
        ind.style.transform = 'translate(-50%,6px)';
        ico.classList.add('ptr-spin');
        if (navigator.vibrate) { try { navigator.vibrate(15); } catch(_){} }
        setTimeout(function(){ location.reload(); }, 400);
      } else {
        ind.style.opacity = '0';
        ind.style.transform = 'translate(-50%,-14px)';
      }
    }
    document.addEventListener('touchend', end, { passive: true });
    document.addEventListener('touchcancel', end, { passive: true });
  })();

  // ── Monitor lalu lintas real-time (rx/tx) ──
  function _fmtMbps(v){ v = Number(v) || 0; return v >= 100 ? v.toFixed(0) : v.toFixed(1); }
  function pollTraffic(){
    fetch('/customer/api/pppoe-traffic', { cache:'no-store', credentials:'same-origin' })
      .then(function(r){ return r.json(); })
      .then(function(d){
        if (!d || d.ok === false) return;
        var online = d.online !== false;
        var rx = online ? (Number(d.rxMbps) || 0) : 0;
        var tx = online ? (Number(d.txMbps) || 0) : 0;
        var rxEl = document.getElementById('live-rx'), txEl = document.getElementById('live-tx');
        if (rxEl) rxEl.textContent = _fmtMbps(rx);
        if (txEl) txEl.textContent = _fmtMbps(tx);
        var maxD = (P.speedDown && P.speedDown !== '-') ? Number(P.speedDown) : 100;
        var maxU = (P.speedUp && P.speedUp !== '-') ? Number(P.speedUp) : 100;
        var rb = document.getElementById('live-rx-bar'); if (rb) rb.style.width = Math.max(2, Math.min(100, (rx / (maxD || 100)) * 100)) + '%';
        var tb = document.getElementById('live-tx-bar'); if (tb) tb.style.width = Math.max(2, Math.min(100, (tx / (maxU || 100)) * 100)) + '%';
        if (d.uptime) { var u = document.getElementById('live-uptime'); if (u) u.textContent = d.uptime; }
        var dot = document.getElementById('live-dot'); if (dot) dot.style.background = online ? 'var(--lime)' : '#EF4444';
      }).catch(function(){});
  }
  if (document.getElementById('live-rx')) { pollTraffic(); setInterval(pollTraffic, 5000); }

  // ── Kirim invoice ke WA ──
  window.sendInvoiceWa = function(id){
    showToast('<%= t('pwa.js.sending_wa','Mengirim tagihan ke WhatsApp...') %>');
    fetch('/customer/invoice/' + id + '/send-pdf-wa', { method:'POST', headers:{ 'Content-Type':'application/json','X-Requested-With':'fetch','Accept':'application/json' }, credentials:'same-origin' })
      .then(function(r){ return r.json().catch(function(){ return { success:r.ok }; }); })
      .then(function(res){ var ok = !(res && res.success === false); showToast((res && res.message) || (ok ? '<%= t('pwa.js.sent_wa','Tagihan terkirim ke WhatsApp') %>' : '<%= t('pwa.js.send_failed','Gagal mengirim') %>'), !ok); })
      .catch(function(){ showToast('<%= t('pwa.js.send_failed_wa','Gagal mengirim ke WhatsApp') %>', true); });
  };
})();
</script>

<script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', function(){ navigator.serviceWorker.register('/sw.js', { scope: '/customer/' }).then(function(r){ try{r.update();}catch(e){} }).catch(function(){}); });
  }
</script>

<script>
  /* ═══ PWA: registrasi Service Worker + deteksi versi baru (version.txt) ═══ */
  (function () {
    function showUpdateBar() {
      if (document.getElementById('pwa-update-bar')) return;
      var bar = document.createElement('div');
      bar.id = 'pwa-update-bar';
      bar.style.cssText = 'position:fixed;left:50%;bottom:88px;transform:translateX(-50%);z-index:300;display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:14px;background:var(--surface-2);border:1px solid var(--lime-border);box-shadow:0 12px 32px -12px rgba(0,0,0,.7);font-size:12px;color:var(--text);white-space:nowrap';
      bar.innerHTML = '<i class="bi bi-arrow-repeat" style="color:var(--lime)"></i> <span><%= t('pwa.update.available','Versi baru tersedia') %></span> <button type="button" class="press" style="padding:6px 10px;border-radius:9px;background:var(--lime);color:#0A0D14;font-weight:700;border:0"><%= t('common.reload','Muat Ulang') %></button>';
      bar.querySelector('button').onclick = function () { try { sessionStorage.removeItem('pwa_seen_ver'); } catch (e) {} location.reload(); };
      document.body.appendChild(bar);
    }
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js', { scope: '/customer/' }).then(function (reg) {
        try { reg.update(); } catch (e) {}
        var check = function () {
          fetch('/version.txt?ts=' + Date.now(), { cache: 'no-store' })
            .then(function (r) { return r.text(); })
            .then(function (txt) {
              var v = String(txt || '').trim();
              if (!v) return;
              var seen = null; try { seen = sessionStorage.getItem('pwa_seen_ver'); } catch (e) {}
              if (seen && seen !== v) showUpdateBar();
              try { sessionStorage.setItem('pwa_seen_ver', v); } catch (e) {}
            }).catch(function () {});
        };
        setInterval(check, 30 * 60 * 1000);
        document.addEventListener('visibilitychange', function () { if (!document.hidden) check(); });
      }).catch(function () {});
    }
  })();
</script>
</body>
</html>