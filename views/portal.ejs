  </main>

  <!-- ═══════════════ MODAL: Setting WiFi ═══════════════ -->
  <div class="modal-backdrop" id="setting-modal" onclick="if(event.target===this)closeSettingModal()">
    <div class="modal-sheet" role="dialog" aria-modal="true" aria-labelledby="setting-title">
      <div class="modal-grip"></div>
      <h3 class="modal-title" id="setting-title"><%= t('pwa.wifi.title','Pengaturan WiFi') %></h3>
      <p class="modal-sub"><%= t('pwa.wifi.subtitle','Ubah SSID dan password jaringan WiFi Anda') %></p>

      <div class="field">
        <label class="field-label" for="ssid-input"><%= t('pwa.net.ssid','Nama WiFi (SSID)') %></label>
        <div class="field-input-wrap">
          <i class="ph-fill ph-wifi-high" style="color:var(--lime);font-size:16px;"></i>
          <input class="field-input" type="text" id="ssid-input" value="OPEN-ISP-AD" placeholder="<%= t('pwa.wifi.name_ph','Nama WiFi') %>" maxlength="32" autocomplete="off">
        </div>
      </div>

      <div class="field">
        <label class="field-label" for="pwd-input"><%= t('pwa.net.f_password','Password') %></label>
        <div class="field-input-wrap">
          <i class="ph-fill ph-lock-key" style="color:var(--lime);font-size:16px;"></i>
          <input class="field-input" type="password" id="pwd-input" value="" placeholder="<%= t('pwa.wifi.pwd_ph','Password baru (min. 8 karakter)') %>" minlength="8" maxlength="63" autocomplete="new-password">
        </div>
        <p class="field-hint"><%= t('pwa.wifi.password_hint','Minimal 8 karakter. Gunakan kombinasi huruf, angka, dan simbol.') %></p>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn-cancel" onclick="closeSettingModal()"><%= t('common.cancel','Batal') %></button>
        <button type="button" class="btn-save" onclick="saveWifiSetting()"><%= t('common.save','Simpan') %></button>
      </div>
    </div>
  </div>

  <!-- ═══════════════ MODAL: Informasi Pribadi ═══════════════ -->
  <div class="modal-backdrop" id="info-modal" onclick="if(event.target===this)closeInfoPribadi()">
