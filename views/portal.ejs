                </div>
                <p id="modem-status" class="text-sm font-black" style="font-family:'Space Grotesk',sans-serif;color:<%= portal.onuOnline ? 'var(--lime)' : (portal.onuDetected ? '#FBBF24' : '#EF4444') %>;"><%= portal.onuOnline ? 'Normal' : (portal.onuDetected ? 'Offline' : t('pwa.js.st_na','Tidak terdeteksi')) %></p>
                <p id="modem-sub" class="text-[10px] mt-1" style="color:var(--muted);"><%= portal.onuOnline ? t('pwa.js.st_connected','ONU / Modem terkoneksi') : (portal.onuDetected ? t('pwa.js.st_detected_no_conn','ONU terdeteksi, koneksi terputus') : t('pwa.js.st_not_detected','ONU / Modem tidak terdeteksi')) %></p>
