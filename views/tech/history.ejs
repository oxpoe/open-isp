<%- include('partials/header') %>

<div style="margin-bottom:18px">
  <h5 style="margin:0;font-weight:700"><%= t('tech.history_page.title', 'Riwayat Tugas') %></h5>
  <div class="muted" style="font-size:12px"><%= t('tech.history_page.subtitle', '50 tugas terakhir yang sudah diselesaikan') %></div>
</div>

<% if (tickets.length === 0) { %>
  <div class="p-empty"><i class="bi bi-clock-history"></i><p style="font-size:13px"><%= t('tech.history_page.empty', 'Belum ada riwayat tugas yang diselesaikan.') %></p></div>
<% } else { %>
  <% tickets.forEach(function(ticket){ %>
    <div class="p-card" style="border-color:var(--success-glow)">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:10px;margin-bottom:8px">
        <span class="badge-status badge-resolved"><i class="bi bi-check-circle-fill"></i> <%= t('tech.ticket.resolved', 'Selesai') %></span>
        <span class="muted" style="font-size:11px"><%= new Date(ticket.updated_at).toLocaleString('id-ID', {day:'2-digit', month:'short', year:'numeric'}) %></span>
      </div>
      <div style="font-weight:700;font-size:14px"><%= ticket.customer_name %></div>
      <div class="muted" style="font-size:12px;margin-top:4px"><i class="bi bi-tools"></i> <%= ticket.subject %></div>
    </div>
  <% }); %>
<% } %>

<%- include('partials/bottom_nav') %>
