<!DOCTYPE html>
<html lang="<%= lang || 'id' %>" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= t('customer.dashboard_title', 'Dashboard Pelanggan') %> | <%= settings.company_header || 'OPEN-ISP' %></title>
  <meta name="theme-color" content="#0A0D14">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/landing.css?v=4">
  <link rel="stylesheet" href="/css/auth.css?v=4">
  <link rel="stylesheet" href="/css/dashboard.css?v=3">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/img/icons/icon-192.png">
  <link rel="apple-touch-icon" href="/img/icons/apple-touch-icon.png">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <script>document.documentElement.classList.add('js');</script>
  <link rel="stylesheet" href="/css/theme-toggle.css">
</head>
<body>

<!-- ═══ APP BAR ═══ -->
<header class="app-bar">
  <div class="container inner">
    <a class="app-brand" href="/customer/dashboard">
      <img src="/img/icons/icon-192.png" alt="<%= brandName %>"> <%= t('customer.dashboard.portal', 'Portal Pelanggan') %>
    </a>
    <div class="app-actions">

      <div class="notif-bell-btn" onclick="openNotifDrawer()" title="Notifikasi">
        <i class="bi bi-bell-fill"></i>
        <span class="notif-badge-count" id="notifCountBadge" style="display:none">0</span>
      </div>
      <% if (pppoeOnline === true) { %>
        <span class="status-pill online"><span class="pulse-dot green"></span> PPPoE Online</span>
      <% } else if (pppoeOnline === false) { %>
        <span class="status-pill offline"><span class="pulse-dot red"></span> PPPoE Offline</span>
      <% } else { %>
        <span class="status-pill offline">PPPoE —</span>
      <% } %>
      <form method="POST" action="/customer/reconnect" style="margin:0">
        <button type="submit" class="chip-btn ok" title="Reconnect internet"><i class="bi bi-arrow-repeat"></i> Re-Connect</button>
      </form>
      <form method="POST" action="/customer/logout" style="margin:0">
        <button type="submit" class="chip-btn danger" title="Keluar"><i class="bi bi-box-arrow-right"></i></button>
      </form>
    </div>
  </div>
</header>

<main class="container dash-wrap">

  <!-- NOTIF -->
  <% if (typeof notif !== 'undefined' && notif && notif.text) { %>
    <div class="auth-alert <%= notif.type === 'danger' ? 'err' : notif.type === 'warning' ? 'warn' : notif.type === 'info' ? 'info' : 'ok' %>" id="notif-alert">
      <i class="bi bi-info-circle"></i> <%= notif.text %>
    </div>
    <script>setTimeout(function(){var a=document.getElementById('notif-alert');if(a)a.style.display='none';},4000);</script>
  <% } %>

  <!-- PROMO ROTATOR -->
  <div class="promo-rot" id="promoRot">
    <div class="welcome"><i class="bi bi-wifi"></i><span>Selamat Datang di Portal Pelanggan</span></div>
  </div>
  <script>
    fetch('/customer/api/promo-slides')
      .then(function(r){return r.json();})
      .then(function(slides){
        if (!slides || !slides.length) return;
        var box = document.getElementById('promoRot');
        box.innerHTML = slides.map(function(s,i){
          var img = '<img src="'+s.image_path+'" alt="'+(s.title||'Promo')+'" loading="lazy">';
          var inner = s.url ? '<a href="'+s.url+'"'+(s.open_in_new_tab?' target="_blank" rel="noopener"':'')+'>'+img+'</a>' : img;
          return '<div class="promo-slide" style="display:'+(i===0?'block':'none')+'">'+inner+'</div>';
        }).join('') + '<div class="dots">'+slides.map(function(_,i){return '<span class="'+(i===0?'on':'')+'"></span>';}).join('')+'</div>';
        var idx=0, items=box.querySelectorAll('.promo-slide'), dots=box.querySelectorAll('.dots span');
        if(items.length>1){
          setInterval(function(){
            items[idx].style.display='none'; dots[idx].classList.remove('on');
            idx=(idx+1)%items.length;
            items[idx].style.display='block'; dots[idx].classList.add('on');
          },5000);
        }
      }).catch(function(){});
  </script>

  <!-- ═══ SERVICE NOTICE ═══ -->
  <%- include('partials/service-notice') %>

  <!-- HERO -->
  <section class="hero-banner" id="home-section">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:14px;flex-wrap:wrap">
      <div>
        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:6px">
          <span class="id-badge"><i class="bi bi-person-badge"></i> ID: <b id="custIdText" class="mono"><%= profile ? (profile.customer_code || profile.genieacs_tag || profile.pppoe_username || profile.phone) : customer.phone %></b><button class="copy-mini" type="button" onclick="copyId()" title="Salin ID pelanggan"><i class="bi bi-clipboard"></i></button></span>
          <% if (onuMissing) { %>
            <button type="button" class="onu-chip" onclick="showModal('onuMissingModal')"><i class="bi bi-exclamation-triangle-fill"></i> ONU belum terdeteksi</button>
          <% } %>
          <% if (profile) { %>
            <span class="status-pill <%= profile.status === 'active' ? 'online' : 'suspended' %>">
              <span class="pulse-dot <%= profile.status === 'active' ? 'green' : 'red' %>"></span>
              Layanan: <%= profile.status === 'active' ? 'AKTIF' : 'ISOLIR' %>
            </span>
          <% } %>
        </div>
        <h3><%= t('customer.dashboard.hello', 'Halo') %>, <%= profile ? profile.name : customer.phone %></h3>
        <p class="muted" style="font-size:13px;margin-top:6px;display:flex;gap:14px;flex-wrap:wrap">
          <span><i class="bi bi-reception-4" style="color:var(--success)"></i> Sinyal Optik: <strong style="color:var(--text)"><%= customer.rxPower || '-20 dBm' %></strong></span>
          <span><i class="bi bi-hdd-network" style="color:var(--info)"></i> <span class="mono"><%= (profile && profile.pppoe_username) || customer.pppoeUsername || 'Belum ada akun PPPoE' %></span></span>
        </p>
        <% if (!((profile && profile.pppoe_username) || customer.pppoeUsername)) { %>
          <div style="margin-top:10px;padding:10px 12px;border-radius:12px;background:rgba(251,191,36,.12);border:1px solid rgba(251,191,36,.35);color:var(--warning,#fbbf24);font-size:12.5px;display:flex;gap:8px;align-items:center">
            <i class="bi bi-hourglass-split"></i> Akun PPPoE Anda belum dibuat — menunggu pemasangan/aktivasi oleh teknisi.
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <!-- BILL HERO -->
  <%
    const paidInvoices = (invoices || []).filter(function(i){return i.status === 'paid';});
    const unpaidInvoices = (invoices || []).filter(function(i){return i.status !== 'paid';});
    const hasUnpaid = unpaidInvoices.length > 0;
    const latestUnpaid = hasUnpaid ? unpaidInvoices[0] : null;
    const totalUnpaidAmount = latestUnpaid ? Number(latestUnpaid.amount != null ? latestUnpaid.amount : (latestUnpaid.package_price != null ? latestUnpaid.package_price : 0)) : 0;
    const unpaidPeriods = latestUnpaid ? (latestUnpaid.period_month + '/' + latestUnpaid.period_year) : '';
    const unpaidCount = unpaidInvoices.length;
    const isolateDay = (typeof profile !== 'undefined' && profile && profile.isolate_day) ? Number(profile.isolate_day) : ((typeof settings !== 'undefined' && settings && settings.isolir_day) ? Number(settings.isolir_day) : 10);
    const bulanNames = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
    const fmtDue = function(m, y){ return isolateDay + ' ' + (bulanNames[Number(m) - 1] || '') + ' ' + y; };
    let dueText = '';
    let dueDiffDays = null;
    if (latestUnpaid) {
      dueText = fmtDue(latestUnpaid.period_month, latestUnpaid.period_year);
      const d0 = new Date(Number(latestUnpaid.period_year), Number(latestUnpaid.period_month) - 1, isolateDay);
      d0.setHours(0, 0, 0, 0);
      const t0 = new Date(); t0.setHours(0, 0, 0, 0);
      dueDiffDays = Math.round((d0.getTime() - t0.getTime()) / 86400000);
    }
    const nowD = new Date();
    const nextD = new Date(nowD.getFullYear(), nowD.getMonth() + 1, 1);
    const nextDueText = fmtDue(nextD.getMonth() + 1, nextD.getFullYear());
  %>
  <section class="bill-hero-card <%= hasUnpaid ? 'unpaid' : 'paid' %>">
    <div style="display:flex;align-items:center;gap:14px">
      <div class="bico"><i class="bi bi-<%= hasUnpaid ? 'exclamation-triangle-fill' : 'shield-check' %>"></i></div>
      <div>
        <% if (hasUnpaid) { %>
          <span class="badge bw" style="font-size:10px"><i class="bi bi-exclamation-circle"></i> TAGIHAN BELUM DIBAYAR <%= unpaidCount > 1 ? '('+unpaidCount+' BULAN)' : '' %></span>
          <h5 style="margin-top:6px;color:var(--warning)">Rp <%= parseInt(totalUnpaidAmount || 0).toLocaleString('id-ID') %></h5>
          <div class="muted" style="font-size:12.5px;margin-top:2px">Periode <%= unpaidPeriods %></div>
          <div style="font-size:13px;margin-top:6px;display:flex;align-items:center;gap:7px;flex-wrap:wrap">
            <i class="bi bi-calendar-event" style="color:var(--warning)"></i>
            <span>Jatuh tempo: <strong style="color:var(--text)"><%= dueText %></strong></span>
            <% if (dueDiffDays !== null) { %>
              <span class="badge <%= dueDiffDays < 0 ? 'bd' : (dueDiffDays <= 2 ? 'bw' : 'bm') %>" style="font-size:10px">
                <%= dueDiffDays > 0 ? ('Sisa ' + dueDiffDays + ' hari') : (dueDiffDays === 0 ? 'Hari ini!' : ('Lewat ' + Math.abs(dueDiffDays) + ' hari')) %>
              </span>
            <% } %>
          </div>
        <% } else { %>
          <span class="badge bs" style="font-size:10px"><i class="bi bi-check-circle"></i> SEMUA TAGIHAN LUNAS</span>
          <h5 style="margin-top:6px">Layanan Internet Aktif</h5>
          <div class="muted" style="font-size:12.5px;margin-top:2px">Terima kasih telah membayar tepat waktu!</div>
          <div style="font-size:13px;margin-top:6px;display:flex;align-items:center;gap:7px">
            <i class="bi bi-calendar-event" style="color:var(--success)"></i>
            <span>Jatuh tempo berikutnya: <strong style="color:var(--text)"><%= nextDueText %></strong></span>
          </div>
        <% } %>
      </div>
    </div>
    <% if (hasUnpaid) { %>
      <button type="button" class="lbtn lbtn-primary lbtn-lg" onclick="openPaymentModal('<%= latestUnpaid.id %>', '<%= totalUnpaidAmount %>')"><i class="bi bi-wallet2"></i> Bayar Sekarang</button>
    <% } %>
  </section>

  <!-- INFO LAYANAN -->
  <section class="svc-grid">
    <div class="svc-card">
      <div class="svc-ic"><i class="bi bi-box-seam"></i></div>
      <div class="svc-tx"><span>Paket Berjalan</span>
        <b><%= profile && profile.package_name ? profile.package_name : 'Belum ada paket' %></b>
        <small><% if (profile && Number(profile.speed_down) > 0) { %><%= Math.round(Number(profile.speed_down)/1000) %> Mbps<%= profile.speed_up ? ' / ' + Math.round(Number(profile.speed_up)/1000) + ' Mbps' : '' %><% } else { %>—<% } %></small>
      </div>
    </div>
    <div class="svc-card">
      <div class="svc-ic"><i class="bi bi-person-check"></i></div>
      <div class="svc-tx"><span>Status Akun</span>
        <% if (profile && profile.status === 'active') { %><b class="ok">Aktif</b><% } else { %><b class="warn">Isolir</b><% } %>
        <small><%= profile ? profile.name : '—' %></small>
      </div>
    </div>
    <div class="svc-card">
      <div class="svc-ic"><i class="bi bi-hdd-network"></i></div>
      <div class="svc-tx"><span>Internet (PPPoE)</span>
        <% if (pppoeOnline === true) { %><b class="ok">Online</b><% } else if (pppoeOnline === false) { %><b class="off">Offline</b><% } else { %><b>Tidak diketahui</b><% } %>
        <small class="mono"><%= (profile ? profile.pppoe_username : '') || customer.pppoeUsername || 'Belum dibuat' %></small>
      </div>
    </div>
    <div class="svc-card">
      <div class="svc-ic"><i class="bi bi-router"></i></div>
      <div class="svc-tx"><span>Perangkat (ONU)</span>
        <% if (onuMissing) { %><b class="warn">Tidak ditemukan</b><% } else { %><b class="ok">Terhubung</b><% } %>
        <small><%= customer.rxPower || '-' %> • <%= customer.model || 'ONU' %></small>
      </div>
    </div>
  </section>

  <!-- QUICK ACTIONS -->
  <div class="action-grid">
    <% const navPayAmt = hasUnpaid ? totalUnpaidAmount : 0; %>
    <div class="action-item" onclick="<%= hasUnpaid ? "openPaymentModal('"+latestUnpaid.id+"','"+navPayAmt+"')" : "location.href='#billing-section'" %>">
      <div class="action-icon ai-pay"><i class="bi bi-credit-card-2-front-fill"></i></div><div class="action-label">Bayar Tagihan</div>
    </div>
    <div class="action-item" data-ssid-change onclick="editSsid('<%= (customer.tags && customer.tags[0]) || customer.id %>', '<%= customer.ssid %>')">
      <div class="action-icon ai-ssid"><i class="bi bi-wifi"></i></div><div class="action-label">Nama WiFi</div>
    </div>
    <div class="action-item" onclick="editPassword('<%= (customer.tags && customer.tags[0]) || customer.id %>')">
      <div class="action-icon ai-pass"><i class="bi bi-key-fill"></i></div><div class="action-label">Sandi WiFi</div>
    </div>
    <div class="action-item" onclick="rebootDevice('<%= (customer.tags && customer.tags[0]) || customer.id %>')">
      <div class="action-icon ai-reboot"><i class="bi bi-arrow-clockwise"></i></div><div class="action-label">Restart Modem</div>
    </div>
    <div class="action-item" onclick="openNotifDrawer()"><div class="action-icon ai-ppob"><i class="bi bi-bell-fill"></i></div><div class="action-label">Notifikasi</div></div>
    <div class="action-item" onclick="showModal('ticketModal')"><div class="action-icon ai-ticket"><i class="bi bi-headset"></i></div><div class="action-label">Bantuan / Tiket</div></div>
  </div>

  <!-- DEVICE + TRAFFIC -->
  <div class="dash-grid" style="margin-bottom:18px">
    <!-- Router card -->
    <div class="glass-card">
      <div class="glass-header">
        <h5><i class="bi bi-router" style="color:var(--primary)"></i> Kontrol Perangkat Router</h5>
        <span class="badge-soft"><%= customer.model !== '-' ? customer.model : 'ONT / ONU' %></span>
      </div>
      <div class="glass-body">
        <div id="deviceSyncPanel" data-sync-in-progress="<%= customer.syncInProgress ? 'true' : 'false' %>" style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:12px;flex-wrap:wrap">
          <span class="muted" id="deviceSyncNotice" style="font-size:11px"></span>
          <button type="button" id="btnDeviceRefresh" class="lbtn lbtn-ghost lbtn-sm"><i class="bi bi-arrow-repeat"></i> Poll ONU</button>
        </div>
        <div class="stats-grid" style="margin-bottom:14px">
          <div class="stat-card"><div class="stat-icon <%= customer.status === 'Online' ? 'online' : 'offline' %>"><i class="bi bi-power"></i></div><div class="stat-label">Status Router</div><div class="stat-value"><%= customer.status %></div></div>
          <div class="stat-card"><div class="stat-icon activity"><i class="bi bi-reception-4"></i></div><div class="stat-label">Rx Optical</div><div class="stat-value"><%= customer.rxPower %></div></div>
          <div class="stat-card"><div class="stat-icon people"><i class="bi bi-laptop"></i></div><div class="stat-label">User Terhubung</div><div class="stat-value"><%= customer.totalAssociations || 0 %> User</div></div>
        </div>

        <div class="wifi-box" style="margin-bottom:14px">
          <div class="wifi-row"><span class="wifi-label" style="color:var(--info)"><i class="bi bi-wifi"></i> Nama SSID WiFi</span>
            <button class="link-btn" data-ssid-change onclick="editSsid('<%= (customer.tags && customer.tags[0]) || customer.id %>', '<%= customer.ssid %>')">Ubah <i class="bi bi-pencil"></i></button></div>
          <div class="wifi-val" style="margin-bottom:12px"><%= customer.ssid || '-' %></div>
          <div class="wifi-row"><span class="wifi-label" style="color:var(--success)"><i class="bi bi-shield-lock"></i> Password WiFi</span>
            <button class="link-btn" onclick="editPassword('<%= (customer.tags && customer.tags[0]) || customer.id %>')">Ubah <i class="bi bi-pencil"></i></button></div>
          <div style="display:flex;gap:8px">
            <input type="password" id="wifiPassInput" class="inp inp-plain" value="••••••••" readonly style="padding-left:14px">
            <button class="chip-btn" type="button" onclick="togglePassVisibility()"><i class="bi bi-eye" id="eyeIcon"></i></button>
          </div>
        </div>

        <div class="muted" style="font-size:12px;font-weight:700;margin-bottom:8px"><i class="bi bi-people"></i> Perangkat Terhubung saat ini:</div>
        <% if (connectedUsers && connectedUsers.length > 0) { %>
          <div class="dev-list">
            <% connectedUsers.forEach(function(u){ %>
              <div class="dev-item">
                <div style="display:flex;align-items:center;gap:9px">
                  <i class="bi bi-laptop" style="color:var(--primary)"></i>
                  <div>
                    <div style="font-weight:700"><%= u.hostname || 'Device' %></div>
                    <div class="mono muted" style="font-size:10px"><%= u.ip || '-' %> | <%= u.mac || '-' %></div>
                  </div>
                </div>
                <span class="badge bs" style="font-size:9px">Active</span>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="dev-empty">Tidak ada perangkat aktif terdeteksi</div>
        <% } %>
      </div>
    </div>

    <!-- Traffic card -->
    <div class="glass-card">
      <div class="glass-header">
        <h5><i class="bi bi-speedometer2" style="color:var(--info)"></i> Pemantauan Trafik Real-Time</h5>
        <span class="badge-soft">Live Mbps</span>
      </div>
      <div class="glass-body">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;text-align:center">
          <div>
            <div class="stat-label" style="margin-bottom:6px">Trafik Download</div>
            <div class="traffic-gauge">
              <canvas id="pppoe_rx_gauge" width="220" height="140" data-max="<%= typeof trafficMaxDownMbps !== 'undefined' ? trafficMaxDownMbps : 10 %>"></canvas>
              <div class="traffic-gauge-center"><div class="traffic-gauge-value" id="pppoe_rx_value">-</div><div class="traffic-gauge-unit" id="pppoe_rx_unit">&nbsp;</div></div>
              <div class="traffic-gauge-scale"><span>0</span><span id="pppoe_rx_max"><%= typeof trafficMaxDownMbps !== 'undefined' ? trafficMaxDownMbps : 10 %> Mbps</span></div>
            </div>
          </div>
          <div>
            <div class="stat-label" style="margin-bottom:6px">Trafik Upload</div>
            <div class="traffic-gauge">
              <canvas id="pppoe_tx_gauge" width="220" height="140" data-max="<%= typeof trafficMaxUpMbps !== 'undefined' ? trafficMaxUpMbps : 10 %>"></canvas>
              <div class="traffic-gauge-center"><div class="traffic-gauge-value" id="pppoe_tx_value">-</div><div class="traffic-gauge-unit" id="pppoe_tx_unit">&nbsp;</div></div>
              <div class="traffic-gauge-scale"><span>0</span><span id="pppoe_tx_max"><%= typeof trafficMaxUpMbps !== 'undefined' ? trafficMaxUpMbps : 10 %> Mbps</span></div>
            </div>
          </div>
        </div>
        <div class="auth-alert info" style="margin-top:16px;justify-content:center"><i class="bi bi-info-circle"></i> Kecepatan disesuaikan dengan paket berlangganan Anda.</div>
      </div>
    </div>
  </div>

  <!-- TAGIHAN -->
  <details class="acc" id="billing-section" open>
    <summary><span><i class="bi bi-receipt" style="color:var(--warning)"></i> Status Tagihan &amp; Riwayat Pembayaran</span><i class="bi bi-chevron-down chev"></i></summary>
    <div class="acc-body">
      <% if (invoices && invoices.length > 0) { %>
        <% invoices.forEach(function(inv){ %>
          <% const itemAmt = inv.amount != null ? inv.amount : (inv.package_price != null ? inv.package_price : 0); %>
          <div class="inv-card">
            <div class="inv-top">
              <% if (inv.status === 'paid') { %><span class="badge bs" style="font-size:10px">LUNAS</span><% } else { %><span class="badge bd" style="font-size:10px">BELUM BAYAR</span><% } %>
              <span class="muted" style="font-size:12px"><i class="bi bi-calendar-event"></i> Periode <%= inv.period_month %>/<%= inv.period_year %></span>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:10px;flex-wrap:wrap">
              <div><div class="inv-name"><%= inv.package_name || 'Paket Internet' %></div><div class="inv-amt">Rp <%= parseInt(itemAmt || 0).toLocaleString('id-ID') %></div></div>
            </div>
            <div class="inv-actions">
              <% if (inv.status !== 'paid') { %>
                <button class="lbtn lbtn-primary lbtn-sm" onclick="openPaymentModal('<%= inv.id %>', '<%= itemAmt %>')"><i class="bi bi-wallet2"></i> Bayar</button>
                <a class="lbtn lbtn-ghost lbtn-sm" href="/customer/invoice/<%= inv.id %>/pdf" target="_blank" rel="noopener"><i class="bi bi-file-earmark-pdf-fill"></i> Tagihan PDF</a>
                <button class="lbtn lbtn-ghost lbtn-sm" onclick="sendInvoiceWa(<%= inv.id %>, this)"><i class="bi bi-whatsapp"></i> Kirim ke WA</button>
              <% } else { %>
                <a class="lbtn lbtn-ghost lbtn-sm" href="/customer/invoice/<%= inv.id %>/print-thermal" target="_blank" rel="noopener"><i class="bi bi-receipt"></i> Struk Thermal</a>
                <a class="lbtn lbtn-ghost lbtn-sm" href="/customer/invoice/<%= inv.id %>/print" target="_blank" rel="noopener"><i class="bi bi-printer-fill"></i> Faktur A4</a>
                <a class="lbtn lbtn-ghost lbtn-sm" href="/customer/invoice/<%= inv.id %>/pdf" target="_blank" rel="noopener"><i class="bi bi-file-earmark-pdf-fill"></i> PDF</a>
                <button class="lbtn lbtn-ghost lbtn-sm" onclick="sendInvoiceWa(<%= inv.id %>, this)"><i class="bi bi-whatsapp"></i> Kirim ke WA</button>
              <% } %>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="dev-empty">Belum ada riwayat tagihan</div>
      <% } %>
    </div>
  </details>

  <!-- TIKET -->
  <details class="acc" id="ticket-section">
    <summary><span><i class="bi bi-headset" style="color:#c084fc"></i> Tiket Keluhan &amp; Bantuan</span><i class="bi bi-chevron-down chev"></i></summary>
    <div class="acc-body">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:12px">
        <span style="font-weight:700">Daftar Tiket Anda</span>
        <button class="lbtn lbtn-primary lbtn-sm" onclick="showModal('ticketModal')"><i class="bi bi-plus-lg"></i> Buat Tiket</button>
      </div>
      <% if (tickets && tickets.length > 0) { %>
        <div class="srch-wrap">
          <table class="btbl">
            <thead><tr><th>ID</th><th>Jenis Kendala</th><th>Tanggal</th><th>Status</th></tr></thead>
            <tbody>
              <% tickets.forEach(function(t){ %>
                <tr>
                  <td class="mono" style="color:var(--info)">#TK-<%= t.id %></td>
                  <td><%= t.subject %></td>
                  <td class="muted"><%= t.created_at %></td>
                  <td><span class="badge <%= t.status === 'open' ? 'bw' : (t.status === 'in_progress' ? 'bi2' : 'bs') %>" style="font-size:10px"><%= t.status === 'open' ? 'TERKIRIM' : (t.status === 'in_progress' ? 'DIPROSES' : 'SELESAI') %></span></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="dev-empty">Belum ada tiket keluhan yang dibuat.</div>
      <% } %>
    </div>
  </details>

</main>

