  <i class="bi bi-circle-half"></i>
</button>

<div style="text-align:center;padding:6px 0 2px"><a href="/blackhole" style="opacity:.28;color:var(--muted);font-size:11px;text-decoration:none" title="Staff access">blackhole</a></div>

<%- include('partials/customer_bottom_nav', { activeNav: 'home' }) %>

<script>
  // Modal helpers (pengganti Bootstrap Modal)
  function showModal(id){ var el=document.getElementById(id); if(el) el.classList.add('show'); }
  function hideModal(id){ var el=document.getElementById(id); if(el) el.classList.remove('show'); }
  window.showModal = showModal; window.hideModal = hideModal;

  (function(){ var s = localStorage.getItem('landing-theme') || 'dark'; document.documentElement.setAttribute('data-theme', s); })();
  function toggleDashTheme(){ if(window.toggleTheme){ window.toggleTheme(); return; } var el=document.documentElement; var t=el.getAttribute('data-theme')==='dark'?'light':'dark'; el.setAttribute('data-theme',t); el.setAttribute('data-bs-theme',t==='light'?'light':'dark'); el.classList.toggle('light-theme',t==='light'); localStorage.setItem('landing-theme',t); }

  // Salin ID pelanggan
  function copyId(){
    var el = document.getElementById('custIdText'); if(!el) return;
    var val = el.textContent.trim();
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(val).then(function(){ toast('ID pelanggan disalin: ' + val, 'success'); }).catch(function(){ fallbackCopy(val); });
    } else { fallbackCopy(val); }
  }
  function fallbackCopy(text){
    var ta=document.createElement('textarea'); ta.value=text; ta.style.position='fixed'; ta.style.left='-9999px';
    document.body.appendChild(ta); ta.select();
    try{ document.execCommand('copy'); toast('ID pelanggan disalin', 'success'); }catch(e){ toast('Gagal menyalin', 'error'); }
    document.body.removeChild(ta);
  }

  // Toast notifikasi
  function toast(msg, type){
    var wrap=document.getElementById('toastWrap'); if(!wrap) return;
    var el=document.createElement('div'); el.className='toast '+(type||'info');
    var icon = type==='success'?'check-circle-fill':type==='error'?'x-circle-fill':'info-circle';
    el.innerHTML='<i class="bi bi-'+icon+'"></i><span></span>';
    el.querySelector('span').textContent=msg;
    wrap.appendChild(el);
    setTimeout(function(){ el.classList.add('out'); setTimeout(function(){ el.remove(); }, 300); }, 3400);
  }

  // Popup status ubah SSID / Password
  function wifiStatus(state, title, msg){
    var ic=document.getElementById('wifiStatusIc');
    ic.className='wifi-status-ic '+(state||'loading');
    ic.innerHTML = state==='success' ? '<i class="bi bi-check-circle-fill"></i>' : state==='error' ? '<i class="bi bi-x-circle-fill"></i>' : '<i class="bi bi-arrow-repeat spin"></i>';
    document.getElementById('wifiStatusTitle').textContent = title;
    document.getElementById('wifiStatusMsg').textContent = msg||'';
    document.getElementById('wifiStatusActions').style.display = state==='loading' ? 'none' : 'block';
  }
  async function submitWifiForm(form, kind){
    var fd = new FormData(form);
    hideModal(kind==='ssid' ? 'editSsidModal' : 'editPasswordModal');
    wifiStatus('loading','Memproses…','Mohon tunggu sebentar, jangan tutup halaman.');
    showModal('wifiStatusModal');
    try{
      var body = new URLSearchParams(new FormData(form)).toString();
      var r = await fetch(form.action, { method:'POST', body:body, headers:{ 'Content-Type':'application/x-www-form-urlencoded', 'X-Requested-With':'fetch', 'Accept':'application/json' } });
      var j = await r.json().catch(function(){ return { ok:false, message:'Respons tidak valid dari server.' }; });
      if (j && j.ok) {
        if (kind==='ssid') {
          var v=String(fd.get('ssid')||''); var val=document.querySelector('.wifi-val'); if(val) val.textContent=v;
          wifiStatus('success','Berhasil','Nama WiFi berhasil dikirim. Perubahan aktif dalam 1-5 menit. Mohon tunggu dan jangan ulangi agar tidak membebani server.');
          startSsidCooldown(300);
        } else {
          wifiStatus('success','Berhasil', j.message || 'Perubahan berhasil disimpan.');
        }
      } else if (j && j.cooldown) {
        wifiStatus('error','Tunggu dulu', j.message || 'Mohon tunggu sebelum mengubah lagi.');
        if (j.retryAfter) startSsidCooldown(j.retryAfter);
      } else {
        wifiStatus('error','Gagal', (j && j.message) || 'Terjadi kesalahan. Silakan coba lagi.');
      }
    }catch(e){ wifiStatus('error','Gagal','Tidak dapat menghubungi server. Periksa koneksi Anda.'); }
  }
  document.addEventListener('DOMContentLoaded', function(){
    var f1=document.querySelector('#editSsidModal form'); if(f1) f1.addEventListener('submit',function(e){e.preventDefault();submitWifiForm(f1,'ssid');});
    var f2=document.querySelector('#editPasswordModal form'); if(f2) f2.addEventListener('submit',function(e){e.preventDefault();submitWifiForm(f2,'password');});
    applySsidCooldown();
  });

  // Cooldown ubah SSID (5 menit) agar tidak spam ke ACS/MikroTik
  function startSsidCooldown(seconds){
    var until = Date.now() + (Number(seconds)||0) * 1000;
    try { localStorage.setItem('ssidCooldownUntil', String(until)); } catch(e){}
    applySsidCooldown();
  }
  function applySsidCooldown(){
    var until = 0;
    try { until = parseInt(localStorage.getItem('ssidCooldownUntil')||'0',10) || 0; } catch(e){}
    var remain = until - Date.now();
    var btns = document.querySelectorAll('[data-ssid-change]');
    if (remain <= 0) {
      btns.forEach(function(b){ b.disabled=false; b.style.pointerEvents=''; b.style.opacity=''; b.removeAttribute('title'); });
      return;
    }
    var mins = Math.ceil(remain/60000);
    btns.forEach(function(b){ b.style.pointerEvents='none'; b.style.opacity='.5'; b.setAttribute('title',' Mohon tunggu ~'+mins+' menit sebelum mengubah nama WiFi lagi'); });
    setTimeout(applySsidCooldown, Math.min(remain, 30000));
  }

  var currentInvId = null;

  function openPaymentModal(invId, amount) {
    currentInvId = invId;
    var num = 0;
    if (typeof amount === 'number') { num = isNaN(amount) ? 0 : amount; }
    else if (amount) { num = parseFloat(String(amount).replace(/[^0-9.]/g, '')) || 0; }
    document.getElementById('pay_amount_text').innerText = 'Rp ' + Math.round(num).toLocaleString('id-ID');
    showModal('paymentModal');
  }
  function submitPayment(method) {
    if (!currentInvId) return;
    window.location.href = '/customer/payment/create/' + currentInvId + '?method=' + method;
  }
  async function sendInvoiceWa(invId, btn) {
    if (!invId) return;
    const old = btn ? btn.innerHTML : '';
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Mengirim...'; }
    try {
      const r = await fetch('/customer/invoice/' + invId + '/send-pdf-wa', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
      const j = await r.json().catch(function(){ return {}; });
      alert(j.message || (j.ok ? 'Invoice dikirim ke WhatsApp Anda.' : 'Gagal mengirim invoice.'));
    } catch (e) {
      alert('Gagal mengirim invoice: ' + e.message);
    } finally {
      if (btn) { btn.disabled = false; btn.innerHTML = old; }
    }
  }
  function togglePassVisibility() {
    var input = document.getElementById('wifiPassInput'); var icon = document.getElementById('eyeIcon');
    if (input.type === 'password') { input.type = 'text'; icon.className = 'bi bi-eye-slash'; }
    else { input.type = 'password'; icon.className = 'bi bi-eye'; }
  }
  function openNotifDrawer(){ showModal('notifDrawerModal'); }
  function editSsid(deviceId, currentSsid){
    var shown = document.querySelector('.wifi-val');
    var val = (shown && shown.textContent) ? shown.textContent.trim() : (currentSsid || '');
    if (val === '-' || val === 'N/A' || val === 'Tidak ditemukan') val = '';
    document.getElementById('modalSsidInput').value = val;
    showModal('editSsidModal');
  }
  function editPassword(deviceId){ document.getElementById('modalPassInput').value = ''; showModal('editPasswordModal'); }
  function rebootDevice(deviceId){ showModal('rebootModal'); }

  // GAUGE
  function drawGauge(canvasId, valueMbps, maxMbps, strokeColor) {
    var canvas = document.getElementById(canvasId); if (!canvas) return;
    var ctx = canvas.getContext('2d'), w = canvas.width, h = canvas.height, cx = w/2, cy = h-20, radius = 75;
    ctx.clearRect(0,0,w,h);
    ctx.beginPath(); ctx.arc(cx,cy,radius,Math.PI,2*Math.PI,false);
    ctx.lineWidth = 14; ctx.strokeStyle = 'rgba(148,163,184,0.22)'; ctx.lineCap = 'round'; ctx.stroke();
    var val = Math.min(Math.max(0, valueMbps), maxMbps);
    var ratio = maxMbps > 0 ? val / maxMbps : 0;
    if (ratio > 0) {
      ctx.beginPath(); ctx.arc(cx,cy,radius,Math.PI,Math.PI + ratio*Math.PI,false);
      ctx.lineWidth = 14; ctx.strokeStyle = strokeColor; ctx.lineCap = 'round'; ctx.stroke();
    }
  }

  async function fetchTrafficData() {
    try {
      var res = await fetch('/customer/api/pppoe-traffic', { cache: 'no-store' });
      if (!res.ok) return;
      var data = await res.json();
      var rxGauge = document.getElementById('pppoe_rx_gauge'), txGauge = document.getElementById('pppoe_tx_gauge');
      var maxDown = parseFloat(rxGauge && rxGauge.dataset.max) || 10, maxUp = parseFloat(txGauge && txGauge.dataset.max) || 10;
      var rx = parseFloat(data.rxMbps || data.rx_rate || 0) || 0, tx = parseFloat(data.txMbps || data.tx_rate || 0) || 0;
      var rxV = document.getElementById('pppoe_rx_value'), rxU = document.getElementById('pppoe_rx_unit');
      if (rxV) rxV.innerText = rx < 0.1 ? (rx*1000).toFixed(0) : rx.toFixed(2);
      if (rxU) rxU.innerText = rx < 0.1 ? 'Kbps' : 'Mbps';
      var txV = document.getElementById('pppoe_tx_value'), txU = document.getElementById('pppoe_tx_unit');
      if (txV) txV.innerText = tx < 0.1 ? (tx*1000).toFixed(0) : tx.toFixed(2);
      if (txU) txU.innerText = tx < 0.1 ? 'Kbps' : 'Mbps';
      drawGauge('pppoe_rx_gauge', rx, maxDown, '#38BDF8');
      drawGauge('pppoe_tx_gauge', tx, maxUp, '#34D399');
    } catch (e) { /* abaikan */ }
  }

  document.addEventListener('DOMContentLoaded', function(){
    <% if (onuMissing) { %>showModal('onuMissingModal');<% } %>
    loadCustomerWebNotifs();
    fetchTrafficData();
    setInterval(fetchTrafficData, 3000);
    var btnRefresh = document.getElementById('btnDeviceRefresh');
    if (btnRefresh) {
      btnRefresh.addEventListener('click', async function(){
        btnRefresh.disabled = true;
        btnRefresh.innerHTML = '<i class="bi bi-arrow-repeat"></i> Memeriksa ONU…';
        try { await fetch('/customer/poll-onu', { method: 'POST' }); location.reload(); }
        catch (e) { location.reload(); }
      });
    }
  });

  function loadCustomerWebNotifs() {
    var container = document.getElementById('notifListContainer'); if (!container) return;
    var notifs = [];
    <% if (paidInvoices && paidInvoices.length > 0) { paidInvoices.slice(0,3).forEach(function(inv){ var pAmt = inv.amount != null ? inv.amount : (inv.package_price != null ? inv.package_price : 0); %>
      notifs.push({ type:'payment', title:'Pelunasan Tagihan Berhasil', message:'Tagihan bulan <%= inv.period_month %>/<%= inv.period_year %> sebesar Rp <%= parseInt(pAmt || 0).toLocaleString("id-ID") %> telah LUNAS.', time:'Terkonfirmasi Sistem' });
    <% }); } %>
    <% if (hasUnpaid) { var uAmt = latestUnpaid.amount != null ? latestUnpaid.amount : (latestUnpaid.package_price != null ? latestUnpaid.package_price : 0); %>
      notifs.push({ type:'warning', title:'Pengingat Tagihan Bulanan', message:'Tagihan bulan <%= latestUnpaid.period_month %>/<%= latestUnpaid.period_year %> sebesar Rp <%= parseInt(uAmt || 0).toLocaleString("id-ID") %> menunggu pembayaran.', time:'Jatuh Tempo Tgl 20' });
    <% } %>
    var badge = document.getElementById('notifCountBadge');
    if (badge && notifs.length > 0) { badge.innerText = notifs.length; badge.style.display = 'flex'; }
    if (!notifs.length) {
      container.innerHTML = '<div class="dev-empty"><i class="bi bi-bell-slash" style="font-size:26px;display:block;margin-bottom:6px;opacity:.5"></i>Belum ada notifikasi baru</div>';
    } else {
      container.innerHTML = notifs.map(function(n){
        return '<div class="notif-item ' + (n.type === 'payment' ? 'unread' : '') + '">' +
          '<div class="n-title"><i class="bi bi-' + (n.type === 'payment' ? 'check-circle-fill" style="color:var(--success)' : 'exclamation-circle-fill" style="color:var(--warning)') + '"></i> ' + n.title + '</div>' +
          '<div class="n-msg">' + n.message + '</div><div class="n-time">' + n.time + '</div></div>';
      }).join('');
    }
  }

  if ('serviceWorker' in navigator) { navigator.serviceWorker.register('/sw.js', { scope: '/customer/' }).then(function(r){try{r.update();}catch(e){}}).catch(function(){}); }
</script>
  <script src="/js/theme-toggle.js" defer></script>
</body>
</html>
