# Salin ke .env.gowa lalu isi nilainya. File .env.gowa tidak di-commit.
#
# Login dashboard GOWA (Basic Auth): user:password
GOWA_BASIC_AUTH=admin:ganti-password-kuat

# Port dan interface dashboard/API GOWA
GOWA_PORT=3000
GOWA_BIND=0.0.0.0

# URL webhook OPEN-ISP dari dalam container.
# App di host yang sama  : http://host.containers.internal:3001/api/webhook/gowa
# App di compose network : http://open-isp:3001/api/webhook/gowa
GOWA_WEBHOOK_URL=http://host.containers.internal:3001/api/webhook/gowa

# Samakan dengan setting gowa_webhook_secret di OPEN-ISP.
# Buat dengan: openssl rand -hex 32
GOWA_WEBHOOK_SECRET=ganti-dengan-hasil-openssl-rand-hex-32
